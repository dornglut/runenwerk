@startuml
title net workspace architecture (current after RN8 N1)

skinparam componentStyle rectangle
skinparam packageStyle rectangle
left to right direction

package "apps / editor integration" {
  [Runenwerk Editor Preview Client] as preview_client
  [Runtime Preview Host] as preview_host
}

package "engine" {
  [Network Runtime Systems] as engine_runtime
  [Replication Systems] as engine_replication
  [Session Systems] as engine_session
  [Replay Systems] as engine_replay
}

package "external RunenNet" {
  [runen-net Core] as runennet_core
  [runen-net-quic] as runennet_quic
}

package "net (remaining Runenwerk migration evidence)" {
  package "engine_sim" {
    [profile] as sim_profile
    [identity] as sim_identity
    [rng] as sim_rng
    [command] as sim_command
    [codec] as sim_codec
  }

  package "engine_net" {
    [protocol] as net_protocol
    [session] as net_session
    [replication] as net_replication
    [runtime contracts] as net_runtime
    [simulation] as net_simulation
    [transport contracts] as net_transport
  }

  package "engine_net_macros" {
    [network authoring macros] as net_macros
  }

  package "engine_history" {
    [model] as history_model
    [policy] as history_policy
    [archive] as history_archive
    [recorder] as history_recorder
    [controller] as history_controller
    [validation] as history_validation
  }
}

preview_client --> runennet_quic : preview control client
preview_host --> runennet_quic : preview control server
runennet_quic --> runennet_core

engine_runtime --> net_runtime
engine_replication --> net_replication
engine_session --> net_protocol
engine_session --> net_session
engine_replay --> history_recorder
engine_replay --> history_validation

net_protocol --> sim_identity
net_simulation --> sim_identity
net_replication --> sim_codec
history_model --> sim_identity

note right of runennet_quic
Standalone RunenNet is the sole
QUIC authority for the migrated
editor/runtime-preview channel.
end note

note right of net_runtime
engine_net remains only for
unmigrated engine consumers.
Later RN8 slices must migrate
those consumers before deletion.
end note

@enduml
