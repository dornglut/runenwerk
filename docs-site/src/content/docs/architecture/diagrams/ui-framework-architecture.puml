@startuml
title Runenwerk UI Local Runtime and Integration Architecture

skinparam packageStyle rectangle

package "Runenwerk Authored UI" {
  [AuthoredUiTemplate]
  [UiNodeDefinition]
  [Source Maps]
}

package "Interaction Formation" {
  [NormalizedUiTemplate]
  [FormedInteractionModel]
}

package "Current Local Execution" {
  [Retained UI]
  [UiProgram]
  [UiCompiler]
  [UiRuntimeArtifact]
  [UiEvaluator / UiRuntimeView]
}

package "Local Proof" {
  [UiStoryManifestV2]
  [Workflow Profile]
  [UiStoryWorkflowReportV2]
  [UiStoryMountDecisionV2]
}

package "Runenwerk Hosts" {
  [engine::plugins::ui]
  [Editor / App Host]
  [Headless Proof]
}

package "Derived Output" {
  [UiFrame / Render Data]
  [Engine Renderer]
}

cloud "Standalone RunenUI\nfuture reusable-framework authority" as RunenUI

[AuthoredUiTemplate] --> [UiNodeDefinition]
[AuthoredUiTemplate] --> [Source Maps]
[AuthoredUiTemplate] --> [NormalizedUiTemplate]
[UiNodeDefinition] --> [NormalizedUiTemplate]
[NormalizedUiTemplate] --> [FormedInteractionModel]

[FormedInteractionModel] --> [Retained UI]
[FormedInteractionModel] --> [UiProgram]
[UiProgram] --> [UiCompiler]
[UiCompiler] --> [UiRuntimeArtifact]
[UiRuntimeArtifact] --> [UiEvaluator / UiRuntimeView]

[UiStoryManifestV2] --> [Workflow Profile]
[Workflow Profile] --> [UiStoryWorkflowReportV2]
[UiStoryWorkflowReportV2] --> [UiStoryMountDecisionV2]
[UiProgram] ..> [UiStoryWorkflowReportV2]
[UiRuntimeArtifact] ..> [UiStoryWorkflowReportV2]
[UiEvaluator / UiRuntimeView] ..> [UiStoryWorkflowReportV2]

[Retained UI] --> [engine::plugins::ui]
[UiEvaluator / UiRuntimeView] --> [engine::plugins::ui]
[UiStoryMountDecisionV2] ..> [Editor / App Host]
[UiStoryWorkflowReportV2] --> [Headless Proof]
[engine::plugins::ui] --> [Editor / App Host]

[Retained UI] --> [UiFrame / Render Data]
[UiEvaluator / UiRuntimeView] --> [UiFrame / Render Data]
[UiFrame / Render Data] --> [Engine Renderer]

RunenUI ..> [engine::plugins::ui] : future explicit\nconsumer cutover only

note right of RunenUI
RunenUI owns future reusable
framework semantics.
Runenwerk does not mirror
that roadmap locally.
end note

note bottom of [Current Local Execution]
Retained UI and UiProgram-era owners coexist.
No total replacement is implied.
end note

note bottom of [Editor / App Host]
Hosts own product mutation and effects.
UI facts do not directly mutate app truth.
end note

@enduml
