@startuml
title Live UiPlugin / RunenUI Integration Architecture

skinparam componentStyle rectangle
skinparam packageStyle rectangle

package "Runenwerk App / Product" {
  [App] as App
  [Typed UiScreen] as Screen
  [App / Domain State] as ProductState
  [UiActionHandler / Host Policy] as HostPolicy
}

package "Runenwerk Engine UI Integration" {
  [UiPlugin] as UiPlugin
  [AppUiExt] as AppUiExt
  [UiRuntimeSlotsResource] as Slots
  [Projection Adapter] as Adapter
  [Diagnostics / Report] as Diagnostics
}

package "Retained Runenwerk UI Semantics" {
  [ui_definition / UiTypedSource] as Definition
  [UiProgram / UiRuntimeArtifact] as Program
  [ui_evaluator binding/state] as Evaluator
  [ui_state] as State
  [route / capability contracts] as Routes
}

package "Standalone RunenUI" {
  [runenui_core View / Element] as Core
  [runenui_runtime AppRuntime] as Runtime
  [Mounted Tree / Layout / Text] as Mounted
  [Semantics / Interaction] as Interaction
  [HostRequest Egress] as HostRequest
}

package "Render Runtime" {
  [Future RunenUI Publication Adapter] as RenderAdapter
  [SurfaceFrame Submission] as SurfaceFrame
  [RenderPlugin] as RenderPlugin
}

package "Explicit Legacy Renderer Evidence" {
  [UiRuntimeEvaluationResource] as LegacyEval
  [render_publish.rs] as LegacyPublish
}

App --> AppUiExt
AppUiExt --> Screen : mount typed screen
AppUiExt --> Slots
UiPlugin --> Slots
UiPlugin --> Diagnostics

Screen --> Definition
Definition --> Program
Program --> Adapter
Evaluator --> State
State --> Adapter
Adapter --> Core
Slots --> Runtime
Runtime --> Mounted
Runtime --> Interaction
Interaction --> HostRequest
HostRequest --> HostPolicy : route intent
HostPolicy --> ProductState : authorized mutation only

RenderAdapter --> SurfaceFrame
SurfaceFrame --> RenderPlugin

LegacyEval --> LegacyPublish
LegacyPublish --> SurfaceFrame : isolated unmigrated path only

note right of Runtime
Standalone RunenUI owns reusable mounted/runtime,
layout, text, semantic, interaction, and action execution
for migrated consumers.
end note

note right of Slots
Engine slot identity is integration lookup only.
It is not mounted widget/runtime identity.
end note

note bottom of LegacyEval
UiPlugin does not initialize or schedule this path
for ordinary migrated mounted UI.
end note

@enduml
