// Template for one bounded implementation phase.
// Markdown remains the primary design/process authority unless an accepted design grants
// this spec contract status for the named scope.

PhaseImplementationSpec(
    phase_id: "PT-EXAMPLE-000",
    title: "Example Phase Title",
    lifecycle_state: "proposed",
    implementation_authorization_status: "not-authorized",
    owner: "workspace-or-subsystem-owner",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "docs-site/src/content/docs/workspace/start-here.md",
        "docs-site/src/content/docs/workspace/engineering-workflow.md",
        "docs-site/src/content/docs/workspace/authority-model.md",
    ],

    complete_investigation_gate_status: "not_required|complete|blocked",
    complete_design_gate_status: "not_required|complete|blocked",
    principle_compliance_status: "pending|complete|blocked",
    module_decomposition_status: "pending|complete|blocked",
    maintainability_review_status: "pending|complete|blocked",

    allowed_paths: [
        "path/to/allowed/file_or_directory/**",
    ],

    forbidden_paths: [
        "path/to/forbidden/file_or_directory/**",
    ],

    public_api_surface: [
        "No public API change unless this list names the accepted API shape.",
    ],

    invariants: [
        "State every invariant this phase must preserve or prove.",
    ],

    acceptance_criteria: [
        "State the concrete acceptance criteria for this phase.",
    ],

    validation_commands: [
        "cargo validate",
        "git diff --check",
        "CI=true pnpm --dir docs-site build",
        "git status --short --branch",
    ],

    evidence_expectations: [
        "Distinguish source inspection, local executable validation, exact-head CI, user-reported evidence, and unverified claims.",
    ],

    stop_conditions: [
        "Stop if the phase needs files, crates, or ownership outside this contract.",
        "Stop if implementation authorization is missing or only inferred from accepted direction.",
    ],

    closeout_expectations: [
        "Record delivered contract, validation, evidence, known gaps, and next action in the owning pull request or durable closeout when one is justified.",
    ],

    next_phase_activation_condition: "The next phase may become active only after this phase is accepted and the owning issue records the new current state.",
)
