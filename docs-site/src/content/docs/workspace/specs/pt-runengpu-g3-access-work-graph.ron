// Decision-complete implementation specification for the third internal RunenGPU boundary.
// Planning issue #174 owns this decision phase. Rust implementation is not authorized until this
// planning authority is independently reviewed and merged and one bounded implementation issue exists.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G3",
    title: "Resource Access, Initialization Flow, Hazards, Immutable Work, and Graph Preparation",
    lifecycle_state: "planned",
    implementation_authorization_status: "not-authorized-until-planning-pr-accepted-and-separate-implementation-issue-created",
    owner: "RunenGPU contract owner",
    source_baseline: "709aa6aced020ee99405e1e1c3dde7703c77a4d4",
    planning_issue: "dornglut/runenwerk#174",
    implementation_issue: "pending-after-planning-acceptance",
    parent_issue: "dornglut/runenwerk#167",
    completed_predecessor_issue: "dornglut/runenwerk#172",
    completed_predecessor_pull_request: "dornglut/runenwerk#173",
    target_repository_after_internal_conformance: "dornglut/runen-gpu",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "DEPENDENCY_RULES.md",
        "DOMAIN_MAP.md",
        "docs-site/src/content/docs/adr/accepted/0015-separate-gpu-execution-from-rendering.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runengpu-g3-access-work-graph-design.md",
        "docs-site/src/content/docs/design/active/runenrender-internal-decomposition-execution-plan.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-industry-comparison.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-public-api-ergonomics-review.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-proof-workload-strategy.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-g2-capabilities-resources-investigation.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-g3-access-work-graph-investigation.md",
        "docs-site/src/content/docs/reports/closeouts/pt-runengpu-g2-implementation-closeout.md",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g2-capabilities-resource-descriptors.ron",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
        "docs-site/src/content/docs/workspace/planning/active-work.md",
    ],

    goal: "Create one future-transferable RunenGPU authority for checked work-time resource access, region-aware initialization flow, hazards, access-derived dependencies, immutable generic work fragments, deterministic graph preparation, and inspection; migrate current render and GPU-primitive consumers through one temporary adapter; and delete replaced renderer-owned generic correctness authority without implementing backend admission or execution.",

    dependency_direction: [
        "Runenwerk adapters and host policy -> RunenRender semantic image planning -> RunenGPU generic GPU work -> WGPU backend",
        "Independent non-render consumers may contribute GpuWorkFragment values directly.",
        "New G3 public contracts contain no Runenwerk, RunenRender, ECS, UI, SDF, Winit, application, product, shader-file, or raw WGPU types.",
    ],

    phase_ownership: [
        "G2 remains authoritative for normalized capabilities, logical resource descriptors, typed resource handles, prepared data, resource lifetime/ownership/reconstruction/memory facts, and export relationships.",
        "G3 owns checked buffer ranges, texture subresource access, query ranges, work-time access categories, region-aware graph-time initialization, hazards, inferred data edges, immutable work fragments/nodes, explicit non-data order, deterministic graph preparation, and inspection summaries.",
        "G4 owns GpuContext, backend admission, WGPU capability mapping, shader and pipeline interfaces, validated binding keys, backend data layout, resource realization, and deletion of the temporary RenderFlowId-derived resource-owner bridge.",
        "G5 owns uploads, updates, staging, command encoding, submission, completion, asynchronous readback, cancellation, preserved execution state, and delayed backend retirement.",
        "G6 owns offscreen graphics execution and shared render/non-render context proof.",
        "G7 owns surface acquisition, surface generations, presentation execution, thread affinity, and surface/device outcomes.",
        "G8 owns final diagnostics, shutdown, conformance, and residual-authority audit.",
        "GX creates dornglut/runen-gpu only after G2-G8 are accepted.",
    ],

    target_module_layout: [
        "engine/src/plugins/gpu/api/access.rs",
        "engine/src/plugins/gpu/api/work.rs",
        "engine/src/plugins/gpu/api/graph.rs",
        "engine/src/plugins/gpu/api/errors.rs",
        "engine/src/plugins/gpu/api/resource.rs for GpuExportKey and G2 relationship migration",
        "engine/src/plugins/gpu/api/mod.rs",
        "engine/src/plugins/gpu/mod.rs",
        "engine/src/plugins/render/adapters/gpu_work.rs as one temporary render/GPU-primitive lowering seam",
    ],

    module_rules: [
        "Every engine/src/plugins/gpu G3 source file is future-transferable and covered by the existing complete-subtree dependency and vocabulary guard.",
        "Do not create context, backend, WGPU, shader, pipeline, binding-layout, execution, surface, capture, testing-package, macro-package, facade-package, or external-package modules in G3.",
        "gpu_work.rs is a temporary Runenwerk/render integration adapter, not future RunenGPU source.",
        "RenderPassNode may remain transitional render authoring input but cannot remain generic access, initialization, hazard, dependency, or graph correctness authority.",
        "Current render execution payloads remain in a render-owned sidecar keyed by prepared G3 node identity until G4 replaces that seam with admitted generic program/interface authority.",
        "One prepared graph authority exists; no reduced-validation graph, compatibility graph, forwarding graph, or parallel old/new hazard path is allowed.",
    ],

    access_public_types: [
        "pub struct GpuBufferRange with private offset and nonzero size; semantic equality, ordering, and hashing compare the checked concrete half-open byte interval",
        "GpuBufferRange::whole(&GpuBufferHandle) resolves immediately to offset zero and descriptor size",
        "GpuBufferRange::new(&GpuBufferHandle, offset, size) rejects zero size, overflow, and descriptor overflow",
        "GpuTextureSubresourceRange remains the one G2 range type and gains semantic PartialOrd, Ord, and Hash plus descriptor-bound validation helpers required by G3",
        "pub struct GpuQueryRange with private first and nonzero count checked against GpuQuerySetDescriptor::count",
        "pub enum GpuBufferAccessKind { UniformRead, StorageRead, StorageWrite, StorageReadWrite, VertexRead, IndexRead, IndirectRead, CopySource, CopyDestination }",
        "pub enum GpuAttachmentLoad { Load, Clear }",
        "pub enum GpuAttachmentStore { Store, Discard }",
        "pub enum GpuDepthStencilAccess { ReadOnly, ReadWrite }",
        "pub enum GpuTextureAccessKind { SampledRead, StorageRead, StorageWrite, StorageReadWrite, CopySource, CopyDestination, ColorAttachment { load: GpuAttachmentLoad, store: GpuAttachmentStore }, DepthStencilAttachment { access: GpuDepthStencilAccess, load: GpuAttachmentLoad, store: GpuAttachmentStore }, Present }",
        "pub enum GpuQueryAccessKind { WriteTimestamp, ResolveSource }",
        "pub struct GpuBufferAccess containing GpuBufferHandle, GpuBufferRange, and GpuBufferAccessKind",
        "pub enum GpuTextureAccessResource { Texture(GpuTextureHandle), TextureView(GpuTextureViewHandle) }",
        "pub struct GpuTextureAccess containing a typed texture/view resource, requested subresources, and GpuTextureAccessKind",
        "pub struct GpuQueryAccess containing GpuQuerySetHandle, GpuQueryRange, and GpuQueryAccessKind",
        "pub struct GpuSamplerUse containing GpuSamplerHandle as immutable input evidence without a write hazard",
        "pub enum GpuResourceAccess { Buffer, Texture, Query, Sampler }",
    ],

    access_semantics: [
        "All access values are immutable after successful construction.",
        "Buffer intervals are half-open [offset, offset + size) and use checked arithmetic only.",
        "A texture access through a view normalizes to the parent GpuTextureHandle and the checked intersection of the view subresources and requested subresources.",
        "Hazards, initialization, and exports operate on normalized parent textures rather than treating views as independent storage.",
        "Aspect overlap is exact except that All overlaps every aspect permitted by the parent format; Color never overlaps DepthOnly or StencilOnly.",
        "Access construction validates descriptor kind, permitted G2 usage, range bounds, ownership constraints already knowable without a backend, and role-specific contradictions.",
        "UniformRead, VertexRead, IndexRead, IndirectRead, SampledRead, CopySource, Present, ResolveSource, and attachment Load require initialized coverage.",
        "StorageRead requires initialized coverage; StorageWrite does not read prior content; StorageReadWrite requires initialized coverage and writes the same coverage.",
        "CopyDestination initializes its destination coverage after its source coverage is validated.",
        "ColorAttachment and read-write DepthStencilAttachment write their subresource coverage; ReadOnly depth/stencil does not write.",
        "GpuAttachmentLoad::Load requires initialized coverage; Clear establishes full initialized coverage for the attachment subresources before node work.",
        "GpuAttachmentStore::Store preserves post-node initialized coverage; Discard removes post-node readable initialization coverage.",
        "Sampler use participates in identity/kind validation and inspection but creates no data dependency by itself.",
        "No public access type contains raw WGPU usage flags, pipeline stages, queue families, barriers, layouts, or backend states.",
    ],

    initial_state_public_types: [
        "pub enum GpuInitialCoverage { DescriptorInitialization, BufferRanges(Vec<GpuBufferRange>), TextureSubresources(Vec<GpuTextureSubresourceRange>), QueryRanges(Vec<GpuQueryRange>) } with private normalized storage and fallible constructors",
        "pub enum GpuInitialAccessState { Unknown, Readable, Writable, ReadWrite } for explicit imported/retained graph-entry evidence only; it is logical evidence and never a backend barrier or WGPU state",
        "pub struct GpuWorkResourceInput containing a kind-preserving GpuResourceRef, checked initial coverage, initial access state, and provenance",
    ],

    initialization_semantics: [
        "Owned Zeroed buffer initialization starts with complete initialized buffer coverage.",
        "Owned Prepared buffer initialization starts with complete initialized coverage because G2 requires exact byte-length equality.",
        "Owned Zeroed texture initialization starts with all declared mip/layer/aspect coverage initialized.",
        "Owned Prepared texture initialization starts with the exact destination initialization coverage bound by G2 format, extent, row, and image layout.",
        "Uninitialized descriptors start with no initialized coverage.",
        "A pure write initializes only its normalized buffer range or texture subresources.",
        "ReadWrite never acts as implicit initialization because it reads prior content.",
        "Clear initializes complete declared attachment subresources; Store preserves them and Discard invalidates later readable coverage.",
        "Imported and retained prior-epoch contents enter through explicit GpuWorkResourceInput evidence; labels, lifetime alone, or current runtime existence never imply initialized content.",
        "G3 validates graph-time evidence only and does not claim G5 execution preserved, synchronized, uploaded, or retired content.",
        "Every read-before-initialization error includes operation, prepared node, typed resource, normalized range/subresources, cause, and correction.",
    ],

    work_identity_types: [
        "pub struct GpuWorkNodeId as a private-construction nonzero fragment-local identity allocated monotonically by GpuWorkFragmentBuilder",
        "pub struct GpuPreparedWorkNodeId { fragment_ordinal, local_node_id } assigned deterministically during composition",
        "Node identities are typed and process-local and have no persistence, replay, network, wire, ABI, external-format, or cache guarantee.",
        "GpuWorkResourceId remains the only logical resource identity; node IDs never reuse or reinterpret it.",
    ],

    export_and_composition_types: [
        "pub struct GpuExportKey(String) as a validated trimmed non-empty semantic key with PartialEq, Eq, PartialOrd, Ord, and Hash",
        "GpuExportRelationship replaces raw String export_key storage with GpuExportKey without changing resource/final-access/provenance ownership",
        "pub struct GpuWorkImport containing a kind-preserving resource reference, producer GpuExportKey, required initial access, and provenance",
        "pub struct GpuWorkOutput containing a GpuExportRelationship and normalized final initialized coverage",
    ],

    work_public_types: [
        "pub enum GpuWorkNodeKind { Compute, Render, Copy, Clear, Resolve, Present }",
        "pub enum GpuExecutionPreference { Automatic, ComputePreferred, GraphicsRequired, TransferPreferred } as a hint without a concurrency guarantee",
        "pub struct GpuExplicitOrder containing typed fragment-local before/after node IDs and a validated non-empty diagnostic reason",
        "pub enum GpuDependencyReason { ReadAfterWrite, WriteAfterRead, WriteAfterWrite, ExplicitNonData }",
        "pub struct GpuWorkDependency containing prepared before/after node IDs, normalized resource/range evidence when data-derived, and GpuDependencyReason",
        "pub struct GpuWorkNode as an immutable pre-admission work intent with private identity, kind, accesses, capability requirements, operation-shape facts, execution preference, label, and provenance",
        "pub struct GpuWorkFragment as immutable declared/imported/exported resources, nodes, explicit non-data order, outputs, and provenance",
        "pub struct GpuWorkFragmentBuilder as the only mutable lexical/closure-scoped authoring surface",
        "pub struct GpuPreparedWorkGraph as the single immutable validated graph authority",
        "pub struct GpuPreparedWorkDiagnostic with typed category, node/resource/range/provenance fields, human operation/cause/correction, and no backend-only dump",
    ],

    work_semantics: [
        "GpuWorkFragment::build(label, closure) allocates fragment-local node IDs and returns one immutable fragment or a structured authoring error.",
        "The fragment label is diagnostic only; it does not determine composition, dependency direction, or prepared identity.",
        "Node builders use lexical closure scope and return Result; no repeated finish ladder, panic, unwrap, silent fallback, or partially valid public node exists.",
        "G3 node operation facts include dispatch/draw/copy/clear/resolve/present shape only where backend-independent and required to validate access consistency.",
        "Shader source, shader entry points, pipeline identities, binding keys/layouts, WGPU modules, and realization remain G4 or adapter-owned.",
        "Current render execution data is held in a temporary sidecar keyed by GpuPreparedWorkNodeId and cannot affect generic hazard truth.",
        "Strings are labels or diagnostic reasons only; GpuExportKey is a typed semantic key rather than a label.",
    ],

    hazard_rules: [
        "Two overlapping read-only normalized accesses require no edge.",
        "A write followed by an overlapping read infers a ReadAfterWrite edge.",
        "A read followed by an overlapping write infers a WriteAfterRead edge.",
        "Two overlapping writes infer a WriteAfterWrite edge only when the producer order is unique under fragment-local lexical order or an accepted import/export relation.",
        "Disjoint GpuBufferRange values do not conflict.",
        "Disjoint texture mip ranges, array-layer ranges, or non-overlapping aspects do not conflict.",
        "ReadWrite participates as both read and write for overlap and initialization.",
        "Within one fragment, lexical node declaration order orients access-derived hazards; callers do not restate those edges.",
        "Fragment order in the prepare input iterable is deterministic enumeration only and is not semantic scheduling authority.",
        "Cross-fragment causality requires the same typed resource plus one matching GpuExportKey/GpuWorkImport producer-consumer relation.",
        "Overlapping cross-fragment writers without one unique accepted producer/export relation fail as AmbiguousWriter rather than being ordered by collection position.",
        "Multiple exports with the same GpuExportKey, mismatched resource kind, mismatched final/initial access, or incompatible initialized coverage fail deterministically.",
        "Duplicate identical accesses inside one node are deduplicated; compatible storage read plus write over the same range normalizes to StorageReadWrite.",
        "Incompatible overlapping same-node roles, including sampled-read plus attachment-write or overlapping copy source/destination on one resource, fail unless a separately specified operation proves legality.",
    ],

    graph_preparation: [
        "GpuPreparedWorkGraph::prepare(label, fragments) is the single advanced composition and validation entry point.",
        "Preparation does not mutate input fragments.",
        "Input enumeration assigns process-local diagnostic fragment ordinals and deterministic tie order among otherwise independent ready nodes only; it never creates a dependency, resolves a writer conflict, changes initialization truth, or gives fragment labels/provenance semantic ordering authority.",
        "Preparation validates duplicate, unknown, and foreign identities; descriptor kind/usages; normalized ranges; texture-view parent/range relationships; query ranges; import/export contracts; and explicit-edge endpoints.",
        "Preparation computes initialized coverage, infers data dependencies, adds explicit non-data edges, rejects conflicting explicit/inferred order, rejects cycles and ambiguous writers, and produces deterministic topological order.",
        "Ties between independent ready nodes use deterministic prepared node identity only; this affects inspection order, not a claimed parallel execution guarantee.",
        "Prepared output includes ordered nodes, typed dependency edges with reasons, normalized access records, initial/final coverage summaries, exports, capability requirement composition inputs, diagnostics, and provenance.",
        "Preparation performs no backend admission, shader/pipeline admission, resource realization, command encoding, submission, readback, retirement, or surface action.",
        "G5 ordinary submit must invoke the same preparation authority internally; no common-path bypass is permitted.",
    ],

    explicit_order_rules: [
        "GpuExplicitOrder is fragment-local in G3 and uses typed GpuWorkNodeId endpoints.",
        "Its reason is required diagnostic text and does not become identity.",
        "It is accepted only for non-data constraints such as externally defined sequencing not expressible through a resource.",
        "An explicit edge that duplicates an inferred edge is retained once with both diagnostic causes or normalized to the data edge plus explicit evidence.",
        "An explicit edge that opposes an inferred data edge or creates a cycle fails.",
        "Cross-fragment explicit node edges are deferred; current render passes requiring such order lower into one fragment, while independent fragments compose through resources and exports.",
    ],

    render_adapter_target: [
        "Add engine/src/plugins/render/adapters/gpu_work.rs as the only G3 render/GPU-primitive lowering seam.",
        "The adapter lowers RenderPassNode role fields into exact GpuResourceAccess values and maps render pass IDs to prepared node IDs.",
        "The adapter lowers current whole-resource uses to whole checked ranges/subresources only when current authoring has no narrower fact; it must not fabricate partial ranges.",
        "The adapter maps existing render initialization/history/import behavior to explicit GpuWorkResourceInput evidence and documents every retained later-phase seam.",
        "The adapter produces one render fragment for passes sharing explicit non-data ordering and separate fragments only where composition is genuinely independent.",
        "The adapter keeps shader assets, render view/target meaning, fixed-step policy, material/UI/product meaning, and execution payloads outside RunenGPU.",
        "CompiledRenderFlowPlan consumes GpuPreparedWorkGraph order/dependencies/initialization diagnostics and no longer owns a second generic lifetime/hazard result.",
    ],

    primitive_adapter_target: [
        "Counter reset, prefix scan, scatter, and indirect-argument descriptors remain domain conveniences that lower through gpu_work.rs or a narrowly shared Runenwerk adapter.",
        "GpuPrimitiveResourceAccessKind and GpuPrimitiveResourceAccess are deleted after lowering uses GpuBufferAccess/GpuResourceAccess.",
        "GpuPrimitiveDispatchResource::Temporary(String) is replaced with typed G2 transient buffer handles allocated by the existing bounded owner adapter.",
        "String stage dependencies are deleted; scan hierarchy and stage order are inferred from typed temporary/input/output resource accesses plus fragment-local lexical order.",
        "Shader asset constants remain Runenwerk source-discovery facts until G4 admitted program authority exists.",
    ],

    declaration_inventory_to_reverify: [
        "engine/src/plugins/gpu/api/resource.rs",
        "engine/src/plugins/gpu/api/handles.rs",
        "engine/src/plugins/gpu/api/work_resource_id.rs",
        "engine/src/plugins/gpu/api/errors.rs",
        "engine/src/plugins/gpu/api/mod.rs",
        "engine/src/plugins/gpu/mod.rs",
        "engine/src/plugins/render/api/passes.rs",
        "engine/src/plugins/render/graph/pass_graph.rs",
        "engine/src/plugins/render/graph/validation.rs",
        "engine/src/plugins/render/graph/planning.rs",
        "engine/src/plugins/render/graph/execution_plan.rs",
        "engine/src/plugins/render/graph/resource_lifetimes.rs",
        "engine/src/plugins/render/graph/prepared_validation.rs",
        "engine/src/plugins/render/graph/merge.rs",
        "engine/src/plugins/render/gpu_primitives/plan.rs",
        "engine/src/plugins/render/adapters/mod.rs",
    ],

    direct_and_transitive_inventory_to_reverify: [
        "All render API, graph, composition, procedural, renderer, runtime, inspection, and GPU-primitive files that consume RenderPassNode access or pass order.",
        "Applications: runenwerk_draw and runenwerk_editor GPU/render request and viewport/material consumers.",
        "Examples: boids_render_flow, game_of_life_sdf, sdf_render_flow, procedural sky/SDF terrain, fragment compositor, and render-flow inspection examples.",
        "Tests: render_flow_v2, render_dynamic_targets, render_flow_fragments, render_resource_model, render_import_contract, render_runtime_inspect, procedural_instance, application architecture guards, and relevant unit tests.",
        "Benchmarks: render_flow_planning and any primitive planning benchmark.",
        "Current implementation issue must record the exact current-main file-by-file census before source changes because planning does not freeze future main.",
    ],

    deletion_inventory: [
        "engine/src/plugins/render/graph/resource_lifetimes.rs after all consumers use GpuPreparedWorkGraph coverage summaries",
        "CompiledResourceAccessKind",
        "CompiledResourceLifetimeWindow",
        "compile_resource_lifetime_windows",
        "diagnose_resource_lifetime_windows",
        "renderer-local generic topological sorting as final authority",
        "GpuPrimitiveResourceAccessKind",
        "GpuPrimitiveResourceAccess",
        "GpuPrimitiveDispatchResource::Temporary(String)",
        "string GPU-primitive stage dependency authority",
        "broad RenderPassNode reads/writes/role lists as final generic correctness authority; transitional authoring fields may remain only behind the adapter until their render owner replaces them",
        "generic uses of RenderPassNode::depends_on; retained render authoring must rename and constrain explicit non-data ordering rather than preserve an ambiguous compatibility method",
    ],

    error_contract: [
        "pub enum GpuAccessError",
        "pub enum GpuWorkAuthoringError",
        "pub enum GpuWorkGraphError",
        "Typed causes include zero/overflow/out-of-bounds range, invalid usage, invalid aspect, invalid view intersection, query range failure, read before initialization, incompatible same-node access, ambiguous writer, duplicate export key, import/export mismatch, unknown/foreign identity, explicit-order conflict, and cycle.",
        "Every error Display names the human operation, fragment/node/resource label when known, typed identity, normalized range/subresources, cause, and correction.",
        "Errors retain structured provenance and nested source errors where applicable; callers never match panic/log/anyhow text.",
    ],

    api_examples: [
        "authoring: let work = GpuWorkFragment::build(\"simulation.update\", |work| { work.compute(\"integrate\", |node| { node.storage_read(&positions, GpuBufferRange::whole(&positions)?)?; node.storage_write(&next_positions, GpuBufferRange::whole(&next_positions)?)?; node.dispatch([groups, 1, 1])?; Ok(()) })?; Ok(()) })?;",
        "advanced preparation: let prepared = GpuPreparedWorkGraph::prepare(\"frame 42\", [simulation, rendering])?; inspect(prepared.diagnostics());",
        "later ordinary G5 path: let submission = gpu.submit(\"frame 42\", [simulation, rendering])?; ordinary submit invokes the same GpuPreparedWorkGraph preparation authority internally.",
        "No ordinary caller authors raw edges for data hazards or manually invokes a reduced validator.",
    ],

    focused_test_requirements: [
        "GpuBufferRange whole, valid partial, zero, overflow, and out-of-bounds tests",
        "GpuTextureSubresourceRange descriptor bounds, aspect overlap, disjoint mip/layer/aspect, and texture-view parent normalization tests",
        "GpuQueryRange bounds tests",
        "access-kind versus G2 descriptor usage tests",
        "initialization from Uninitialized, Zeroed, Prepared, imported/retained explicit input, partial writes, Clear, Load, Store, and Discard tests",
        "RAW, WAR, WAW, read/read, disjoint range, disjoint subresource, ReadWrite, and same-node conflict truth-table tests",
        "fragment-local lexical hazard orientation and cross-fragment import/export inference tests",
        "input-fragment reordering tests proving semantic edges/errors remain unchanged while diagnostic prepared ordinals may change",
        "cross-fragment overlapping writer ambiguity and duplicate/mismatched export tests",
        "explicit non-data edge success, conflict, duplicate, unknown endpoint, and cycle tests",
        "deterministic prepared node IDs, edge order, ready-node tie order, diagnostics, and repeated preparation equality tests",
        "foreign resource identity and texture-view parent lease tests",
        "render adapter whole-range lowering and exact pass-order migration tests",
        "GPU primitive typed temporary resource and inferred scan-stage order tests",
        "compile-fail tests proving private range/node construction, absent raw-ID reconstruction, absent cross-kind access, and immutable fragments/prepared graphs",
        "source/dependency guards proving no render, ECS, WGPU, Winit, UI, SDF, application, product, codec, TypeId, Any, shader-file, or compatibility reach-through in future-transferable G3 files",
    ],

    validation_commands: [
        "cargo test -p engine gpu:: --locked",
        "cargo test -p engine --test render_flow_v2 --locked",
        "cargo test -p engine --test render_dynamic_targets --locked",
        "cargo test -p engine --test render_flow_fragments --locked",
        "cargo test -p engine --test render_resource_model --locked",
        "cargo test -p engine --test render_runtime_inspect --locked",
        "cargo test -p engine --doc --locked",
        "cargo clippy -p engine --lib --tests --benches --examples --locked -- -D warnings",
        "cargo test -p runenwerk_draw --locked",
        "cargo test -p runenwerk_editor --locked",
        "cargo validate",
        "git diff --check",
        "git diff --check <accepted-base>..<final-head>",
        "exact-head CI and Documentation Build are merge evidence",
    ],

    documentation_and_closeout: [
        "Update RunenGPU architecture status, roadmap, active work, completed work, parent issue #167 slice index, and applicable public API/reference docs.",
        "Create docs-site/src/content/docs/reports/closeouts/pt-runengpu-g3-implementation-closeout.md during implementation.",
        "Record accepted base, final code candidate, final head, exact changed-file inventory, public/deleted authority, adapter and deletion phases, focused/canonical validation, exact-head Actions, complete-diff review, remaining G4/G5/G7 seams, and no invented merge SHA.",
        "Planning issue #174 closes only after its documentation-only planning PR is accepted and one separate bounded implementation issue is created.",
    ],

    allowed_scope: [
        "engine/src/plugins/gpu/api/access.rs, work.rs, graph.rs, errors.rs, resource.rs, mod.rs, and engine/src/plugins/gpu/mod.rs",
        "engine/src/plugins/render/adapters/gpu_work.rs and adapters/mod.rs",
        "the exact inventoried render graph/planning/primitive/runtime/inspection consumers required for cutover",
        "focused tests, examples, and benchmarks required to prove compiler-backed migration",
        "canonical planning, reference, investigation, and closeout documentation",
    ],

    forbidden_scope: [
        "Rust implementation during planning issue #174",
        "creation or population of dornglut/runen-gpu",
        "new workspace member, package, dependency, lockfile package, backend, facade, macro, capture, or testing package",
        "context, adapter selection, device, queue, WGPU feature/limit mapping, resource realization, shader/pipeline admission, binding keys/layout, command encoding, submission, upload/update execution, staging, completion, readback, cancellation, retirement, or surface implementation",
        "renderer scenes, views, targets, materials, lighting, visibility, transport, reconstruction, overlays, UI, ECS, SDF, world, editor, product, fixed-time, shader-file, hot-reload, window, capture, artifact, image-codec, or video-codec semantics inside RunenGPU",
        "compatibility aliases, deprecated parallel names, forwarding modules, source mirrors, duplicate graph/hazard paths, or reduced-validation submission paths",
        "advanced aliasing, transient memory reuse, pass fusion, automatic multi-queue scheduling, graph visualization UI, universal shader IR, sparse resources, external interop, ray tracing, or video",
    ],

    stop_conditions: [
        "An affected access, node, edge, graph, or export value is a stable persisted, replay, network, wire, cache, or external format.",
        "Correct initialization requires claiming G5 execution persistence or synchronization rather than explicit graph-entry evidence.",
        "Coherent work nodes require G4 shader/pipeline/binding authority that cannot remain an explicit adapter seam.",
        "Imported or surface synchronization requires backend facts owned by G4 or G7.",
        "Ownership separation requires a new ADR.",
        "A compatibility alias, forwarding module, duplicate graph, or parallel old/new correctness path appears necessary.",
        "The current-main declaration or consumer census is materially incomplete.",
        "An unrelated current-main cargo validate failure exists.",
        "A new package or dependency is required and cannot be justified by current policy.",
    ],

    implementation_order: [
        "Verify actual current main and run cargo validate plus git diff --check before source changes.",
        "Re-census declarations and consumers and bind the accepted base in the implementation issue/branch.",
        "Add checked access/range/error contracts with unit and compile-fail tests under engine::plugins::gpu.",
        "Add immutable work identities, fragment builder, import/export, and node contracts.",
        "Add deterministic prepared graph, initialization coverage, hazard inference, explicit order, diagnostics, and focused tests.",
        "Add the single gpu_work render/primitive adapter and cut compiled render planning over to GpuPreparedWorkGraph.",
