// Decision-complete implementation specification for the third internal RunenGPU boundary.
// Planning issue #174 owns this decision phase. Rust implementation is not authorized until this
// planning authority is independently reviewed and merged and one bounded implementation issue exists.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G3",
    title: "Resource Access, Initialization Flow, Hazards, Immutable Work, and Graph Preparation",
    lifecycle_state: "planned",
    implementation_authorization_status: "not-authorized-until-planning-pr-accepted-and-separate-implementation-issue-created",
    owner: "RunenGPU contract owner",
    source_baseline: "709aa6aced020ee99405e1e1c3dde7703c77a4d4",
    planning_issue: "dornglut/runenwerk#174",
    implementation_issue: "pending-after-planning-acceptance",
    parent_issue: "dornglut/runenwerk#167",
    completed_predecessor_issue: "dornglut/runenwerk#172",
    completed_predecessor_pull_request: "dornglut/runenwerk#173",
    target_repository_after_internal_conformance: "dornglut/runen-gpu",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "DEPENDENCY_RULES.md",
        "DOMAIN_MAP.md",
        "docs-site/src/content/docs/adr/accepted/0015-separate-gpu-execution-from-rendering.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runengpu-g3-access-work-graph-design.md",
        "docs-site/src/content/docs/design/active/runenrender-internal-decomposition-execution-plan.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-industry-comparison.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-public-api-ergonomics-review.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-proof-workload-strategy.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-g2-capabilities-resources-investigation.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-g3-access-work-graph-investigation.md",
        "docs-site/src/content/docs/reports/closeouts/pt-runengpu-g2-implementation-closeout.md",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g2-capabilities-resource-descriptors.ron",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
    ],

    goal: "Create one future-transferable RunenGPU authority for checked work-time resource access, region-aware initialization flow, hazards, access-derived dependencies, operation-implied capability requirements, immutable generic work fragments and typed operation intent including exact render attachments, buffer-zero clearing, and query resolution, deterministic graph preparation, and inspection; migrate current render, GPU-primitive, and timestamp consumers through one temporary adapter; and delete replaced renderer-owned generic correctness authority without implementing backend admission or execution.",

    dependency_direction: [
        "Runenwerk adapters and host policy -> RunenRender semantic image planning -> RunenGPU generic GPU work -> WGPU backend",
        "Independent non-render consumers may contribute GpuWorkFragment values directly.",
        "New G3 public contracts contain no Runenwerk, RunenRender, ECS, UI, SDF, Winit, application, product, shader-file, or raw WGPU types.",
    ],

    phase_ownership: [
        "G2 remains authoritative for normalized capabilities, logical resource descriptors, typed resource handles, prepared data, resource lifetime/ownership/reconstruction/memory facts, and export relationships.",
        "G3 owns checked access regions, graph-time initialization, hazards, inferred data edges, immutable work fragments/nodes, backend-neutral operation shape including render attachments, buffer-zero clear, and query resolution, operation/access-derived capability requirements, explicit non-data order, deterministic graph preparation, and inspection summaries.",
        "G3 extends the accepted G2 GpuBufferUsage vocabulary with QueryResolve because current timestamp consumers require a distinct logical destination usage; this is not a second descriptor authority.",
        "G4 owns GpuContext, backend admission, WGPU capability mapping, shader and pipeline interfaces, validated binding keys, backend data layout, resource realization, operation-limit admission, query-resolve offset-alignment admission, and deletion of the temporary RenderFlowId-derived resource-owner bridge.",
        "G5 owns uploads, updates, staging, command encoding, submission, completion, asynchronous readback, cancellation, preserved execution state, render-pass/query-resolve encoding, stale-generation/runtime-retirement rejection, and delayed backend retirement.",
        "G6 owns offscreen graphics execution and shared render/non-render context proof.",
        "G7 owns surface acquisition, surface generations, presentation execution, thread affinity, and surface/device outcomes.",
        "G8 owns final diagnostics, shutdown, conformance, and residual-authority audit.",
        "GX creates dornglut/runen-gpu only after G2-G8 are accepted.",
    ],

    target_module_layout: [
        "engine/src/plugins/gpu/api/access.rs",
        "engine/src/plugins/gpu/api/work.rs",
        "engine/src/plugins/gpu/api/graph.rs",
        "engine/src/plugins/gpu/api/errors.rs",
        "engine/src/plugins/gpu/api/resource.rs for GpuExportKey, QueryResolve buffer usage, and G2 relationship migration",
        "engine/src/plugins/gpu/api/mod.rs",
        "engine/src/plugins/gpu/mod.rs",
        "engine/src/plugins/render/adapters/gpu_work.rs as one temporary render/GPU-primitive/timestamp lowering seam",
    ],

    module_rules: [
        "Every engine/src/plugins/gpu G3 source file is future-transferable and covered by the existing complete-subtree dependency and vocabulary guard.",
        "Do not create context, backend, WGPU, shader, pipeline, binding-layout, execution, surface, capture, testing-package, macro-package, facade-package, or external-package modules in G3.",
        "gpu_work.rs is a temporary Runenwerk/render integration adapter, not future RunenGPU source.",
        "RenderPassNode may remain transitional render authoring input but cannot remain generic access, initialization, hazard, dependency, operation-shape, capability-requirement, or graph correctness authority.",
        "Current render shader, pipeline, material, view, raster, timestamp-decoding, and product execution payloads remain in a render-owned sidecar keyed by prepared G3 node identity until their later owners replace those seams.",
        "One prepared graph authority exists; no reduced-validation graph, compatibility graph, forwarding graph, or parallel old/new hazard path is allowed.",
    ],

    descriptor_extension: [
        "Add GpuBufferUsage::QueryResolve to the one accepted normalized G2 buffer-usage enum.",
        "QueryResolve means the buffer may receive opaque query results from a typed query-set resolve operation; it is not interchangeable with CopyDestination.",
        "Existing GpuBufferDescriptor validation remains authoritative and accepts QueryResolve for Device-memory buffers; readback memory intent still requires CopyDestination because mapping receives data through a later copy.",
        "No raw WGPU BufferUsages value enters the public contract.",
    ],

    access_public_types: [
        "pub struct GpuBufferRange with private offset and nonzero size; semantic equality, ordering, and hashing compare the checked concrete half-open byte interval",
        "GpuBufferRange::whole(&GpuBufferHandle) resolves immediately to offset zero and descriptor size",
        "GpuBufferRange::new(&GpuBufferHandle, offset, size) rejects zero size, overflow, and descriptor overflow",
        "GpuTextureSubresourceRange remains the one G2 range type and gains semantic PartialOrd, Ord, and Hash plus descriptor-bound validation helpers required by G3",
        "pub struct GpuQueryRange with private first and nonzero count checked against GpuQuerySetDescriptor::count",
        "pub enum GpuBufferAccessKind { UniformRead, StorageRead, StorageWrite, StorageReadWrite, VertexRead, IndexRead, IndirectRead, CopySource, CopyDestination, QueryResolveDestination }",
        "pub enum GpuAttachmentLoadKind { Load, Clear }",
        "pub enum GpuAttachmentStore { Store, Discard }",
        "pub enum GpuDepthStencilAccess { ReadOnly, ReadWrite }",
        "pub enum GpuTextureAccessKind { SampledRead, StorageRead, StorageWrite, StorageReadWrite, CopySource, CopyDestination, ColorAttachment { load_kind: GpuAttachmentLoadKind, store: GpuAttachmentStore }, MultisampleResolveDestination, DepthStencilAttachment { access: GpuDepthStencilAccess, load_kind: GpuAttachmentLoadKind, store: GpuAttachmentStore }, Present }",
        "pub enum GpuQueryAccessKind { WriteTimestamp, ResolveSource }",
        "pub struct GpuBufferAccess containing GpuBufferHandle, GpuBufferRange, and GpuBufferAccessKind",
        "pub enum GpuTextureAccessResource { Texture(GpuTextureHandle), TextureView(GpuTextureViewHandle) }",
        "pub struct GpuTextureAccess containing a typed texture/view resource, requested subresources, and GpuTextureAccessKind",
        "pub struct GpuQueryAccess containing GpuQuerySetHandle, GpuQueryRange, and GpuQueryAccessKind",
        "pub struct GpuSamplerUse containing GpuSamplerHandle as immutable input evidence without a write hazard",
        "pub enum GpuResourceAccess { Buffer, Texture, Query, Sampler }",
    ],

    access_semantics: [
        "All access values are immutable after successful construction.",
        "Buffer intervals are half-open [offset, offset + size) and use checked arithmetic only.",
        "A texture access through a view normalizes to the parent GpuTextureHandle and the checked intersection of the view subresources and requested subresources.",
        "Hazards, initialization, and exports operate on normalized parent textures rather than treating views as independent storage.",
        "Aspect overlap is exact except that All overlaps every aspect permitted by the parent format; Color never overlaps DepthOnly or StencilOnly.",
        "D1 and D3 retain the accepted G2 single logical array-layer rule. Initial G3 hazards treat one addressed D3 mip as one whole volume; z-slice independence is not inferred.",
        "Access construction validates descriptor kind, permitted G2 usage, range bounds, ownership constraints already knowable without a backend, and role-specific contradictions.",
        "UniformRead, VertexRead, IndexRead, IndirectRead, SampledRead, CopySource, Present, ResolveSource, and attachment Load require initialized coverage.",
        "StorageRead requires initialized coverage; StorageWrite does not read prior content; StorageReadWrite requires initialized coverage and writes the same coverage.",
        "CopyDestination initializes its destination coverage after its source coverage is validated.",
        "QueryResolveDestination is a pure write, requires GpuBufferUsage::QueryResolve, and initializes exactly the operation-derived destination byte range.",
        "WriteTimestamp is a pure query write and initializes exactly its checked query indices; ResolveSource requires prior initialized query coverage.",
        "ColorAttachment access is operation-derived from GpuRenderColorAttachment; its load/store semantics apply to the source attachment.",
        "MultisampleResolveDestination is operation-derived from an optional render color-attachment resolve target and always writes/initializes its destination coverage regardless of source Store or Discard.",
        "Read-write DepthStencilAttachment writes its subresource coverage; ReadOnly depth/stencil does not write and cannot use Clear.",
        "GpuAttachmentLoadKind::Load requires initialized source coverage; Clear establishes source coverage before node work.",
        "GpuAttachmentStore::Store preserves source post-node initialized coverage; Discard removes source post-node readable initialization coverage.",
        "Sampler use participates in identity/kind validation and inspection but creates no data dependency by itself.",
        "No public access type contains raw WGPU usage flags, pipeline stages, queue families, barriers, layouts, or backend states.",
    ],

    render_attachment_public_types: [
        "pub struct GpuColorClearValue as four finite normalized f64 components; construction rejects NaN/infinity, normalizes negative zero, and equality/hash use canonical IEEE bits",
        "pub struct GpuDepthClearValue as finite normalized f32 in inclusive range 0..=1 with canonical semantic equality/hash",
        "pub enum GpuColorAttachmentLoad { Load, Clear(GpuColorClearValue) } with kind() -> GpuAttachmentLoadKind",
        "pub enum GpuDepthAttachmentLoad { Load, Clear(GpuDepthClearValue) } with kind() -> GpuAttachmentLoadKind",
        "pub struct GpuRenderColorAttachment containing source GpuTextureAccessResource, checked source subresources, GpuColorAttachmentLoad, GpuAttachmentStore, and optional GpuMultisampleResolveTarget",
        "pub struct GpuMultisampleResolveTarget containing destination GpuTextureAccessResource and checked destination subresources",
        "pub struct GpuRenderDepthStencilAttachment containing source GpuTextureAccessResource, checked source subresources, GpuDepthStencilAccess, GpuDepthAttachmentLoad, and GpuAttachmentStore",
        "Color and depth/stencil attachment constructors are fallible and derive mandatory GpuTextureAccess records; callers do not separately declare attachment accesses.",
        "Current normalized formats contain color formats and Depth32Float only; stencil-specific load values, clear values, access fields, and standalone clear operations remain absent until a real accepted stencil format consumer exists.",
    ],

    operation_public_types: [
        "pub struct GpuDispatchSize with private x, y, and z workgroup counts; construction rejects zero dimensions so a node that declares writes cannot silently execute no work",
        "pub struct GpuDrawRange with private first and nonzero count",
        "pub enum GpuDrawIntent { Direct { vertices: GpuDrawRange, instances: GpuDrawRange }, Indexed { indices: GpuDrawRange, base_vertex: i32, instances: GpuDrawRange }, Indirect { arguments: GpuBufferHandle, range: GpuBufferRange, indexed: bool } }",
        "pub struct GpuComputeOperation { dispatch: GpuDispatchSize }",
        "pub struct GpuRenderOperation containing immutable ordered color attachments, optional depth/stencil attachment, immutable ordered Vec<GpuDrawIntent>, and render-side timestamp-write accesses; an empty draw list is accepted only when at least one attachment load is Clear(value) or query writes make the pass meaningful; Store alone never qualifies",
        "pub struct GpuTextureOrigin { x, y, z } with checked descriptor-relative validation",
        "pub struct GpuCopyExtent with nonzero width, height, and depth_or_layers",
        "pub struct GpuBufferRegion containing GpuBufferHandle and GpuBufferRange",
        "pub struct GpuTextureCopyRegion containing GpuTextureHandle, one mip level, GpuTextureOrigin, GpuTextureAspect, and GpuCopyExtent",
        "pub struct GpuBufferTextureLayout containing GpuBufferHandle, byte offset, bytes_per_row, and rows_per_image with checked logical row/image coverage but no WGPU-specific alignment promise",
        "pub enum GpuCopyOperation { BufferToBuffer { source: GpuBufferRegion, destination: GpuBufferRegion }, BufferToTexture { source: GpuBufferTextureLayout, destination: GpuTextureCopyRegion }, TextureToBuffer { source: GpuTextureCopyRegion, destination: GpuBufferTextureLayout }, TextureToTexture { source: GpuTextureCopyRegion, destination: GpuTextureCopyRegion } }",
        "pub enum GpuClearOperation { BufferZero(GpuBufferRegion) }",
        "pub struct GpuQueryResolveOperation containing source GpuQuerySetHandle, checked GpuQueryRange, destination GpuBufferHandle, destination byte offset, and an operation-derived checked GpuBufferRange",
        "pub struct GpuPresentOperation containing a typed texture/view source and exactly one checked color subresource; the surface lease/target remains G7-owned",
        "pub enum GpuWorkOperation { Compute(GpuComputeOperation), Render(GpuRenderOperation), Copy(GpuCopyOperation), Clear(GpuClearOperation), Resolve(GpuQueryResolveOperation), Present(GpuPresentOperation) }",
        "pub enum GpuWorkNodeKind { Compute, Render, Copy, Clear, Resolve, Present } exposed only as GpuWorkOperation::kind(); GpuWorkNode stores no duplicate kind field",
    ],

    operation_semantics: [
        "Operation constructors derive mandatory CopySource, CopyDestination, IndirectRead, attachment source/destination, query ResolveSource, query QueryResolveDestination, and Present access records rather than requiring callers to duplicate them.",
        "Caller-declared binding/vertex/index/storage/sampled/query-write accesses and operation-derived accesses are normalized through the same same-node conflict rules.",
        "An empty render draw list with only Load/Store attachment behavior is rejected as zero-work; Store preserves content but is not a write-producing side effect.",
        "Attachment clear values are part of GpuColorAttachmentLoad/GpuDepthAttachmentLoad and are not duplicated in access records.",
        "GpuClearOperation initially supports buffer zero only; arbitrary color/depth clear values are render attachment load operations and standalone texture/stencil clear is deferred.",
        "A multisample resolve target exists only inside GpuRenderColorAttachment; there is no standalone texture-resolve node.",
        "Multisample resolve requires source sample_count greater than one, destination sample_count equal to one, equal normalized color format/extent/mip/layer coverage, non-aliasing source/destination storage, and compatible G2 attachment usages.",
        "A render color attachment resolve target is written regardless of source attachment Store or Discard; Discard affects only the source attachment's later readable coverage.",
        "BufferToBuffer requires equal nonzero source/destination range sizes.",
        "Texture copy regions validate mip-relative bounds, aspect, format compatibility, sample-count rules, and nonzero extent using G2 descriptors.",
        "Buffer/texture copies validate logical row and image coverage with checked arithmetic. Backend row-alignment and device-limit admission remain G4/G5.",
        "Texture copy hazards conservatively cover the addressed mip/layer/aspect subresources; G3 does not infer independence between spatial rectangles or D3 z slices.",
        "Indirect draw range size and alignment are checked structurally against direct or indexed argument record size; G4 validates admitted backend/pipeline compatibility.",
        "Indexed draw requires matching IndexRead access; direct/indexed draw requires the render adapter or future G4 interface authority to validate vertex/index layouts.",
        "Query resolve currently accepts only GpuQueryKind::Timestamp, computes byte length as checked u64(query_count) * 8, rejects overflow and out-of-bounds destination coverage, and derives one destination range beginning at destination_offset.",
        "Query resolve requires initialized source query coverage and destination GpuBufferUsage::QueryResolve; G4/G5 validate the admitted backend destination-offset alignment and encode the command.",
        "A later copy from the query-resolve buffer to a readback buffer is an ordinary BufferToBuffer copy using CopySource/CopyDestination access and is ordered through the exact resolved byte range.",
        "Present is logical terminal texture consumption only; surface acquisition, generation, configuration, and actual presentation remain G7.",
        "Operation payload equality/hash exclude labels/provenance and compare only canonical semantic fields.",
    ],

    capability_derivation: [
        "GpuComputeOperation derives Required(Compute).",
        "GpuRenderOperation derives Required(RenderPipeline).",
        "GpuCopyOperation and GpuClearOperation::BufferZero derive Required(Copy).",
        "GpuDrawIntent::Indirect derives Required(IndirectDraw).",
        "StorageRead, StorageWrite, or StorageReadWrite texture access derives Required(StorageTexture).",
        "GpuRenderDepthStencilAttachment derives Required(DepthAttachment).",
        "WriteTimestamp query access and GpuQueryResolveOperation derive Required(TimestampQuery).",
        "GpuPresentOperation derives Required(Presentation).",
        "Consumers may add semantic requirements not inferable from operation/access shape.",
        "Preparation merges derived and caller-declared requirements through GpuCapabilityRequirements; an operation-implied Required feature conflicts with caller Disabled and cannot be weakened or silently omitted.",
        "G4 owns evaluation against admitted adapter/device facts and preferred fallback execution policy.",
    ],

    initial_state_public_types: [
        "pub enum GpuInitialCoverage { DescriptorInitialization, BufferRanges(Vec<GpuBufferRange>), TextureSubresources(Vec<GpuTextureSubresourceRange>), QueryRanges(Vec<GpuQueryRange>) } with private normalized storage and fallible constructors",
        "pub struct GpuWorkResourceInput containing a kind-preserving GpuResourceRef, checked initialized coverage, and provenance",
        "GpuWorkResourceInput represents readable initialized graph-entry content only. Descriptor ownership/usages decide permitted writes; backend state and synchronization remain G4/G5.",
    ],

    initialization_semantics: [
        "Owned Zeroed buffer initialization starts with complete initialized buffer coverage.",
        "Owned Prepared buffer initialization starts with complete initialized coverage because G2 requires exact byte-length equality.",
        "Owned Zeroed texture initialization starts with all declared mip/layer/aspect coverage initialized.",
        "Owned Prepared texture initialization starts with the exact destination initialization coverage bound by G2 format, extent, row, and image layout; it does not silently initialize undeclared mip levels.",
        "Query-set descriptors begin with no initialized query indices; DescriptorInitialization is invalid for query sets and explicit GpuWorkResourceInput query coverage is required for imported or retained prior-epoch query content.",
        "Uninitialized buffer and texture descriptors start with no initialized coverage.",
        "A pure write initializes only its normalized buffer range, texture subresources, or query indices.",
        "ReadWrite never acts as implicit initialization because it reads prior content.",
        "BufferZero initializes exactly its checked buffer region.",
        "Query resolution requires initialized source query coverage and initializes only its checked destination buffer range.",
        "Render attachment Load requires initialized source coverage; Clear(value) establishes source coverage before draws.",
        "Render attachment writes preserve or update source coverage; a multisample resolve independently initializes its destination coverage.",
        "Store preserves source coverage and Discard invalidates source later-readable coverage without invalidating the resolve destination.",
        "Imported and retained prior-epoch contents enter through explicit GpuWorkResourceInput evidence; labels, lifetime alone, or current runtime existence never imply initialized content.",
        "G3 validates graph-time evidence only and does not claim G5 execution preserved, synchronized, uploaded, resolved, copied, mapped, or retired content.",
        "Every read-before-initialization error includes operation, prepared node, typed resource, normalized range/subresources, cause, and correction.",
    ],

    work_identity_types: [
        "pub struct GpuWorkNodeId as a private-construction nonzero fragment-local identity allocated monotonically by GpuWorkFragmentBuilder",
        "pub struct GpuPreparedWorkNodeId { fragment_ordinal, local_node_id } assigned deterministically during composition",
        "Node identities are typed and process-local and have no persistence, replay, network, wire, ABI, external-format, or cache guarantee.",
        "GpuWorkResourceId remains the only logical resource identity; node IDs never reuse or reinterpret it.",
    ],

    export_and_composition_types: [
        "pub struct GpuExportKey(String) as a validated trimmed non-empty semantic key with PartialEq, Eq, PartialOrd, Ord, and Hash",
        "GpuExportRelationship replaces raw String export_key storage with GpuExportKey without changing resource/final-access/provenance ownership",
        "pub struct GpuWorkImport containing a kind-preserving resource reference, producer GpuExportKey, required initial access intent, and provenance",
        "pub struct GpuWorkOutput containing a GpuExportRelationship and normalized final initialized coverage",
    ],

    work_public_types: [
        "pub enum GpuExecutionPreference { Automatic, ComputePreferred, GraphicsRequired, TransferPreferred } as a hint without a concurrency guarantee",
        "pub struct GpuExplicitOrder containing typed fragment-local before/after node IDs and a validated non-empty diagnostic reason",
        "pub enum GpuDependencyReason { ReadAfterWrite, WriteAfterRead, WriteAfterWrite, ExplicitNonData }",
        "pub struct GpuWorkDependency containing prepared before/after node IDs, normalized resource/range evidence when data-derived, and GpuDependencyReason",
        "pub struct GpuWorkNode as immutable pre-admission work intent with private identity, one GpuWorkOperation, normalized accesses, merged capability requirements, execution preference, label, and provenance",
        "pub struct GpuWorkFragment as immutable declared/imported/exported resources, nodes, explicit non-data order, outputs, and provenance",
        "pub struct GpuWorkFragmentBuilder as the only mutable lexical/closure-scoped authoring surface",
        "pub struct GpuPreparedWorkGraph as the single immutable validated graph authority",
        "pub struct GpuPreparedWorkDiagnostic with typed category, node/resource/range/provenance fields, human operation/cause/correction, and no backend-only dump",
    ],

    work_semantics: [
        "GpuWorkFragment::build(label, closure) allocates fragment-local node IDs and returns one immutable fragment or a structured authoring error.",
        "The fragment label is diagnostic only; it does not determine composition, dependency direction, or prepared identity.",
        "Node builders use lexical closure scope and return Result; no repeated finish ladder, panic, unwrap, silent fallback, or partially valid public node exists.",
        "GpuWorkOperation is the single operation-shape authority; node kind and operation-derived accesses/requirements cannot disagree with it.",
        "Shader source, shader entry points, pipeline identities, binding keys/layouts, WGPU modules, query decoding, and realization remain G4/G5 or adapter-owned.",
        "Current render execution and timestamp-decoding data is held in a temporary sidecar keyed by GpuPreparedWorkNodeId and cannot affect generic hazard truth.",
        "Strings are labels or diagnostic reasons only; GpuExportKey is a typed semantic key rather than a label.",
    ],

    hazard_rules: [
        "Two overlapping read-only normalized accesses require no edge.",
        "A write followed by an overlapping read infers a ReadAfterWrite edge.",
        "A read followed by an overlapping write infers a WriteAfterRead edge.",
        "Two overlapping writes infer a WriteAfterWrite edge only when the producer order is unique under fragment-local lexical order or an accepted import/export relation.",
        "Disjoint GpuBufferRange values do not conflict.",
        "Disjoint texture mip ranges, array-layer ranges, non-overlapping aspects, and disjoint query ranges do not conflict.",
        "ReadWrite participates as both read and write for overlap and initialization.",
        "Within one fragment, lexical node declaration order orients access-derived hazards; callers do not restate those edges.",
        "Fragment order in the prepare input iterable is deterministic enumeration only and is not semantic scheduling authority.",
        "Any cross-fragment overlap with at least one write requires the same typed resource plus one matching GpuExportKey/GpuWorkImport producer-consumer relation; without it preparation fails with MissingCrossFragmentCausality rather than choosing RAW or WAR from input position.",
        "Overlapping cross-fragment writers without one unique accepted producer/export relation fail as AmbiguousWriter.",
        "Multiple exports with the same GpuExportKey, mismatched resource kind, mismatched final/initial access, or incompatible initialized coverage fail deterministically.",
        "Duplicate identical accesses inside one node are deduplicated; compatible storage read plus write over the same range normalizes to StorageReadWrite.",
        "Incompatible overlapping same-node roles, including sampled-read plus attachment-write, attachment source aliasing resolve destination, or overlapping copy source/destination on one resource, fail unless the typed operation contract explicitly proves legality.",
        "Timestamp writes followed by query resolution infer ReadAfterWrite through the query range; query resolution followed by buffer copy infers ReadAfterWrite through the resolved destination byte range.",
    ],

    graph_preparation: [
        "GpuPreparedWorkGraph::prepare(label, fragments) is the single advanced composition and validation entry point.",
        "Preparation does not mutate input fragments.",
        "Input enumeration assigns process-local diagnostic fragment ordinals and deterministic tie order among otherwise independent ready nodes only; it never creates a dependency, resolves a writer conflict, changes initialization truth, or gives fragment labels/provenance semantic ordering authority.",
        "Preparation validates duplicate, unknown, and foreign identities; operation/access/requirement consistency; descriptor kind/usages; normalized ranges; texture-view parent/range relationships; render attachments and resolve targets; attachment clear values; buffer-zero/copy/query-resolve/present shapes; query ranges; import/export contracts; and explicit-edge endpoints.",
        "Preparation derives and merges capability requirements, computes initialized coverage, infers data dependencies, rejects missing cross-fragment causality, rejects redundant explicit data order, adds accepted explicit non-data edges, rejects conflicting explicit/inferred order, rejects cycles and ambiguous writers, and produces deterministic topological order.",
        "Ties between independent ready nodes use deterministic prepared node identity only; this affects inspection order, not a claimed parallel execution guarantee.",
        "Prepared output includes ordered nodes, typed operation intent, typed dependency edges with reasons, normalized access records, initial/final coverage summaries, merged capability requirements, exports, diagnostics, and provenance.",
        "Preparation performs no context/backend admission, stale-generation/runtime-retirement check, shader/pipeline admission, resource realization, command encoding, query-resolution encoding, submission, readback, retirement, or surface action.",
        "G5 ordinary submit must invoke the same preparation authority internally; no common-path bypass is permitted.",
    ],

    explicit_order_rules: [
        "GpuExplicitOrder is fragment-local in G3 and uses typed GpuWorkNodeId endpoints.",
        "Its reason is required diagnostic text and does not become identity.",
        "It is accepted only for non-data constraints such as externally defined sequencing not expressible through a resource.",
        "An explicit edge that duplicates an inferred data edge fails with RedundantExplicitOrder; the correction is to remove it and rely on typed resource access.",
        "An explicit edge that opposes an inferred data edge or creates a cycle fails.",
        "Cross-fragment explicit node edges are deferred; current render passes requiring such order lower into one fragment, while independent fragments compose through resources and exports.",
    ],

    render_adapter_target: [
        "Add engine/src/plugins/render/adapters/gpu_work.rs as the only G3 render/GPU-primitive/timestamp lowering seam.",
        "The adapter resolves state-derived dispatch before constructing GpuDispatchSize; ECS TypeId/Any projection never enters RunenGPU.",
        "The adapter lowers RenderPassNode roles, color/depth attachments, attachment clear values, optional multisample resolve targets, and draw shape into one GpuWorkOperation plus exact operation-derived/caller-declared GpuResourceAccess values and maps render pass IDs to prepared node IDs.",
        "The adapter lowers current whole-resource uses to whole checked ranges/subresources only when current authoring has no narrower fact; it must not fabricate partial ranges.",
        "The adapter maps existing render initialization/history/import behavior to explicit GpuWorkResourceInput evidence and documents every retained later-phase seam.",
        "The adapter maps current beginning/end pass timestamp writes to exact WriteTimestamp query ranges.",
        "The adapter declares the current timing resolve buffer with GpuBufferUsage::QueryResolve plus CopySource, emits one typed GpuQueryResolveOperation, and models the later resolve-buffer-to-readback transfer as an ordinary typed buffer copy.",
        "The adapter preserves polling, mapping, timestamp-period conversion, timing diagnostics, and artifact presentation outside RunenGPU.",
        "The adapter produces one render fragment for passes sharing explicit non-data ordering and separate fragments only where composition is genuinely independent.",
        "The adapter keeps shader assets, render view/target meaning, fixed-step policy, material/UI/product meaning, pipeline/layout data, and execution payloads outside RunenGPU.",
        "CompiledRenderFlowPlan consumes GpuPreparedWorkGraph operation/order/dependencies/initialization/requirement diagnostics and no longer owns a second generic lifetime/hazard result.",
    ],

    primitive_adapter_target: [
        "Counter reset, prefix scan, scatter, and indirect-argument descriptors remain domain conveniences that lower through gpu_work.rs or a narrowly shared Runenwerk adapter.",
        "GpuPrimitiveResourceAccessKind and GpuPrimitiveResourceAccess are deleted after lowering uses GpuBufferAccess/GpuResourceAccess.",
        "GpuPrimitiveDispatchResource::Temporary(String) is replaced with typed G2 transient buffer handles allocated by the existing bounded owner adapter.",
        "String stage dependencies are deleted; scan hierarchy and stage order are inferred from typed temporary/input/output resource accesses plus fragment-local lexical order.",
