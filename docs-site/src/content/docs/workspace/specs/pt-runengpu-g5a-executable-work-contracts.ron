// Decision-complete implementation specification for RunenGPU G5A.
// Planning issue #284 owns this specification. Rust implementation requires a separate activated issue after planning acceptance.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G5A",
    title: "Executable Logical Work Contracts",
    lifecycle_state: "planned-blocked",
    implementation_authorization_status: "blocked-until-accepted-g5-planning-and-explicit-g5a-issue",
    owner: "RunenGPU executable work contract owner",
    source_baseline: "accepted-g5-planning-merge-to-be-recorded-by-g5a-issue",
    planning_issue: "dornglut/runenwerk#284",
    implementation_issue: "pending-after-accepted-g5-planning",
    parent_issue: "dornglut/runenwerk#167",
    completed_predecessor_issue: "dornglut/runenwerk#214",
    completed_predecessor_pull_request: "dornglut/runenwerk#242",
    completed_predecessor_merge: "ed2bcc2dbe4a302032c2ee53b6972facba7f940e",
    successor: "PT-RUNENGPU-G5B",
    target_repository_after_internal_conformance: "dornglut/runen-gpu",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "docs-site/src/content/docs/architecture/repository-family-architecture.md",
        "docs-site/src/content/docs/adr/accepted/0015-separate-gpu-execution-from-rendering.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runengpu-g5-execution-lifecycle-design.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-g5-execution-lifecycle-investigation.md",
        "docs-site/src/content/docs/reports/investigations/2026-08-14-runengpu-g5-critical-review.md",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
    ],

    goal: "Close the logical execution gap left by G3-before-G4 sequencing: make compute/render work self-contained through accepted G4 pipeline and runtime-binding contracts, separate per-use dynamic binding state from physical bind-group realization identity, bind render-pass attachment/pipeline compatibility before backend encoding, add generic Upload/Readback operations inside the one G3 initialization/hazard authority, preserve semantic value equality without inventing operation ordering or content-addressed transfer identity, derive executable resource accesses from operations, migrate RunenRender lowering into those contracts, and delete execution-semantic truth from the temporary render sidecar without implementing command submission or progress.",

    dependency_direction: [
        "RunenRender semantic planning -> complete backend-neutral G5A GpuWorkOperation values.",
        "G5A operations -> accepted G3 preparation for order, initialization, hazards, requirements, outputs, and provenance.",
        "Accepted G4B pipeline/interface/runtime-binding/render-state contracts remain the only program/layout/pipeline semantic authority used by G5A.",
        "G5A refines G4C2 bind-group physical realization identity only where the accepted backend object demonstrably excludes per-use dynamic offsets; it creates no second binding authority.",
        "G5B later prepares and realizes complete G5A work for one context/device generation; G5A does not encode or submit backend work.",
    ],

    operation_value_traits: [
        "GpuWorkOperation and operation aggregates that embed executable G4 descriptors retain semantic PartialEq/Eq but do not retain or acquire PartialOrd/Ord/Hash merely because earlier simple G3 payloads happened to derive them.",
        "Accepted deterministic graph preparation is ordered by fragment/node/resource identities and dependency topology, not by comparing GpuWorkOperation payloads; G5A must not create a new operation-ordering authority.",
        "Do not add PartialOrd/Ord to GpuComputePipelineDescriptor, GpuRenderPipelineDescriptor, runtime binding sets, shader/program contracts, or transfer payloads solely to preserve an accidental derive.",
        "Lower-level identities, ranges, enums, and canonical scalar wrappers may retain natural Ord/Hash where they already have an independent semantic use.",
        "If exact-current-main implementation discovers a concrete operation Hash/Ord consumer outside accepted graph preparation, stop and classify that consumer rather than inventing hash-based or descriptor-label ordering.",
    ],

    compute_contract: [
        "GpuComputeOperation owns one complete GpuComputePipelineDescriptor, one backend-neutral GpuRuntimeBindingSet, and one checked nonzero dispatch extent.",
        "Pipeline descriptor semantics are not copied into a second compute-execution descriptor.",
        "Runtime bindings use typed GpuBindingKey and logical buffer/texture-view/sampler handles; GpuRuntimeBufferBinding already owns its exact static range and optional dynamic offset, so G5A introduces no parallel public dynamic-offset side channel.",
        "Compute accesses are derived from the selected program interface, binding declarations, runtime resources, ranges, effective static-plus-dynamic offsets, and storage access modes; callers do not supply duplicate bound-resource access truth.",
        "Compute requirements merge operation kind, pipeline requirements, runtime resource requirements, and admitted format/limit facts deterministically.",
    ],

    render_contract: [
        "GpuRenderOperation remains one logical render pass with color attachments, optional depth/stencil attachment, ordered GpuRenderDraw values, and timestamp writes.",
        "Each GpuRenderDraw owns one complete GpuRenderPipelineDescriptor, one GpuRuntimeBindingSet, ordered vertex-buffer bindings, optional index-buffer binding, one GpuDrawIntent, and complete normalized dynamic state.",
        "A render operation may switch pipelines and bindings between draws without splitting one logical render pass; the current multi-pipeline UI pass is the representative proof.",
        "The pipeline descriptor is the sole authority for vertex stride, step mode, attributes, primitive state, depth/stencil state, multisample state, and ordered color-target state.",
        "Draw bindings contain only runtime resource/range/state facts required to execute that pipeline.",
    ],

    render_pass_compatibility: [
        "Derive one backend-neutral render-pass attachment signature from logical attachments before backend access: effective render extent, common attachment sample count, ordered color attachment formats, and optional depth/stencil format.",
        "Every active color/depth attachment in one render operation must have the same effective render extent and sample count; reject mismatched logical attachment views before private WGPU begin_render_pass validation.",
        "Existing G3 resolve validation remains authoritative for non-aliasing multisampled source versus single-sampled destination with matching color format and extent; G5A preserves those facts in the complete pass signature.",
        "For every GpuRenderDraw, require exact compatibility between its GpuRenderPipelineDescriptor and the operation pass signature: ordered color-target count/formats, depth/stencil presence and format, and multisample sample_count.",
        "Pipeline switches inside one render pass are allowed only when each pipeline is compatible with the same pass signature; pipeline blend/write/primitive state may differ because those remain draw-pipeline state rather than attachment compatibility facts.",
        "Current accepted RunenGPU has no multiview render-pass contract and G5A does not invent one. If exact-current-main consumers require multiview or 3D depth-slice rendering, stop for a separately accepted semantic extension rather than forwarding raw WGPU state.",
        "The common logical render extent is the authority from which default viewport and scissor resolve; do not choose one arbitrary attachment when attachment extents disagree.",
        "G5B repeats device-dependent renderability/capability validation, but backend rejection must not be the first place a logically knowable attachment/pipeline mismatch is discovered.",
    ],

    vertex_index_contract: [
        "GpuVertexBufferBinding contains slot, GpuBufferHandle, and checked nonempty GpuBufferRange.",
        "Reject duplicate slots, undeclared slots, missing pipeline-required slots, non-Vertex usage, zero/out-of-bounds ranges, and incompatible logical buffer state before G5B backend access.",
        "Reuse the already accepted RunenGPU GpuIndexFormat::{Uint16, Uint32} from the G4 render-pipeline contract; G5A must not create a duplicate index-format type or WGPU re-export.",
        "GpuIndexBufferBinding contains GpuBufferHandle, checked nonempty range, and accepted GpuIndexFormat; validate Index usage, element alignment, and direct indexed range coverage where knowable from the bound range.",
        "Direct Indexed or indexed Indirect draw intent requires exactly one index binding; non-indexed intent rejects an index binding until a separately accepted semantic justifies one.",
        "Existing GpuDrawIntent::Indirect retains the argument buffer/range/indexed flag; GPU-produced indirect counts/indices are not pre-read by G5A. G5A does not add multi-draw-indirect or mesh-shader vocabulary without an accepted consumer requirement.",
    ],

    dynamic_draw_state: [
        "GpuRenderDynamicState owns normalized optional viewport/scissor/blend-constant overrides plus an explicit stencil-reference value; absence of an override has one defined semantic default and never means inherit accidental prior draw state.",
        "GpuViewport stores canonical finite f32-bit values for x, y, width, height, min_depth, and max_depth; normalize signed zero, require nonnegative width/height, require zero <= min_depth <= max_depth <= one, and reject arithmetic/non-finite invalidity before backend access.",
        "G5A does not require viewport x/y to lie inside the attachment or require nonzero area. G5B preparation validates WGPU/device-specific maximum viewport size and position range against admitted device facts.",
        "Viewport default resolves to the complete common logical render extent derived from the validated attachment set with depth range zero-to-one.",
        "GpuScissorRect stores checked u32 x/y/width/height, allows zero-area rectangles, requires checked x+width/y+height, and requires the rectangle to fit the common logical render extent.",
        "Scissor default resolves to the complete common logical render extent.",
        "GpuBlendConstant stores four canonical finite f64-bit components with signed zero normalized; G5A does not invent a zero-to-one clamp unless an accepted backend-neutral rule requires it. Its default is transparent zero.",
        "Stencil reference is u32 with default zero.",
        "Every draw therefore has deterministic effective dynamic state and semantic Eq; backend lowering may elide redundant setters but no draw inherits unspecified state from a previous draw.",
    ],

    runtime_binding_set: [
        "GpuRuntimeBindingSet is the one backend-neutral logical binding-use aggregate for one compute invocation or render draw. It contains the complete accepted G4B runtime values across the pipeline layout and preserves every per-use dynamic offset as u64 logical buffer-address semantics.",
        "Construction groups and canonically orders values by typed GpuBindingKey, requires exact pipeline-layout/interface coverage, rejects duplicate/missing/unexpected keys, and performs context-free resource-kind/cardinality/logical-range checks.",
        "Operation-derived buffer access uses the effective static offset plus dynamic offset and exact bound size, so hazard/initialization semantics follow the actual invocation range rather than the physical bind-group object's static base.",
        "Device-dependent dynamic-offset alignment and backend representability remain G5B preparation checks against accepted device/backend facts; G5A does not narrow the public logical offset from u64 merely because the first WGPU backend uses u32 DynamicOffset.",
    ],

    bind_group_realization_projection: [
        "Accepted G4C2 currently keys BindGroupRequestKey by complete GpuRuntimeBindingValue values even though WGPU bind-group creation uses only each buffer binding's static offset/size and applies dynamic offsets later at set_bind_group. G5A corrects this physical-identity overconstraint before G5 execution relies on it.",
        "After validating the complete logical GpuRuntimeBindingSet, derive one private static bind-group realization projection containing exact context affinity, layout, resource identities, texture/sampler facts, and buffer static offsets/sizes while excluding per-use dynamic offset values from physical realization equality/hash.",
        "GpuContext bind-group realization and its single-flight key/record use complete full-equality static projection, not a naked hash and not a synthetic dynamic-offset value. Requests differing only in dynamic offsets reuse the same backend BindGroup realization record.",
        "The physical record retains exactly the static resource dependencies needed for object lifetime and registry membership. Per-use dynamic offsets remain only in the logical GpuRuntimeBindingSet and later G5 prepared execution state.",
        "GpuRealizedBindGroup remains an opaque physical realization handle with affinity, layout descriptor, and record identity. Remove the public GpuRealizedBindGroup::values() accessor in the G5A clean cutover because one shared physical record cannot truthfully expose one invocation's dynamic offsets; callers needing logical values inspect their GpuRuntimeBindingSet instead.",
        "Do not leave values() as a compatibility alias returning a first-request, zeroed, or otherwise synthetic dynamic-offset view. If static physical-value introspection is later demonstrated as necessary, add a separately named contract after review rather than conflating it with logical binding use.",
        "Current realize_bind_group callers and tests are censused and migrated in the same G5A slice; no parallel old dynamic-offset-sensitive and new static-projection realization keys may survive acceptance.",
    ],

    operation_access_derivation: [
        "Compute derives buffer/texture accesses from runtime bindings and program declarations, including accepted storage-buffer ReadOnly/ReadWrite and storage-texture ReadOnly/WriteOnly/ReadWrite modes.",
        "Render derives attachment, resolve, runtime binding, vertex, index, indirect-argument, and timestamp accesses.",
        "Copy, Clear, Resolve, and Present retain accepted G3 derived-access semantics.",
        "Upload derives exactly one destination write over its exact logical region.",
        "Readback derives exactly one source read over its exact logical region.",
        "Validate the complete derived access set for overlapping contradictory roles inside one operation, including runtime bindings versus attachments and multiple write-capable bindings.",
        "Preparation rejects caller-supplied access facts that contradict operation-derived facts; current renderer lower_caller_accesses duplication is deleted.",
    ],

    transfer_payload_identity: [
        "Introduce opaque nonzero process-local GpuTransferPayloadId allocated by RunenGPU as record/correlation identity for one immutable transfer payload object.",
        "GpuTransferPayload owns one GpuTransferPayloadId plus Arc-backed immutable checked PreparedGpuData<TransferData> or the accepted GpuPreparedTextureData shape and provenance needed by the operation.",
        "Cloning a transfer payload preserves the same payload ID and immutable Arc-backed bytes; one payload ID can never be rebound to different bytes/layout/provenance during its lifetime.",
        "Semantic PartialEq/Eq for GpuTransferPayload compares checked payload value semantics (layout/format/extent/bytes as applicable) and deliberately excludes GpuTransferPayloadId, so separately constructed byte-identical payloads remain semantically equal.",
        "Expose an explicit record-identity predicate such as is_same_record when callers/tests need to distinguish clones of one payload record from equal independently constructed payload values; do not overload semantic Eq for this purpose.",
        "GpuTransferPayload and executable operation aggregates do not require Hash/Ord in G5A; graph determinism therefore never traverses large payload bytes merely to sort/hash operations.",
        "GpuTransferPayloadId is not a stable content hash, persistence identity, replay identity, wire identity, cache key, artifact identity, or cross-process identity.",
        "A content digest may exist only as optional internal diagnostics/deduplication evidence if later justified; it cannot replace semantic payload equality or immutable payload correctness.",
        "Do not introduce a renderer-owned payload table or permanent sidecar: the RunenGPU payload value itself retains the immutable data.",
    ],

    upload_contract: [
        "Add one generic GpuWorkOperation::Upload family for exact buffer and texture destinations.",
        "Upload source is one immutable GpuTransferPayload with checked layout/provenance; no public WGPU staging object appears.",
        "The logical operation does not select queue-write versus encoded-copy mechanics.",
        "Graph initialization simulation treats a complete Upload write as an initializing write and normal hazard/order rules apply.",
        "Backend-private physical lowering may choose queue write only when ordering-equivalent to the exact graph node position; otherwise G5B uses private staging plus encoded copy.",
    ],

    readback_contract: [
        "Add one generic GpuWorkOperation::Readback family for exact buffer and texture source regions.",
        "Allocate an opaque nonzero process-local GpuReadbackId at authoring; duplicate IDs in one prepared graph reject deterministically.",
        "Readback exposes no logical staging buffer and no raw mapped range.",
        "The operation's graph semantics are one exact source read and one readback result identity; G5B owns private staging/mapping/result publication.",
        "Texture readback contract defines normalized tightly packed logical result bytes independent of backend row-padding requirements.",
        "CPU feedback from readback cannot affect later nodes in the same GPU graph; consumers must build a later submission after observing the result.",
    ],

    present_contract: [
        "GpuPresentOperation remains accepted G3 logical ordering/presentation intent and retains its source access semantics.",
        "G5A does not add a raw surface, SurfaceTexture, presentation callback, or surface acquisition object to the operation.",
        "SurfaceAcquired logical resources remain distinct from ordinary G4C1-realizable resources; G5A does not manufacture an imported-resource surrogate.",
        "Physical reusable surface acquisition/presentation remains G7-owned; G5B/G5C coordinate only the logical surface requirement and current-host private integration required before G7.",
    ],

    sidecar_cutover: [
        "Migrate RenderGraph lowering so compute/fullscreen/graphics/UI/copy/present/timing work produces complete generic GpuWorkOperation values.",
        "Delete program, pipeline, binding, vertex/index, draw, copy/query, render-pass-compatibility, and other GPU execution truth from RenderGpuWorkSidecar/CompiledPassExecutionPlan after its generic equivalent is admitted.",
        "Do not move RenderPassId, feature/view/material/image-formation policy into RunenGPU.",
        "If a renderer-local planning/provenance record remains before lowering, it cannot be keyed as permanent prepared-node execution authority.",
        "Do not introduce a permanent GpuExecutionBindings, command-list sidecar, or second executable graph.",
    ],

    migration_rules: [
        "Change generic work contracts and bind-group static-realization projection before deleting caller duplication, then migrate every renderer/UI adapter constructor and current direct realize_bind_group consumer to the checked new contracts in the same slice.",
        "Keep existing G5 raw encoding seams only as execution mechanics; they must read complete generic prepared work rather than a render execution sidecar after G5A.",
        "Do not implement G5B submit/progress/completion APIs in this slice.",
        "Delete superseded access, execution-semantic sidecar, dynamic-offset-sensitive physical bind-group keying, and ambiguous realized-bind-group values introspection rather than leaving aliases or dual paths.",
    ],

    deterministic_tests: [
        "Compute operation derives exact uniform/storage/sampled/storage-texture accesses from runtime bindings and rejects contradictory/missing/duplicate binding input.",
        "Render operation derives exact attachment/resolve/binding/vertex/index/indirect/query accesses across multiple draws.",
        "Render construction rejects mismatched attachment extents or sample counts and rejects every draw pipeline whose ordered color formats, depth/stencil format/presence, or sample count is incompatible with the pass signature.",
        "One multi-draw UI-shaped render operation switches compatible pipelines, bind groups, vertex buffers, and scissor without creating additional render passes.",
        "Default viewport/scissor are derived from the validated common render extent rather than arbitrary first-attachment behavior.",
        "Zero-area viewport and scissor remain valid deterministic state; non-finite viewport/blend values and out-of-bounds scissor reject structurally, while device-specific viewport maximum/position bounds reject during G5B preparation.",
        "Vertex slots and accepted GpuIndexFormat ranges validate deterministically and insertion-order-independent where order is not semantic.",
        "GpuWorkOperation/GpuRenderDraw compile and remain semantically comparable without requiring Ord/Hash on G4 pipeline descriptors or transfer payloads.",
        "Two GpuRuntimeBindingSet values differing only by one valid dynamic offset remain distinct logical invocation values and derive different effective access ranges where applicable, while their G4C2 physical bind-group realization reuses one identical backend record.",
        "Static offset/size/resource changes split physical bind-group realization; dynamic-offset-only changes do not.",
        "GpuRealizedBindGroup exposes no values() API after the clean cutover, and source guards reject a compatibility alias that would confuse physical realization with per-use dynamic state.",
        "GpuTransferPayload clones preserve record identity and value; independently constructed equal payload bytes compare semantically equal while is_same_record distinguishes record identity.",
        "Upload writes satisfy initialization when complete and order against conflicting graph accesses.",
        "Readback reads order against conflicting writes and retains one unique result identity.",
        "Texture transfer/readback shape, row coverage, format and bounds reject arithmetic overflow and invalid regions.",
        "Complete operation-derived access set matches the former renderer caller-access set for representative current passes.",
        "Prepared graph order, diagnostics and requirements remain deterministic across fragment composition without sorting GpuWorkOperation payloads.",
        "Source guards reject permanent sidecar execution truth, duplicate manual bound-resource accesses, duplicate GpuIndexFormat, dynamic-offset-sensitive physical bind-group keys, public realized-group per-use values introspection, raw WGPU types in new public contracts, operation ordering invented from hashes/labels, and content-digest identity replacing semantic payload equality.",
    ],

    environment_dependent_tests: [
        "None required for the semantic contract itself beyond existing G4 program/resource realization proofs; G5B owns live execution.",
    ],

    delete_after_migration: [
        "Current renderer lower_caller_accesses duplication for bindings/vertex/index/indirect resources represented by executable operations.",
        "Execution-semantic RenderGpuWorkSidecar payload and node-keyed pipeline/binding/draw/render-pass-compatibility truth.",
        "Renderer-only duplicate compute/render execution descriptors replaced by G4/G5 logical contracts.",
        "Dynamic-offset-sensitive G4C2 BindGroupRequestKey/record identity and public GpuRealizedBindGroup::values() semantics that conflate one physical backend object with one invocation's dynamic offsets.",
        "Any WGPU IndexFormat or dynamic-state type exposed above private backend lowering.",
        "Accidental GpuWorkOperation/GpuComputeOperation/GpuRenderOperation Ord/Hash derives that cannot remain semantically valid once complete G4 executable descriptors are embedded.",
    ],

    retain_for_g5b: [
        "CurrentRenderDeviceQueue and CurrentRenderExecutionBridge only as temporary backend execution mechanics.",
        "Current renderer command encoding/submission/poll/map orchestration until G5C.",
        "Accepted G4 realization owners and Arc-backed registries, with bind-group physical identity corrected to static binding semantics.",
        "Complete generic G5A GpuWorkOperation/GpuPreparedWorkGraph as the only logical execution authority.",
    ],

    stop_conditions: [
        "No G5B command submission, progress, completion, pressure, shutdown, or private mapping implementation beyond type-level seams required to keep compilation coherent.",
        "No RunenRender image-formation/material/view semantics in RunenGPU.",
        "No G7 reusable surface acquisition/reconstruction implementation.",
        "No second graph/command IR, permanent node sidecar, public raw WGPU/Naga type, broad import API, executor dependency, new stable persistence format, compatibility alias, content-addressed transfer identity promise, fabricated total ordering for pipeline/program contracts, or second public dynamic-offset representation.",
        "Do not add multiview, 3D render depth-slice, multi-draw-indirect, mesh-shader, or other undemonstrated render vocabulary in G5A. Stop for a separately accepted semantic extension if exact current consumers require it.",
        "Stop for a new design decision if current consumers require a dynamic render state outside viewport/scissor/blend-constant/stencil-reference or an execution semantic not representable without changing accepted G3/G4 ownership.",
    ],

    validation: [
        "Focused executable-work/access/value-semantics/render-pass-compatibility/dynamic-binding/dynamic-state/sidecar-cutover tests and source guards.",
        "Complete current consumer census for compute/render/attachment/binding/vertex/index/upload/readback construction and every direct realize_bind_group/GpuRealizedBindGroup::values use.",
        "cargo validate",
        "git diff --check",
        "CI=true pnpm --dir docs-site build",
        "Exact-head CI and Documentation Build must succeed before acceptance.",
    ],

    acceptance: [
        "One complete executable logical work authority exists in RunenGPU and the renderer sidecar no longer owns GPU execution semantics.",
        "Every current G5A operation derives complete access/requirement truth without renderer duplicate bindings/access lists.",
        "Every render draw is logically compatible with one validated pass attachment extent/format/sample signature before backend encoding.",
        "Dynamic offsets remain logical per-use execution state, affect effective access ranges, do not split physical bind-group realization identity, and are not exposed ambiguously through GpuRealizedBindGroup.",
        "Executable operation value semantics do not fabricate Ord/Hash contracts for G4 pipeline descriptors or use process-local payload identity as semantic equality.",
        "Upload/Readback contracts are graph-visible and backend-neutral; transfer payload record identity remains distinct from semantic immutable payload value.",
        "Logical Present remains distinct from G7 physical surface ownership.",
        "No G5B/G5C ownership is implemented prematurely.",
        "Accepted-main validation must pass before activating G5B.",
    ],
)