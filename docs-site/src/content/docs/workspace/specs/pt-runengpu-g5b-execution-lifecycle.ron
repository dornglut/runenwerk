// Decision-complete implementation specification for RunenGPU G5B.
// G5B starts only after accepted G5A and an explicitly activated child issue.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G5B",
    title: "Execution, Progress, Completion, Transfer, and Retirement Lifecycle",
    lifecycle_state: "planned-blocked",
    implementation_authorization_status: "blocked-until-accepted-g5a-and-explicit-g5b-issue",
    owner: "RunenGPU execution lifecycle owner",
    source_baseline: "accepted-g5a-merge-to-be-recorded-by-g5b-issue",
    planning_issue: "dornglut/runenwerk#284",
    implementation_issue: "pending-after-accepted-g5a",
    parent_issue: "dornglut/runenwerk#167",
    blocking_predecessor: "PT-RUNENGPU-G5A",
    successor: "PT-RUNENGPU-G5C",
    target_repository_after_internal_conformance: "dornglut/runen-gpu",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "docs-site/src/content/docs/architecture/repository-family-architecture.md",
        "docs-site/src/content/docs/adr/accepted/0015-separate-gpu-execution-from-rendering.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runengpu-g5-execution-lifecycle-design.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-g5-execution-lifecycle-investigation.md",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g5a-executable-work-contracts.ron",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
    ],

    goal: "Create one context/device-generation-bound RunenGPU execution lifecycle from accepted complete G5A work through asynchronous preparation, bounded submission admission, private WGPU encoding/submission, host-driven progress, exactly-once terminal outcomes, upload/readback staging, normalized asynchronous readback results, health integration, shutdown, and submission-aware delayed retirement; prove the boundary with an independent non-render consumer while leaving the existing renderer on its temporary G5 seams until G5C.",

    dependency_direction: [
        "Accepted G5A GpuPreparedWorkGraph + accepted G4 realization owners -> G5B private execution preparation.",
        "GpuPreparedSubmission -> bounded GpuContext submit admission -> private WGPU encoding/Queue submission.",
        "Private backend completion/mapping callbacks -> one RunenGPU completion registry -> normalized GpuSubmission/GpuReadback outcomes.",
        "G5C later migrates RunenRender/UI consumers to this accepted authority and deletes temporary raw execution seams.",
    ],

    preparation_contract: [
        "Provide one asynchronous GpuContext preparation terminal for complete accepted G5A work; convenience overloads must converge on this authority.",
        "Preparation validates context Running state, exact context/device generation, complete graph shape, operation-derived accesses/requirements, runtime binding device facts, and all transfer/readback bounds before backend encoding.",
        "Preparation realizes every referenced resource/program/layout/bind-group/pipeline only through accepted G4 owners and retains exact realization records needed for execution.",
        "Preparation plans bounded private upload/readback staging but does not submit queue work or allocate a GpuSubmissionId.",
        "Preparation publishes no partial prepared value on semantic, realization, pressure, stale-generation, unavailable-device, or staging-plan failure.",
    ],

    prepared_submission_contract: [
        "GpuPreparedSubmission is opaque, immutable after publication, context/device-generation-bound, process-local, and single-use after successful submit.",
        "It may expose normalized graph/diagnostic/estimated-pressure facts but never WGPU command buffers, pipelines, bind groups, resources, mapped ranges, or submission indices.",
        "Its private realized/encoding records are derived non-authoritative state reconstructable from the accepted logical contracts while the generation remains valid.",
        "Dropping a prepared submission creates no submission identity and is not reported as cancellation of accepted GPU work.",
        "A pressure rejection must return/preserve the prepared value so callers may retry without semantic reconstruction.",
    ],

    submission_identity: [
        "GpuSubmissionId is opaque, nonzero, monotonically allocated within one live context/device generation, and process-local only.",
        "Allocate no GpuSubmissionId before bounded submit admission succeeds.",
        "GpuSubmissionId is correlation identity only and is not persistence, replay, wire, cache, hardware, WGPU SubmissionIndex, Vulkan fence, D3D12 fence, or Metal event identity.",
        "One accepted submission record owns exactly one terminal GpuSubmissionOutcome publication.",
    ],

    submit_admission: [
        "submit_prepared consumes one prepared value only after all synchronous admission checks succeed.",
        "Reject stale generation, non-Running context, already-consumed prepared state, pressure, and incompatible execution state before queue submission.",
        "Pressure rejection performs no queue operation, allocates no submission ID, mutates no logical resource authority, and returns the retryable prepared value.",
        "After successful admission, accepted work is never silently discarded even if all caller observation handles are dropped.",
        "No hidden accepted-but-unsubmitted queue or unbounded retry loop is permitted.",
    ],

    private_encoding: [
        "G5B owns the sole new private lowering from prepared operations to WGPU command encoding.",
        "Encode Compute through G4C3 realized compute pipeline, G4C2 realized bindings, exact dispatch, and no consumer-provided raw callback.",
        "Encode Render through logical attachments, ordered GpuRenderDraw state, G4C3 realized render pipelines, realized bind groups, vertex/index/indirect buffers, dynamic state, draw intent, and timestamp writes.",
        "Encode accepted Copy, BufferZero, QueryResolve, Upload, and Readback operations in prepared graph order.",
        "Upload may privately lower to queue write only when provably ordering-equivalent; otherwise use bounded private staging plus encoded copy.",
        "Readback always keeps staging/mapping objects private and encodes its observation copy at the exact logical operation position.",
        "Logical Present is not generalized into G5 surface ownership; execute it only through a separately accepted G7 surface terminal when available, otherwise retain the current explicitly classified surface boundary outside this slice.",
        "No RunenRender/consumer module creates a new G5B CommandEncoder, Queue submission, or raw backend execution callback for consumers migrated to G5B.",
    ],

    submission_outcomes: [
        "Public semantic submission state is Submitted followed by exactly one terminal Completed or Failed outcome; backend-specific physical-start state is not promised.",
        "GpuSubmissionFailure structurally distinguishes context/device unavailable-or-lost, attributed backend execution/validation failure, forced shutdown terminalization, and invariant failure.",
        "Backend text remains bounded diagnostic evidence only and never determines identity or error category.",
        "Already-submitted GPU work is never claimed physically cancellable; observer drop or product disinterest is not a fake Cancelled execution outcome.",
    ],

    progress_contract: [
        "Provide nonblocking GpuContext::progress as the portable execution-maintenance terminal.",
        "GpuProgressReport is bounded normalized evidence covering completed/failed submissions, advanced/ready/failed readbacks, retired records, pressure relief, and terminal health facts without exposing backend poll/fence values.",
        "On native WGPU, progress may privately invoke nonblocking device/instance polling as required by the pinned backend.",
        "On WebGPU, browser/event-loop progress remains external; progress drains and publishes callback state and must not depend on WGPU Device::poll having effect.",
        "RunenGPU owns no mandatory Tokio/Futures executor, thread pool, or implicit immortal native progress thread in G5B.",
        "Any callback/future observation adapter uses the same completion registry, does not transfer progress ownership, invokes observers outside locks, and bounds stored observer/waker state.",
        "A universal blocking wait is not part of the future-transferable G5B baseline; Runenwerk host/CLI policy may drive progress according to product needs.",
    ],

    pressure_contract: [
        "Introduce finite validated GpuExecutionLimits for max in-flight submissions, upload bytes in flight, readback bytes in flight, pending readback count, retained terminal records, and deferred retirement records.",
        "Every configured limit is nonzero where zero would make the context unusable; defaults are finite and documented.",
        "GpuPressure contains typed kind, current occupancy, requested increment, limit, and corrective action.",
        "Submission-count, upload-byte, readback-byte, readback-count, terminal-record, and retirement pressure are distinguishable.",
        "Pressure never becomes silent eviction, dropped work, unbounded allocation, sleep, implicit blocking, device-loss error, or generic validation failure.",
        "Completion/progress retires occupancy monotonically when records become safe and reports relieved pressure without requiring a caller callback under a lock.",
    ],

    readback_contract: [
        "Each accepted GpuReadbackId produces exactly one submission-owned observation record.",
        "Public readback state is Pending followed by exactly one terminal Ready(GpuReadbackBytes) or Failed(GpuReadbackFailure).",
        "Submission execution completion and readback terminal completion are separate facts; a submission may be Completed while readback mapping/normalization remains Pending.",
        "Private readback staging buffers are allocated within configured byte/count pressure and retain exact context/device generation.",
        "Map callbacks publish only into the matching generation-bound readback record and cannot publish twice, after incompatible terminal state, or into another submission.",
        "Mapped WGPU ranges never escape; copy/normalize bytes into immutable GpuReadbackBytes, unmap, and then make staging eligible for retirement.",
        "Normalize texture result data to tight logical rows and preserve logical texture format/provenance rather than exposing backend row padding.",
        "Parent submission failure terminalizes dependent readbacks structurally; dropping a readback observer does not leak or cancel internal cleanup.",
    ],

    upload_contract: [
        "Account upload payload/staging lifetime until backend execution no longer requires it, not merely until the API call returns.",
        "Private queue-write staging and encoded staging-copy paths share one logical Upload operation and pressure accounting.",
        "Physical lowering may differ by operation position/size/backend but cannot change logical ordering, destination contents, initialization facts, or failure classification.",
        "No raw queue-write handle or staging buffer becomes public or renderer-owned authority.",
    ],

    health_integration: [
        "Reuse the accepted single WGPU device-loss observer, uncaptured-error observer, and shared error-attribution gate; install no second health authority.",
        "Acquire the attribution gate before backend operations capable of publishing attributable WGPU errors, following the accepted G4 lock order.",
        "Convert terminal health facts into execution/readback failures without choosing product recovery or G7 reconstruction policy.",
        "A lost/unavailable device rejects new preparation/submission before backend access and terminalizes unresolved accepted records exactly once where completion can no longer be proven.",
    ],

    retirement_contract: [
        "Each accepted submission retains Arc/owned references to every G4 realization and G5 staging record required until safe backend completion.",
        "Logical last-handle drop only makes a registry record reclaimable; it cannot destroy a record still retained by an accepted submission/readback.",
        "Submission completion may release execution-only records, but readback-dependent staging/realizations remain until mapping/result materialization no longer needs them.",
        "Deferred-retirement records are bounded by GpuExecutionLimits and contribute structured pressure rather than silent unbounded growth.",
        "Retirement publishes no external callback while realization/execution registries are locked.",
    ],

    shutdown_contract: [
        "Execution state is Running, ShuttingDown, or Closed with one atomic/serialized authority.",
        "begin_shutdown is idempotent, atomically prevents new preparation/submission admission, and does not invent cancellation for already accepted work.",
        "progress remains valid while ShuttingDown and drives backend completion, readback terminalization, and retirement.",
        "Closed requires all accepted records/readbacks terminal plus private retirement complete, or a terminal context/device failure that structurally failed unresolved records and made backend release safe.",
        "No background task, callback, mapped range, Device, Queue, realization or staging record retains implicit immortal authority after Closed.",
        "Runenwerk may implement a blocking shutdown terminal by driving the portable state machine; RunenGPU G5B does not own product timeout/yield policy.",
    ],

    lock_order: [
        "Preserve the accepted shared WGPU error-attribution gate as the outer backend-attribution lock.",
        "Preparation obtains G4 realization records before inserting G5 prepared/submission lifecycle records; no G5 lifecycle lock may be held while acquiring G4 registry locks in an inverse path.",
        "Encoding operates on already-retained private records and does not look up renderer-owned authority under encoder locks.",
        "Completion/map callbacks mutate only one matching G5 record under its registry lock, move any notification data out, release locks, then notify observers.",
        "One compare/guarded transition publishes terminal submission/readback state; duplicate callbacks are ignored/reported as invariant evidence without duplicate terminal publication.",
        "Shutdown uses the same registries/state transitions rather than a separate cleanup lock hierarchy.",
        "Implementation must document the exact concrete mutex/registry order after source decomposition and source-guard against an inversion.",
    ],

    observation_contract: [
        "GpuSubmission observation exposes identity, affinity, try_outcome, bounded diagnostics and readback lookup; it exposes no backend synchronization object.",
        "GpuReadback observation exposes identity, parent submission identity, try_result and bounded diagnostics; it exposes no mapped range/staging object.",
        "Dropping either observation handle never discards accepted internal lifecycle records before safe terminalization/retirement.",
        "If async Future adapters are implemented, they are library-owned wrappers over the same state with caller-owned executor/progress and no mandatory runtime dependency in the public contract.",
    ],

    independent_consumer_proof: [
        "Add one non-render compute consumer using complete G5A compute work, GpuContext preparation, bounded submit, progress, submission outcome, and Readback without invoking RunenRender or current-render bridges.",
        "Use a deterministic output vector and compare exact normalized CPU bytes/decoded values.",
        "The proof must exercise the public/typed execution path and may not reach through to WGPU Device, Queue, CommandEncoder, pipeline, bind group, map, poll, or submission-index APIs.",
        "Adapter absence is an explicit environment-dependent skip/unavailable result and cannot be reported as successful hardware execution.",
    ],

    migration_rules: [
        "Introduce G5 execution owners under engine/src/plugins/gpu before migrating any renderer consumer.",
        "The independent non-render proof is the first live consumer; existing renderer may temporarily remain on CurrentRenderDeviceQueue/CurrentRenderExecutionBridge until G5C.",
        "No second public execution API or compatibility alias may be created for renderer migration.",
        "Use accepted G5A GpuWorkOperation/GpuPreparedWorkGraph directly; do not introduce another command graph or permanent sidecar.",
        "Do not widen the current render bridges to support G5B; G5B accesses private G4 realization records through owner-local backend modules.",
    ],

    deterministic_tests: [
        "Preparation is transactional and rejects foreign/stale generation, invalid binding device facts, impossible transfer staging, and unavailable/lost context before submission.",
        "Successful preparation allocates no submission identity and dropping it publishes no terminal submission outcome.",
        "Submit pressure allocates no submission identity and returns the same retryable prepared semantics.",
        "Submission IDs are nonzero/monotonic within generation and never reused within one live generation.",
        "Each accepted submission terminalizes exactly once under duplicate/out-of-order completion callbacks.",
        "Submission completion and readback completion remain separately observable.",
        "Each accepted readback terminalizes exactly once and texture padding normalization is deterministic.",
        "Upload/readback byte/count limits and submission/retirement/terminal-record limits reject structurally at exact boundaries.",
        "Dropped observers do not alter execution/readback terminal state or leak bounded records.",
        "Shutdown rejects new work, keeps progress valid, drains/fails accepted records deterministically, and reaches Closed only after safe retirement.",
        "Lost/unavailable health facts terminalize exactly the affected generation without invoking product recovery.",
        "No callback/waker executes while internal locks are held and lock-order tests/source guards cover the concrete registry order.",
        "Independent compute submission/readback uses no renderer dependency and exact output is deterministic when a device is available.",
    ],

    environment_dependent_tests: [
        "Real WGPU headless compute prepare/submit/progress/readback proof on an available adapter.",
        "Environment evidence reports adapter/backend absence separately from a successful device path.",
        "Native progress proof demonstrates completion can be driven through the RunenGPU progress terminal without public WGPU polling.",
        "Where a WebGPU CI/runtime is available later, prove the same public state machine without relying on Device::poll; absence of such CI does not authorize native-only public semantics.",
    ],

    source_guards: [
        "No public WGPU Device, Queue, CommandEncoder, CommandBuffer, SubmissionIndex, PollType, BufferSlice, MapMode, mapped range, fence/semaphore/native handle, pipeline, bind group, or callback escape in RunenGPU contracts.",
        "Exactly one G5 submission/progress/completion/readback authority exists under engine/src/plugins/gpu.",
        "No permanent execution sidecar or second work graph appears.",
        "No second WGPU health/loss/error-attribution observer appears.",
        "No G5B source depends on RunenRender, ECS, UI, Winit, product/application, shader-file discovery, or surface policy.",
        "Current render bridges are not widened or made public while they await G5C deletion.",
    ],

    stop_conditions: [
        "No renderer/UI/timing/capture final migration or bridge deletion in this slice except corrections strictly required to keep accepted G5A/G5B contracts coherent; G5C owns final cutover.",
        "No G7 surface acquisition/presentation/reconstruction or device replacement policy.",
        "No implicit executor/thread pool/background progress service, universal blocking wait, second backend, multi-queue scheduler, graph optimizer, pass fusion, public raw backend handle, stable persisted execution record, or broad import API.",
        "Stop for a new design decision if WGPU 27 requires a public semantic that cannot be represented by the accepted G5 progress/submission/readback model or if safe retirement cannot be bounded without changing G4 realization ownership.",
    ],

    validation: [
        "Focused preparation/submission/progress/pressure/readback/shutdown/retirement tests and source guards.",
        "Independent non-render exact compute/readback proof when an adapter is available.",
        "Complete raw-WGPU execution owner and health-observer census.",
        "cargo validate",
        "git diff --check",
        "CI=true pnpm --dir docs-site build",
        "Exact-head CI and Documentation Build must succeed before acceptance.",
    ],

    acceptance: [
        "One complete bounded RunenGPU execution lifecycle exists for all accepted G5A operations without renderer dependency.",
        "Every accepted submission and readback has exactly one terminal semantic result and all staging/retirement is bounded.",
        "Portable progress owns no public backend synchronization type or mandatory executor.",
        "Independent non-render proof uses only RunenGPU public/typed contracts.",
        "Current renderer remains the only explicitly temporary G5C migration consumer and the two accepted G4 execution seams have not been widened.",
        "Accepted-main validation must pass before activating G5C.",
    ],
)
