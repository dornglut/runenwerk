// Decision-complete implementation specification for RunenGPU G5B.
// G5B starts only after accepted G5A and an explicitly activated child issue.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G5B",
    title: "Execution, Progress, Completion, Transfer, and Retention Lifecycle",
    lifecycle_state: "planned-blocked",
    implementation_authorization_status: "blocked-until-accepted-g5a-and-explicit-g5b-issue",
    owner: "RunenGPU execution lifecycle owner",
    source_baseline: "accepted-g5a-merge-to-be-recorded-by-g5b-issue",
    planning_issue: "dornglut/runenwerk#284",
    implementation_issue: "pending-after-accepted-g5a",
    parent_issue: "dornglut/runenwerk#167",
    blocking_predecessor: "PT-RUNENGPU-G5A",
    successor: "PT-RUNENGPU-G5C",
    target_repository_after_internal_conformance: "dornglut/runen-gpu",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "docs-site/src/content/docs/architecture/repository-family-architecture.md",
        "docs-site/src/content/docs/adr/accepted/0015-separate-gpu-execution-from-rendering.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runengpu-g5-execution-lifecycle-design.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-g5-execution-lifecycle-investigation.md",
        "docs-site/src/content/docs/reports/investigations/2026-08-14-runengpu-g5-critical-review.md",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g5a-executable-work-contracts.ron",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
    ],

    goal: "Create one context/device-generation-bound RunenGPU execution lifecycle from accepted complete G5A work through capacity-bounded cancellation-safe asynchronous preparation, atomic prepared-to-in-flight submit admission, private WGPU encoding/submission, host-driven progress, exactly-once terminal outcomes, upload/readback staging, normalized asynchronous readback results, health integration, shutdown, terminal-record detachment, and submission-aware retention of accepted G4 realizations; prove the surface-independent boundary with an independent non-render consumer while leaving current-host SurfaceAcquired attachment/copy/present binding and renderer cutover to G5C.",

    dependency_direction: [
        "Accepted G5A GpuPreparedWorkGraph plus accepted G4 realization owners -> G5B private execution preparation.",
        "GpuPreparedSubmission -> bounded GpuContext submit admission -> private WGPU encoding and Queue submission for surface-independent work.",
        "Private backend completion/mapping callbacks -> one RunenGPU completion registry -> normalized GpuSubmission/GpuReadback outcomes.",
        "Logical SurfaceAcquired attachment/copy/present requirements remain typed unresolved current-host requirements in G5B; physical surface acquisition/binding/present stays outside the reusable G5 core and is integrated privately by G5C under the existing pre-G7 host owner.",
        "G5C later migrates RunenRender/UI consumers to this accepted authority and deletes temporary raw execution seams.",
    ],

    execution_limits: [
        "Introduce finite validated GpuExecutionLimits before G5B preparation can publish work.",
        "Limits include max_prepared_submissions, max_in_flight_submissions, max_upload_bytes_in_flight, max_readback_bytes_in_flight, and max_pending_readbacks.",
        "max_prepared_submissions counts active asynchronous prepare reservations plus published GpuPreparedSubmission values; waiting on G4 realization cannot bypass the bound.",
        "Prepared capacity is distinct from in-flight capacity because both an active prepare and a published prepared value may retain G4 realization records before queue admission.",
        "Do not add a second G5 realization-retirement record budget: accepted G4 registries already bound authoritative records and collect lookup-only Arc records, while G5 in-flight/readback state retains exactly the live Arcs and staging objects needed for safety.",
        "No context-wide retained-terminal-history budget is required: after terminal publication and backend cleanup become safe, the context detaches its registry reference and caller-held observation Arcs own final results independently of future execution capacity.",
        "Defaults are finite and conservative; every limit is validated and reported as normalized execution policy rather than backend hardware identity.",
    ],

    preparation_contract: [
        "Provide one asynchronous GpuContext preparation terminal for complete accepted G5A work; convenience overloads must converge on this authority.",
        "Reserve exactly one max_prepared_submissions slot before asynchronous realization through an internal RAII token; that slot remains occupied from prepare start through publication/drop or successful submit conversion.",
        "Ordinary failure, future cancellation/drop, panic-unwind-safe Drop where applicable, shutdown/stale-generation rejection, or abandoned owned G4 single-flight realization releases owned reservations without publishing a prepared value.",
        "Preparation validates Running state, exact context/device generation, complete graph shape, operation-derived accesses/requirements, runtime binding device facts, transfer/readback bounds, and required logical SurfaceAcquired roles before backend encoding.",
        "Preparation realizes every ordinary referenced resource/program/layout/bind-group/pipeline only through accepted G4 owners and retains exact Arc realization records needed for execution.",
        "SurfaceAcquired attachment/copy/present resources are not realized through G4C1; preparation records only their exact logical identity/descriptor/allowed role/current-host binding requirement and no raw Surface, SurfaceTexture, Texture, or TextureView.",
        "Preparation plans upload/readback staging size and strategy within configured limits but does not submit queue work; physical staging allocation is transactional after submit admission unless a backend constraint proves earlier allocation necessary while preserving the same bounded ownership.",
        "Preparation publishes no partial prepared value on semantic, realization, pressure, stale-generation, unavailable-device, staging-plan, surface-requirement, or cancellation failure.",
    ],

    prepared_submission_contract: [
        "GpuPreparedSubmission is opaque, immutable after publication, context/device-generation-bound, process-local, and single-use after successful submit.",
        "A live prepared value owns the same prepared-capacity slot reserved at prepare start and releases it on drop or atomically converts it to in-flight ownership on successful submit.",
        "It may expose normalized graph/diagnostic/estimated-pressure facts but never WGPU command buffers, pipelines, bind groups, resources, mapped ranges, surfaces, or submission indices.",
        "Its private realized/encoding records are derived non-authoritative state reconstructable from accepted logical contracts while the generation remains valid.",
        "If the graph needs SurfaceAcquired attachment/copy/present roles, the prepared value retains only typed unresolved current-host binding requirements for G5C integration.",
        "Dropping a prepared submission creates no submission identity and is not reported as cancellation of accepted GPU work.",
        "A pre-acceptance submit rejection returns or preserves the prepared value with its prepared-capacity slot intact when retry remains meaningful.",
    ],

    submission_identity: [
        "GpuSubmissionId is opaque, nonzero, monotonically allocated within one live context/device generation, and process-local only.",
        "Allocate no GpuSubmissionId before bounded submit admission succeeds and every required synchronous surface-independent execution input is available.",
        "GpuSubmissionId is correlation identity only and is not persistence, replay, wire, cache, hardware, WGPU SubmissionIndex, Vulkan fence, D3D12 fence, or Metal event identity.",
        "Once GpuSubmissionId is allocated or published, the submission is accepted and every later encoding, backend validation, queue, health, or device failure terminalizes that exact record once rather than rolling acceptance back.",
        "One accepted submission record owns exactly one terminal GpuSubmissionOutcome publication.",
    ],

    submit_admission: [
        "submit_prepared performs one atomic logical transition from prepared-capacity ownership to in-flight/staging ownership only after every synchronous admission check succeeds.",
        "Reject stale generation, non-Running context, already-consumed prepared state, in-flight pressure, upload/readback staging pressure, and incompatible execution state before queue submission.",
        "Ordinary reusable submit_prepared rejects a prepared value carrying unresolved SurfaceAcquired attachment/copy/present requirements with typed SurfaceBindingRequired, allocates no submission ID, and preserves the prepared value.",
        "Pressure or SurfaceBindingRequired rejection performs no queue operation, allocates no submission ID, consumes no in-flight slot, mutates no logical resource authority, and preserves the same prepared semantics/slot.",
        "Successful surface-independent admission allocates GpuSubmissionId, reserves required in-flight/upload/readback capacity transactionally, releases the prepared slot as part of the same transition, then begins private physical encoding/submission.",
        "After successful admission, any failure before or after backend Queue::submit is terminal GpuSubmissionFailure for the allocated ID; accepted work is never silently discarded even if all caller observation handles are dropped.",
        "No hidden accepted-but-unsubmitted queue or unbounded retry loop is permitted.",
    ],

    private_encoding: [
        "G5B owns the sole new private lowering from prepared surface-independent operations to WGPU command encoding.",
        "Encode Compute through G4C3 realized compute pipeline, G4C2 realized bindings, exact dispatch, and no consumer-provided raw callback.",
        "Encode Render through ordinary realized attachments, ordered GpuRenderDraw state, G4C3 realized render pipelines, realized bind groups, vertex/index/indirect buffers, dynamic state, draw intent, and timestamp writes.",
        "Encode accepted Copy, BufferZero, QueryResolve, Upload, and Readback operations in prepared graph order when all referenced resources are ordinarily realized.",
        "Upload may privately lower to queue write only when provably ordering-equivalent; otherwise use bounded private staging plus encoded copy.",
        "Readback keeps staging/mapping objects private and encodes its observation copy at the exact logical operation position.",
        "GpuPresentOperation is not a WGPU command-encoder operation. G5B records its logical ordering/current-host requirement but performs no physical surface action.",
        "G5B does not acquire/configure/bind/present SurfaceAcquired resources or lend a raw acquired TextureView; G5C owns the narrow existing-current-host integration required before G7.",
        "No RunenRender/consumer module creates a new G5B CommandEncoder, Queue submission, or raw backend execution callback for consumers migrated to G5B.",
    ],

    submission_outcomes: [
        "Public semantic submission state is Submitted followed by exactly one terminal Completed or Failed outcome; backend-specific physical-start state is not promised.",
        "GpuSubmissionFailure structurally distinguishes context/device unavailable-or-lost, attributed backend execution/validation failure, backend encoding/submission failure after acceptance, forced shutdown terminalization, and invariant failure.",
        "Backend text remains bounded diagnostic evidence only and never determines identity or error category.",
        "Already-accepted GPU work is never advertised as physically cancellable; observer drop or product disinterest is not a fake Cancelled execution outcome.",
    ],

    progress_contract: [
        "Provide nonblocking GpuContext::progress as the portable execution-maintenance terminal.",
        "GpuProgressReport is bounded normalized evidence covering completed/failed submissions, advanced/ready/failed readbacks, released prepared/in-flight/staging pressure, released realization references, and terminal health facts without exposing backend poll/fence values.",
        "On native WGPU, progress may privately invoke nonblocking device/instance polling as required by the pinned backend.",
        "On WebGPU, browser/event-loop progress remains external; progress drains/publishes callback state and must not depend on WGPU Device::poll having effect.",
        "RunenGPU owns no mandatory Tokio/Futures executor, thread pool, or implicit immortal native progress thread in G5B.",
        "Any callback/future observation adapter uses the same completion registry, does not transfer progress ownership, invokes observers outside locks, and bounds stored observer/waker state per live observation record.",
        "A universal blocking wait is not part of the future-transferable baseline; Runenwerk host/CLI policy may drive progress according to product needs.",
    ],

    pressure_contract: [
        "GpuPressure contains typed kind, current occupancy, requested increment, limit, and corrective action.",
        "Active/published prepared count, in-flight submission count, upload bytes, readback bytes, and pending readback count are distinguishable.",
        "Prepared pressure fails prepare admission before asynchronous work begins; in-flight/staging pressure rejects submit while preserving the prepared value.",
        "G4 resource/program/pipeline record pressure remains G4 realization pressure and is not duplicated as a G5 retirement-pressure category.",
        "Pressure never becomes silent eviction, dropped work, unbounded allocation, sleep, implicit blocking, device-loss error, or generic validation failure.",
        "Completion/progress releases occupancy monotonically when staging/lifecycle records become safe and reports relieved pressure without invoking caller callbacks under locks.",
        "Caller retention of an already-terminal GpuSubmission/GpuReadback observation result does not consume context execution pressure once the internal record is detached after safe cleanup.",
    ],

    readback_contract: [
        "Each accepted GpuReadbackId produces exactly one submission-owned observation record.",
        "Public readback state is Pending followed by exactly one terminal Ready(GpuReadbackBytes) or Failed(GpuReadbackFailure).",
        "Submission GPU completion and readback terminal completion are separate facts; a submission may be Completed while readback mapping/normalization remains Pending.",
        "Private readback staging buffers are allocated within configured byte/count pressure and retain exact context/device generation.",
        "Map callbacks publish only into the matching generation-bound readback record and cannot publish twice, after incompatible terminal state, or into another submission.",
        "Mapped WGPU ranges never escape; copy/normalize bytes into immutable GpuReadbackBytes, unmap, and release private staging when safe.",
        "Normalize texture result data to tight logical rows and preserve logical texture format/provenance rather than exposing backend row padding.",
        "Parent submission failure terminalizes dependent readbacks structurally when their result can no longer be produced; observer drop does not leak, cancel cleanup, or retain context pressure after safe terminal detachment.",
    ],

    upload_contract: [
        "Account private upload staging lifetime until backend execution no longer requires it, not merely until the API call returns.",
        "Queue-write and encoded staging-copy paths share one logical Upload operation and one pressure account.",
        "Physical lowering may differ by operation position/size/backend but cannot change logical ordering, destination contents, initialization facts, or failure classification.",
        "No raw queue-write handle or staging buffer becomes public or renderer-owned authority.",
    ],

    terminal_record_detachment: [
        "The context registry owns nonterminal and backend-cleanup-pending submission/readback records only as long as execution safety requires.",
        "After terminal immutable result publication and safe private staging/realization-reference release, detach the context registry reference.",
        "Caller-held GpuSubmission/GpuReadback observation handles may retain immutable terminal result Arcs indefinitely without consuming prepared/in-flight/readback/upload capacity.",
        "If all observation handles were dropped before terminalization, the context still retains the internal record until exactly-once terminalization and cleanup, then discards it rather than creating hidden terminal history.",
        "Diagnostics/history beyond live observation handles belongs to separately bounded diagnostics/capture policy if later required.",
    ],

    health_integration: [
        "Reuse the accepted single WGPU device-loss observer, uncaptured-error observer, and shared error-attribution gate; install no second health authority.",
        "Acquire the attribution gate before backend operations capable of publishing attributable WGPU errors, following the accepted G4 lock order.",
        "Convert terminal health facts into execution/readback failures without choosing product recovery or G7 reconstruction policy.",
        "A lost/unavailable device rejects new preparation/submission before backend access and terminalizes unresolved accepted records exactly once where completion can no longer be proven.",
    ],

    realization_retention_contract: [
        "Each active prepare, prepared value, accepted submission, and readback retains only the accepted G4 realization Arc records required by its current lifecycle phase.",
        "Accepted G4 resource/program/pipeline registries remain the sole realization lookup/capacity authority; they already collect lookup-only records and never evict records retained by live Arc handles.",
        "G5B introduces no second resource/program/pipeline retirement registry, duplicate realization identity, or max_deferred_retirement_records counter.",
        "Logical last-handle drop only makes a G4 registry record reclaimable; it cannot destroy a record still retained by a G5 lifecycle record.",
        "Submission completion releases execution-only G4 Arcs when safe; readback-dependent G4/staging references remain only until mapping/result materialization no longer needs them.",
        "Private G5 staging objects are owned by the in-flight/readback lifecycle records that use them and are dropped when safe under upload/readback/count limits.",
        "Releasing realization/staging references and terminal-record detachment invokes no external callback while G4/G5 registries are locked.",
    ],

    shutdown_contract: [
        "Execution state is Running, ShuttingDown, or Closed with one atomic/serialized authority.",
        "begin_shutdown is idempotent, atomically prevents new prepare/submit admission, and does not invent cancellation for already accepted work.",
        "An in-progress asynchronous prepare observes shutdown/stale generation before publication; cancellation/drop releases its RAII prepared-slot reservation and any owner reservation it controls.",
        "Live prepared-but-unsubmitted values become non-submittable after shutdown begins; dropping them releases prepared slots and fabricates no submission outcome.",
        "progress remains valid while ShuttingDown and drives backend completion, readback terminalization, record detachment, staging release, and G4 Arc release.",
        "Closed requires all accepted work/readbacks terminal plus private staging cleanup complete, or a terminal context/device failure that structurally failed unresolved records and made release safe.",
        "No background task, callback, mapped range, Device, Queue, realization, staging record, or active prepare reservation retains implicit immortal G5 authority after Closed.",
        "Runenwerk may implement a blocking shutdown terminal by driving the portable state machine; RunenGPU does not own product timeout/yield policy.",
    ],

    lock_order: [
        "Preserve the accepted shared WGPU error-attribution gate as the outer backend-attribution lock.",
        "Preparation obtains G4 realization records before inserting published G5 prepared/submission lifecycle records; no inverse lifecycle-lock -> G4-registry acquisition path is allowed.",
        "Prepared-slot reservation is an independent RAII capacity token and its Drop path must not acquire G4 locks after a G5 lifecycle lock in inverse order.",
        "Encoding operates on already-retained private records and does not look up renderer-owned authority under encoder locks.",
        "Completion/map callbacks mutate only one matching G5 record under its registry lock, move notification/detachment data out, release locks, then notify observers or detach registry references.",
        "One guarded transition publishes terminal submission/readback state; duplicate callbacks are ignored or reported as invariant evidence without duplicate terminal publication.",
        "Shutdown uses the same registries/state transitions rather than a separate cleanup hierarchy.",
        "Implementation must document the exact concrete mutex/registry order after source decomposition and source-guard against inversion.",
    ],

    observation_contract: [
        "GpuSubmission exposes identity, affinity, try_outcome, bounded diagnostics and readback lookup; it exposes no backend synchronization object.",
        "GpuReadback exposes identity, parent submission identity, try_result and bounded diagnostics; it exposes no mapped range or staging object.",
        "Dropping either observation handle never discards accepted lifecycle records before safe terminalization/cleanup.",
        "Terminal observation handles retain detached immutable result state without occupying the context execution registry.",
        "If async Future adapters are implemented, they wrap the same state with caller-owned executor/progress and no mandatory runtime dependency in the public contract.",
    ],

    independent_consumer_proof: [
        "Add one non-render, surface-independent compute consumer using complete G5A compute work, GpuContext preparation, bounded submit, progress, submission outcome, and Readback without invoking RunenRender/current-render bridges.",
        "Use a deterministic output vector and compare exact normalized CPU bytes or decoded values.",
        "The proof must exercise public/typed execution and may not reach through to WGPU Device, Queue, CommandEncoder, pipeline, bind group, map, poll, surface, or submission-index APIs.",
        "Adapter absence is an explicit environment-dependent unavailable result and cannot be reported as successful hardware execution.",
    ],

    migration_rules: [
        "Introduce G5 execution owners under engine/src/plugins/gpu before migrating any renderer consumer.",
        "The independent non-render proof is the first live consumer; existing renderer may temporarily remain on CurrentRenderDeviceQueue/CurrentRenderExecutionBridge and current-host G7 migration boundary until G5C.",
        "No second public execution API or compatibility alias may be created for renderer migration.",
        "Use accepted G5A GpuWorkOperation/GpuPreparedWorkGraph directly; do not introduce another command graph or permanent sidecar.",
        "Do not widen current render bridges to support G5B; G5B accesses private G4 realization records through owner-local backend modules.",
    ],

    deterministic_tests: [
        "max_prepared_submissions counts active async prepare reservations plus published prepared values at the exact configured boundary.",
        "Cancelling an in-progress prepare or dropping a prepared value releases exactly one prepared slot and leaks no G4 owner reservation.",
        "Preparation rejects foreign/stale generation, invalid binding device facts, impossible transfer staging, unavailable/lost context, and invalid surface requirements before submission.",
        "Successful preparation allocates no submission identity and dropping it publishes no terminal submission outcome.",
        "Ordinary submit of a graph with unresolved SurfaceAcquired attachment/copy/present requirements returns SurfaceBindingRequired, allocates no ID, and preserves prepared work.",
        "Submit pressure allocates no submission identity, consumes no in-flight slot, and preserves retryable prepared semantics/slot.",
        "Successful submit atomically converts one prepared slot into one in-flight slot and allocates exactly one nonzero monotonic submission ID.",
        "Every failure after submission-ID allocation terminalizes that accepted ID exactly once rather than reverting admission.",
        "Each accepted submission and readback terminalizes exactly once under duplicate/out-of-order callbacks.",
        "Submission completion and readback completion remain separately observable and texture padding normalization is deterministic.",
        "Upload/readback byte/count and prepared/in-flight limits reject structurally at exact boundaries; G4 realization capacity remains separately classified.",
        "Releasing G5-held realization Arcs makes lookup-only G4 records collectible without a second retirement registry.",
        "Terminal records detach after safe cleanup; retaining terminal observation handles does not consume context execution capacity.",
        "Shutdown rejects new work, prevents in-progress prepare publication, invalidates prepared submit, keeps progress valid, resolves accepted records deterministically, and reaches Closed only after safe cleanup.",
        "Logical SurfaceAcquired requirements perform no WGPU surface acquisition/binding/presentation inside G5B.",
        "No callback or waker executes while internal locks are held and lock-order guards cover the concrete registry order.",
        "Independent compute submission/readback uses no renderer dependency and exact output is deterministic when a device is available.",
    ],

    environment_dependent_tests: [
        "Real WGPU headless compute prepare/submit/progress/readback proof on an available adapter.",
        "Environment evidence reports adapter/backend absence separately from a successful device path.",
        "Native progress proof demonstrates completion through RunenGPU progress without public WGPU polling.",
        "Where WebGPU CI/runtime becomes available, prove the same public state machine without relying on Device::poll; absence of that CI does not authorize native-only public semantics.",
    ],

    source_guards: [
        "No public WGPU Device, Queue, CommandEncoder, CommandBuffer, SubmissionIndex, PollType, BufferSlice, MapMode, mapped range, Surface, SurfaceTexture, acquired TextureView, fence/semaphore/native handle, pipeline, bind group, or callback escape in G5 contracts.",
        "Exactly one G5 submission/progress/completion/readback authority exists under engine/src/plugins/gpu.",
        "No permanent execution sidecar, second work graph, second realization-retirement registry, or context-owned unbounded terminal-history registry appears.",
        "No second WGPU health/loss/error-attribution observer appears.",
        "No G5B source depends on RunenRender, ECS, UI, Winit, product/application, shader-file discovery, or physical surface policy.",
        "Current render bridges are not widened or made public while they await G5C deletion.",
    ],

    stop_conditions: [
        "No renderer/UI/timing/capture final migration or bridge deletion in this slice except corrections strictly required to keep accepted G5A/G5B contracts coherent; G5C owns final cutover.",
        "No G7 reusable surface identity/generation/capability/acquisition/presentation/reconstruction or device replacement policy; G5B records only unresolved logical attachment/copy/present requirements.",
        "No implicit executor/thread pool/background progress service, universal blocking wait, second backend, multi-queue scheduler, graph optimizer, pass fusion, public raw backend handle, stable persisted execution record, unbounded terminal history, second retirement registry, or broad import API.",
        "Stop for a new design decision if WGPU 27 requires a public semantic not representable by the accepted progress/submission/readback model or if current renderer surface use cannot be satisfied by the narrow G5C current-host integration without implementing reusable G7 ownership.",
    ],

    validation: [
        "Focused preparation/submission/progress/pressure/readback/shutdown/realization-retention/terminal-detachment tests and source guards.",
        "Independent non-render exact compute/readback proof when an adapter is available.",
        "Complete raw-WGPU execution owner, unresolved-current-host-surface requirement, and health-observer census.",
        "cargo validate",
        "git diff --check",
        "CI=true pnpm --dir docs-site build",
        "Exact-head CI and Documentation Build must succeed before acceptance.",
    ],

    acceptance: [
        "One complete bounded surface-independent RunenGPU execution lifecycle exists for accepted G5A work without renderer dependency; logical SurfaceAcquired attachment/copy/present requirements remain typed and unresolved until G5C current-host integration.",
        "Active prepares and published prepared values share one finite prepared-capacity authority with cancellation-safe RAII release and atomic prepared-to-in-flight admission.",
        "Every accepted submission and readback has exactly one terminal semantic result and all private staging is bounded.",
        "G5 retains accepted G4 realizations through existing Arc records and introduces no duplicate realization-retirement authority.",
        "Terminal observation retention is detached from future context execution capacity after safe backend cleanup.",
        "Portable progress owns no public backend synchronization type or mandatory executor.",
        "Ordinary G5B submit performs no physical surface acquisition/binding/present and preserves SurfaceBindingRequired work for G5C.",
        "Independent non-render proof uses only RunenGPU public/typed contracts.",
        "Current renderer remains the only explicitly temporary G5C migration consumer and the two accepted G4 execution seams have not been widened.",
        "Accepted-main validation must pass before activating G5C.",
    ],
)