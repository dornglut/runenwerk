// Subordinate technical handoff for the first RunenECS boundary repair.
// Accepted Markdown owns durable architecture; GitHub issues own activation/current
// work state. Lifecycle/base/status strings in this retained RON are snapshots only.

PhaseImplementationSpec(
    phase_id: "PT-RUNENECS-R1",
    title: "Entity Identity and Structured Core Errors",
    lifecycle_state: "historical-handoff-snapshot",
    implementation_authorization_status: "not-authoritative-use-owning-github-issue",
    owner: "ECS core owner",

    authority_docs: [
        "ARCHITECTURE.md",
        "DEPENDENCY_RULES.md",
        "DOMAIN_MAP.md",
        "TESTING.md",
        "docs-site/src/content/docs/architecture/repository-family-architecture.md",
        "docs-site/src/content/docs/adr/accepted/0014-repository-family-extraction-boundaries.md",
        "docs-site/src/content/docs/reports/investigations/runenecs-issue-198-current-main-census.md",
        "docs-site/src/content/docs/design/accepted/runenecs-extraction-boundary-design.md",
        "docs-site/src/content/docs/design/accepted/runenecs-boundary-repair-execution-plan.md",
        "docs-site/src/content/docs/workspace/engineering-workflow.md",
        "docs-site/src/content/docs/workspace/specs/README.md",
        "docs-site/src/content/docs/guidelines/programming-principles.md",
    ],

    complete_investigation_gate_status: "Issue 198 checked-out current-main census completed for entity, allocator, world, public surface, consumers, and validation support; exact current GitHub issue/PR state remains authoritative",
    complete_design_gate_status: "C1/R1 target binds opaque WorldScopeId + slot/index + generation, structured stale/unknown/cross-world/double-free/exhaustion behavior, and runtime-only identity semantics; implementation remains unauthorized until an owning C1 issue exists",
    principle_compliance_status: "subordinate to the accepted RunenECS boundary design and canonical C0-C9 execution plan",
    module_decomposition_status: "C1/R1 covers entity/world-scope allocation and lifecycle plus directly related public errors and mechanical consumer migration only",
    maintainability_review_status: "C1/R1 must not absorb bundle, storage, query, reflection, messaging, spatial, scheduler, networking, replay, or application-lifecycle redesign",

    allowed_paths: [
        "domain/ecs/src/entity.rs",
        "domain/ecs/src/errors.rs",
        "domain/ecs/src/world/state.rs only for WorldScopeId ownership/construction",
        "domain/ecs/src/world/entity/lifecycle.rs only for scope-aware entity validation/lifecycle",
        "domain/ecs/src/world/entity_handles.rs only where the accepted entity representation requires it",
        "domain/ecs/src/lib.rs only for reviewed entity/error exports",
        "domain/ecs/src/prelude.rs only for reviewed entity/error exports",
        "domain/ecs/src/query/orphaned.rs only for mechanical migration required by Entity opacity",
        "domain/ecs/src/storage/dense/column.rs only for mechanical migration required by Entity opacity",
        "domain/ecs/src/storage/archetype/location.rs only for mechanical migration required by Entity opacity",
        "domain/ecs/src/storage/archetype/registry.rs only for mechanical migration required by Entity opacity",
        "domain/ecs/tests/** only for focused entity/world-scope/allocation/error tests or migration of compile failures caused directly by the C1 API",
        "current direct consumers identified by the accepted Issue 198 census only for mechanical migration to opaque Entity accessors, world-scope-aware construction, or structured C1 errors",
        "docs-site/src/content/docs/reports/proofs/pt-runenecs-r1-*.md only when a proof report is independently useful",
    ],

    forbidden_paths: [
        "bundle, command, storage architecture, query semantics, SystemParam, reflection, messaging, tick buffer, work queue, change journal, ownership policy, spatial semantics, scheduler, networking, replay, renderer, or app-lifecycle redesign",
        "package rename or external RunenECS repository population",
        "deleting or moving domain/ecs, domain/ecs_macros, or domain/scheduler",
        "compatibility Entity type, duplicate allocator, forwarding package, or deprecated parallel identity API",
        "stable persistence/network identity derived from Entity raw parts or WorldScopeId",
        "parallel executor work",
        "global reflection registry or telemetry work",
        ".github/**",
        "tools/**",
    ],

    public_api_surface: [
        "Entity becomes an opaque Copy/Eq/Hash/Ord world-local generational runtime handle whose representation includes an opaque process-local WorldScopeId plus slot/index and generation.",
        "Entity does not implement a safe forgeable constructor or Default that can manufacture an apparently valid runtime handle.",
        "Each World owns exactly one scope; its allocator emits only entities carrying that scope; world operations validate scope before slot/generation so equal local bits from another world cannot alias a live entity.",
        "WorldScopeId is runtime-only and is never serialized, persisted, transmitted, or promoted to universal/product/network identity.",
        "World-scope allocation never wraps or reuses a scope within the process lifetime; exhaustion must terminate/reject before reuse rather than create aliasing.",
        "Read-only diagnostic accessors may expose index/generation only if current consumers require them; they do not promise persistence or network stability.",
        "EntityAllocator allocation is fallible when entity slot/index space is exhausted.",
        "EntityAllocator free/despawn validation distinguishes foreign/unknown scope, unknown index, stale generation, and already-freed identity.",
        "Exhausted entity generations retire the slot permanently rather than saturating and reusing it.",
        "EntityError and allocator/world errors use structured variants where safe callers must branch on recoverable failure.",
    ],

    invariants: [
        "A live Entity identifies at most one live allocation in exactly one owning world scope.",
        "An Entity from another world is rejected before slot/generation lookup even when its slot and generation equal a live local entity.",
        "A stale or already-freed Entity cannot free or mutate a newer allocation.",
        "Freeing or mutating an invalid, foreign, stale, or already-freed Entity does not alter world or allocator state.",
        "World-scope, generation, and index exhaustion never cause identity reuse through saturation or wraparound.",
        "Entity raw parts and WorldScopeId are not stable persistence, replay, editor, or network identity.",
        "Public safe callers cannot forge arbitrary Entity values.",
        "Existing valid allocation/free/reuse behavior remains deterministic within a world.",
        "C1 changes no storage architecture, query, command, reflection, spatial, messaging, scheduler, or networking semantics.",
    ],

    acceptance_criteria: [
        "Entity fields, including world scope, slot/index, and generation, are private and there is no public Default/forging constructor.",
        "World owns a scope and allocator construction is scope-bound so worlds cannot accidentally share an entity namespace.",
        "World membership/lifecycle checks reject a foreign-world Entity even when local slot and generation coincide.",
        "EntityAllocator::allocate or its reviewed replacement reports entity index/slot exhaustion without wraparound.",
        "EntityAllocator::free or its reviewed replacement rejects foreign, unknown, stale, and already-freed entities without state mutation.",
        "A slot at generation exhaustion is retired and never returned again.",
        "World-scope allocation cannot wrap/reuse into a live or stale process-local scope.",
        "Tests cover two-world equal-slot/equal-generation separation, ordinary allocation, free/reuse, stale free after reuse, double free, unknown index, foreign world, generation exhaustion, index exhaustion, deterministic ordering/hash behavior within a world, and no state mutation on rejected operations.",
        "All direct field-construction/access consumers from the Issue 198 inventory migrate without adding a forging escape hatch or stable raw-ID semantics.",
        "No unrelated ECS subsystem enters the diff.",
        "Focused ECS tests and canonical workspace validation pass at the reviewed feature head.",
    ],

    validation_commands: [
        "git status --short --branch",
        "git rev-parse HEAD",
        "cargo metadata --format-version 1 --locked",
        "cargo tree -p ecs --locked",
        "cargo tree -i ecs --workspace --locked",
        "rg -n 'Entity\\s*\\{|\\.id\\b|\\.generation\\b|EntityAllocator|EntityError' domain engine net apps adapters --glob '*.rs'",
        "cargo test -p ecs --all-features --locked",
        "cargo clippy -p ecs -p ecs_macros --all-targets --all-features --locked -- -D warnings",
        "cargo validate",
        "git diff --check",
    ],

    evidence_expectations: [
        "Re-resolve current main and the owning C1 issue before code changes; this RON does not activate work.",
        "Report the complete accepted Entity construction/field/allocator/error consumer inventory and any drift discovered from current main.",
        "Report the old-to-new Entity/WorldScopeId/allocator API and representation map without exposing a stable raw identity contract.",
        "Report world/allocator state-transition proofs for every accepted and rejected operation.",
        "Report generation/index/world-scope exhaustion tests through reviewed private test seams rather than impractical full-space iteration.",
        "Report every consumer migration and why it does not introduce stable raw-ID semantics.",
        "Report focused and canonical validation separately; classify unavailable Miri/sanitizer/MSRV evidence honestly and do not invent a lane in C1 unless separately authorized.",
    ],

    stop_conditions: [
        "Stop if Entity values are intentionally persisted or serialized as stable external identity by an unclassified consumer.",
        "Stop if safe public custom Entity construction is a required supported contract.",
        "Stop if the accepted WorldScopeId + slot/index + generation model cannot provide cross-world rejection without redesigning unrelated ECS subsystems.",
        "Stop if C1 requires bundle, storage architecture, query, command, reflection, spatial, messaging, scheduler, networking, replay, or application-lifecycle redesign.",
        "Stop if current main materially changes C1 ownership, consumer closure, or validation assumptions.",
        "Stop if no owning accepted C1 GitHub issue authorizes implementation.",
    ],

    closeout_expectations: [
        "Record exact API changes, consumer migrations, world/allocator transition table, tests, validation, evidence classes, forbidden-scope proof, and known gaps in the owning PR/issue or an independently useful proof artifact.",
        "After accepted C1 merge, re-establish current authority before selecting C2; do not activate later work from this RON.",
        "Create or update a later workspace spec only if that concrete slice materially benefits from subordinate machine-readable handoff detail.",
    ],

    next_phase_activation_condition: "Non-authoritative snapshot: later work is selected and activated only through current accepted Markdown plus an owning GitHub issue; this field does not activate C2.",
)
