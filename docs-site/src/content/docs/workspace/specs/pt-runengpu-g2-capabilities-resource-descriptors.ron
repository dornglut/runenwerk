// Decision-complete implementation specification for the second internal RunenGPU boundary.
// Planning issue #168 changes no Rust. One later implementation issue owns this specification.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G2",
    title: "Normalized Capabilities, Logical Resources, Typed Handles, and Prepared GPU Data",
    lifecycle_state: "planned",
    implementation_authorization_status: "awaiting-owning-implementation-issue",
    owner: "RunenGPU contract owner",
    source_baseline: "d1dfd2518c988ed1ffa9ff40f2d6df5fe7f5a9b1",
    planning_issue: "dornglut/runenwerk#168",
    parent_issue: "dornglut/runenwerk#167",
    target_repository_after_internal_conformance: "dornglut/runen-gpu",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "DEPENDENCY_RULES.md",
        "DOMAIN_MAP.md",
        "docs-site/src/content/docs/adr/accepted/0015-separate-gpu-execution-from-rendering.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runenrender-internal-decomposition-execution-plan.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-render-s0-inventory.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-render-s0-file-disposition.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-render-s0-identity-consumer-lifecycle.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-industry-comparison.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-public-api-ergonomics-review.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-proof-workload-strategy.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-g2-capabilities-resources-investigation.md",
        "docs-site/src/content/docs/reports/closeouts/pt-runengpu-g1a-closeout.md",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
        "docs-site/src/content/docs/workspace/planning/active-work.md",
    ],

    goal: "Create future-transferable RunenGPU-owned capability, logical-resource, kind-typed-handle, prepared-data, descriptor-validation, and error contracts inside Runenwerk; migrate current G2 declaration authority to those contracts; split render and host semantics from generic GPU semantics; and delete replaced authority without implementing later phases or creating the external package.",

    dependency_direction: [
        "Runenwerk adapters and host policy -> RunenRender semantic image planning -> RunenGPU generic GPU execution -> WGPU backend",
        "Independent non-render consumers may lower directly into RunenGPU.",
        "New RunenGPU public contracts contain no Runenwerk, RunenRender, ECS, UI, SDF, Winit, application, product, or domain types.",
    ],

    phase_ownership: [
        "G2 owns normalized capability and requirement semantics, backend-neutral logical resource descriptions, kind-typed logical handles, prepared-data purpose distinctions, descriptor construction validation, current declaration migration, and deletion of replaced declaration authority.",
        "G3 owns access ranges and subresources, initialization-flow validation, hazards, immutable generic work, dependency inference, and the internal graph.",
        "G4 owns context/device admission execution, WGPU feature/limit/format mapping, shader/pipeline admission, validated binding keys, backend data layout, derive/macro realization, resource realization, and removal of the temporary RenderFlowId bridge.",
        "G5 owns automatic prepare/submit execution, uploads, full and partial updates, staging, completion, asynchronous readback, cancellation, delayed retirement, and headless proofs.",
        "G6 owns offscreen graphics and shared compute/render proof.",
        "G7 owns surfaces, generations, presentation, thread affinity, and device/surface outcomes.",
        "G8 owns final diagnostics, shutdown, conformance, and residual-authority audit.",
        "GX creates dornglut/runen-gpu only after G2-G8 are accepted.",
    ],

    target_module_layout: [
        "engine/src/plugins/gpu/mod.rs",
        "engine/src/plugins/gpu/api/mod.rs",
        "engine/src/plugins/gpu/api/work_resource_id.rs",
        "engine/src/plugins/gpu/api/capability.rs",
        "engine/src/plugins/gpu/api/resource.rs",
        "engine/src/plugins/gpu/api/handles.rs",
        "engine/src/plugins/gpu/api/data.rs",
        "engine/src/plugins/gpu/api/errors.rs",
        "engine/src/plugins/render/adapters/gpu_capabilities.rs as a temporary current-runtime adapter",
        "engine/src/plugins/render/adapters/gpu_data.rs as a temporary current-GpuParams adapter",
        "engine/src/plugins/render/adapters/gpu_resources.rs as a temporary render-target/history/surface adapter",
    ],

    module_rules: [
        "Do not create GpuPlugin, context, backend, WGPU, macro, capture, testing, facade, or external-package modules in G2.",
        "The three render adapters are Runenwerk integration seams and are not future RunenGPU source.",
        "Every new engine/src/plugins/gpu file must be future-transferable and independently pass source/import guards.",
        "One public package remains the target; no speculative package split is authorized.",
    ],

    capability_public_types: [
        "pub enum GpuCapabilityFeature { Compute, RenderPipeline, Copy, IndirectDraw, StorageTexture, DepthAttachment, TimestampQuery, Presentation }",
        "pub enum GpuPreferredFallback { ContinueWithoutFeature, DisableInstrumentation, SelectAlternativeWork }",
        "pub enum GpuCapabilityRequirement { Required(GpuCapabilityFeature), Preferred { feature: GpuCapabilityFeature, fallback: GpuPreferredFallback }, Disabled(GpuCapabilityFeature) }",
        "pub struct GpuCapabilityRequirements with a private deterministic map and fallible insert, merge, lookup, and iteration",
        "pub enum GpuCapabilityProfile { ComputeBaseline, OffscreenGraphicsBaseline, DesktopPresentationBaseline } whose requirements() method returns ordinary GpuCapabilityRequirements",
        "pub struct GpuCapabilities with private normalized feature, limit, and format facts and typed read-only queries",
        "pub struct GpuLimits { max_uniform_buffer_binding_size: u64, max_storage_buffer_binding_size: u64, max_color_attachments: u32, max_vertex_buffers: u32, max_bindings_per_group: u32 } with checked construction",
        "pub enum GpuTextureFormat { Rgba8Unorm, Rgba8UnormSrgb, Bgra8Unorm, Bgra8UnormSrgb, R32Uint, Depth32Float }",
        "pub struct GpuTextureFormatCapabilities with sampled, filterable, storage_read, storage_write, color_attachment, depth_stencil, copy_source, and copy_destination facts",
        "pub struct GpuCapabilityAdmission containing granted required facts, preferred availability/degradation facts, disabled verification, and deterministic diagnostics; G4 constructs backend admissions",
    ],

    capability_semantics: [
        "Required means admission fails when unavailable.",
        "Preferred means admission may continue only with the explicit fallback classification and a structured degradation fact.",
        "Disabled means admission fails if the feature or path would be enabled; it is a consumer constraint, not an unsupported-backend fact.",
        "An unmentioned feature is irrelevant; Optional is not a fourth state.",
        "Compatible requirement merging is commutative and deterministic.",
        "Required conflicts with Disabled.",
        "Preferred conflicts with Disabled unless the owning consumer removes the preference before merge.",
        "Two Preferred entries for one feature require the same fallback or fail as ambiguous.",
        "Profiles are recipes over one requirement authority and never override explicit entries silently.",
        "Backend/profile names and labels are diagnostics only.",
        "Subgroups, external interop, ray queries, ray pipelines, sparse resources, mesh shaders, video, multiple hardware queues, and universal shader IR are deferred.",
    ],

    resource_public_types: [
        "pub enum GpuResourceLifetime { Transient, Retained }",
        "pub enum GpuResourceOwnership { Owned, Imported, SurfaceAcquired }",
        "pub enum GpuReconstruction { SourceBacked, ExternallyReconstructed, NonReconstructable }",
        "pub enum GpuMemoryIntent { Device, Upload, Readback }",
        "pub enum GpuBufferUsage { Uniform, Storage, Vertex, Index, Indirect, CopySource, CopyDestination }",
        "pub struct GpuBufferUsages as a non-empty deterministic set with no raw backend bits",
        "pub enum GpuTextureUsage { Sampled, StorageRead, StorageWrite, ColorAttachment, DepthStencilAttachment, CopySource, CopyDestination }",
        "pub struct GpuTextureUsages as a non-empty deterministic set with no raw backend bits",
        "pub enum GpuTextureDimension { D1, D2, D3 }",
        "pub struct GpuTextureExtent with nonzero width, height, and depth_or_layers checked against dimension",
        "pub enum GpuTextureAspect { All, Color, DepthOnly, StencilOnly }",
        "pub struct GpuTextureSubresourceRange with checked mip and array-layer ranges and explicit aspect",
        "pub enum GpuAddressMode { ClampToEdge, Repeat, MirrorRepeat }",
        "pub enum GpuFilterMode { Nearest, Linear }",
        "pub enum GpuCompareFunction with normalized comparison meaning and no raw WGPU value",
        "pub enum GpuQueryKind { Timestamp }",
        "pub struct GpuResourceCommon { label, lifetime, ownership, memory_intent, reconstruction, provenance } with private fields and validated constructors",
        "pub struct GpuBufferDescriptor { common, size_bytes, usages, initialization }",
        "pub struct GpuTextureDescriptor { common, dimension, extent, mip_level_count, sample_count, format, usages, initialization }",
        "pub struct GpuTextureViewDescriptor { common, texture: GpuTextureHandle, optional compatible format override, dimension, subresources }",
        "pub struct GpuSamplerDescriptor { common, address modes, mag/min/mipmap filters, lod range, optional compare }",
        "pub struct GpuQuerySetDescriptor { common, kind, count }",
        "pub enum GpuResourceDescriptor { Buffer, Texture, TextureView, Sampler, QuerySet }",
        "pub enum GpuInitialization { Uninitialized, Zeroed, PreparedTransfer(PreparedGpuData<TransferData>) }",
        "pub struct GpuExportRelationship containing a typed handle, consumer-owned export key, required final access intent, and provenance",
    ],

    resource_semantics: [
        "Kind, lifetime, ownership, transfer/observation, reconstruction, and memory intent are independent dimensions.",
        "Imported, exported, readback, and surface-acquired are never lifetime variants.",
        "Readback is a G5 request/result over a buffer or texture relationship, not a G2 resource kind.",
        "Export is a relationship/final-state contract, not a kind or lifetime.",
        "SurfaceAcquired construction remains crate-private until G7 and is valid only for texture/view contracts with transient lifetime.",
        "Imported construction requires explicit external reconstruction ownership and provenance and cannot contain owned initial bytes.",
        "Owned retained NonReconstructable construction is explicit and emits device-loss risk evidence; no silent reconstruction claim is allowed.",
        "Memory intent is portable and exposes no heap, residency, memory-type, or backend allocation flag.",
        "Descriptors are immutable after successful construction.",
        "Labels are diagnostics and never identity, lookup, binding, or dependency authority.",
    ],

    handle_public_types: [
        "pub struct GpuBufferHandle",
        "pub struct GpuTextureHandle",
        "pub struct GpuTextureViewHandle",
        "pub struct GpuSamplerHandle",
        "pub struct GpuQuerySetHandle",
        "Each handle is a distinct non-Copy Clone type containing private logical ownership state and GpuWorkResourceId.",
        "Safe public code cannot construct a handle from a raw ID, change its kind, or reinterpret one handle kind as another.",
        "Read-only diagnostic identity access may expose GpuWorkResourceId without creating a stable serialization promise.",
        "G2 establishes clone/drop ownership shape and prohibits destroy-by-ID; G5 connects last-drop to delayed safe backend retirement.",
        "G4 introduces typed binding/layout views; G2 does not parameterize one buffer handle with one universal Rust representation.",
    ],

    prepared_data_public_types: [
        "sealed marker UniformData",
        "sealed marker StorageData",
        "sealed marker VertexData",
        "sealed marker IndirectData",
        "sealed marker TransferData",
        "pub struct GpuDataLayout { byte_len: u64, alignment: u64, stride: u64, element_count: u64 } with checked construction",
        "pub struct PreparedGpuData<Purpose> containing private immutable bytes, checked GpuDataLayout, provenance, optional process-local diagnostic type name, and a sealed purpose marker",
        "pub trait GpuDataEncoder<Purpose, Source> { fn prepare(&self, source: &Source) -> Result<PreparedGpuData<Purpose>, GpuDataPreparationError>; }",
        "pub struct GpuReadbackBytes with immutable normalized bytes and layout/format provenance; G5 constructs it",
        "pub trait GpuReadbackDecoder<Output> { fn decode(&self, bytes: &GpuReadbackBytes) -> Result<Output, GpuReadbackDecodeError>; }",
        "A narrowly named from_pod_transfer constructor may exist only for TransferData when Pod safety, alignment, byte length, and element count are explicit and tested.",
    ],

    prepared_data_semantics: [
        "GpuParams, GpuUniform, GpuStorage, ToGpuValue, and GpuUniformField remain transitional render-adapter mechanisms, not RunenGPU public traits.",
        "One Rust source type may have distinct uniform, storage, vertex, indirect, and transfer encoders.",
        "TypeId and type_name are process-local diagnostics or adapter lookup only; they are not layout, binding, persistence, replay, wire, cache, shader-interface, or cross-process authority.",
        "Alignment, padding, stride, byte length, and element count are checked metadata, not inferred from arbitrary Rust layout.",
        "Nested values are accepted only through an encoder that proves their flattened layout.",
        "Full and partial updates consume prepared data in G5; G2 performs no queue write or staging.",
        "Readback decoding is explicit and distinct from upload representation.",
        "G4 decides WGSL/WGPU layout, validated binding keys, derive behavior, macro packaging, and compile-time field support.",
        "No universal derive may assert one representation is valid for all GPU purposes.",
    ],

    descriptor_validation: [
        "All public constructors are fallible when caller input can be invalid.",
        "Labels are trimmed, non-empty, and carried into errors.",
        "Buffer size uses checked arithmetic and rejects zero, overflow, initial-data mismatch, and usage/memory contradictions.",
        "Texture extent, mip count, sample count, format/usages, aspect, and initialization are checked without consulting a backend.",
        "Texture views require GpuTextureHandle and validate subresources against source descriptor authority.",
        "Sampler LOD minimum cannot exceed maximum.",
        "Query count is nonzero; Timestamp is the only initial query kind.",
        "Imported and SurfaceAcquired constructors reject owned initial data.",
        "Readback memory intent requires CopyDestination and rejects contradictory claims.",
        "Upload staging intent requires CopySource; device resources with initial data require CopyDestination.",
        "No saturating size multiplication silently normalizes overflow.",
        "Descriptor equality and deterministic ordering exclude backend handles, process addresses, TypeId, and diagnostic type names.",
    ],

    error_contract: [
        "pub enum GpuCapabilityRequirementError",
        "pub enum GpuCapabilityAdmissionError",
        "pub enum GpuResourceDescriptorError",
        "pub enum GpuHandleError",
        "pub enum GpuDataPreparationError",
        "pub enum GpuReadbackDecodeError",
        "Every variant has typed fields for programmatic matching and Display text containing operation, human label, cause, and correction.",
        "Nested sources are preserved where applicable; callers do not match strings.",
        "No anyhow, boxed dynamic error, panic, unwrap, expect, silent fallback, saturating arithmetic, or opaque backend-only dump exists in the new public boundary.",
    ],

    api_examples: [
        "ordinary: let simulation = simulation.gpu_work(&gpu, &state)?; let rendering = renderer.gpu_work(&gpu, &scene, request)?; let submission = gpu.submit(\"frame 42\", [simulation, rendering])?;",
        "advanced: let prepared = gpu.prepare(\"frame 42\", [simulation, rendering])?; inspect(prepared.diagnostics()); let submission = gpu.submit_prepared(prepared)?;",
        "Ordinary submit validates automatically.",
        "Prepare and submit use the same authority as ordinary submit; no duplicate graph or validation path is allowed.",
        "G3 authoring uses lexical or closure scope, typed references, inferred data dependencies, and explicit order only for non-data constraints.",
        "Graph, epoch, admission, realization, and retirement vocabulary remains internal or advanced.",
    ],

    renderflow_disposition: [
        "RenderFlow remains transitional and is not copied, renamed, wrapped wholesale, or preserved as compatibility authority.",
        "GpuWorkResourceId and generic buffer/texture descriptor authority move to engine::plugins::gpu.",
        "Views, target aliases, color/depth target meaning, history, fullscreen/graphics/procedural image formation, and presentation intent remain RunenRender candidates.",
        "with_state, uniform_from_state, uniform_from_state_with_surface, dispatch_from_state, project_uniforms, fixed_step_region, windows/surfaces, built-in UI, capture/export, and recovery remain Runenwerk adapter/product authority.",
        "shader_asset paths remain Runenwerk source discovery/revision; G4 receives admitted source/interface keys.",
        "String resource/pass maps cease to be authority when typed references replace them.",
        "Broad depends_on calls are removed when G3 infers data order; only true non-data order remains explicit.",
        "Current explicit validate common-path ceremony is replaced by automatic submit validation; prepare remains inspectable.",
        "The temporary RenderFlowId owner bridge is removed through G3/G4.",
    ],

