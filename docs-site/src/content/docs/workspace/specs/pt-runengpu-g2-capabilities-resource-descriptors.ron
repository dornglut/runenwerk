        "engine/src/plugins/render/backend/execution.rs",
        "engine/src/plugins/render/backend/formats.rs",
        "engine/src/plugins/render/backend/pipeline_cache.rs",
        "engine/src/plugins/render/backend/resource_allocator.rs",
        "engine/src/plugins/render/backend/surface.rs",
        "engine/src/plugins/render/backend/wgpu_ctx.rs",
        "engine/src/plugins/render/renderer/render_flow/gpu_timing.rs",
        "engine/src/plugins/render/renderer/render_flow/runtime_resources.rs",
        "engine/src/plugins/render/renderer/render_flow/runtime_resources/inspect.rs",
        "engine/src/plugins/render/renderer/render_flow/runtime_resources/realize.rs",
        "engine/src/plugins/render/renderer/render_flow/runtime_resources/resolve.rs",
    ],

    direct_and_transitive_inventory: [
        "Direct graph/resource consumers: engine/src/plugins/render/api, graph, resource, procedural, renderer, runtime, and gpu_primitives files named in the G2 investigation report.",
        "Applications: apps/runenwerk_draw/src/runtime/app.rs, apps/runenwerk_draw/src/runtime/gpu_ink.rs, apps/runenwerk_editor/src/runtime/app.rs, and apps/runenwerk_editor/src/runtime/viewport/render_jobs.rs.",
        "Application tests: apps/runenwerk_draw/tests/app_shell.rs and the inventoried runenwerk_editor render/viewport tests.",
        "Examples: game_of_life_sdf, boids_render_flow, procedural_sky_sdf_terrain, render_flow_debug_inspect, render_flow_fullscreen_minimal, render_flow_postprocess_compositor, and sdf_render_flow.",
        "Tests and benchmarks: engine/benches/render_flow_planning.rs plus render_dynamic_targets, render_flow_v2, render_import_contract, render_resource_model, render_runtime_inspect, and procedural_instance.",
        "Diagnostics and artifacts: engine/src/plugins/render/inspect/** and engine/src/plugins/render/renderer/render_flow/capture.rs.",
        "The exact file-by-file inventory in runengpu-g2-capabilities-resources-investigation.md is binding and must be reverified against implementation main.",
    ],

    stable_format_findings: [
        "No current GpuWorkResourceId, resource handle, capability profile, descriptor, TypeId, or type name is accepted as persisted, replay, network, wire, cache, or cross-process authority.",
        "Capture identities/manifests are Runenwerk product formats and do not make GPU logical IDs stable.",
        "No stable-format stop condition is triggered at the planning baseline.",
    ],

    proof_categories: [
        "deterministic conformance",
        "boundary integration",
        "visual showcase",
        "benchmark or stress evidence",
        "The categories remain separate; no visually impressive demo replaces exact correctness evidence.",
    ],

