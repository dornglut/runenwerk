// Decision-complete implementation specification for the second internal RunenGPU boundary.
// This specification authorizes no Rust implementation by itself. The owning implementation
// issue must be accepted after the planning PR merges.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G2",
    title: "Normalized Capabilities, Logical Resource Descriptors, and Prepared GPU Data",
    lifecycle_state: "planned",
    implementation_authorization_status: "awaiting-owning-implementation-issue",
    owner: "RunenGPU contract owner",

    source_baseline: "d1dfd2518c988ed1ffa9ff40f2d6df5fe7f5a9b1",
    planning_issue: "dornglut/runenwerk#168",
    parent_issue: "dornglut/runenwerk#167",
    target_repository_after_internal-conformance: "dornglut/runen-gpu",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "DEPENDENCY_RULES.md",
        "DOMAIN_MAP.md",
        "docs-site/src/content/docs/adr/accepted/0015-separate-gpu-execution-from-rendering.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runenrender-internal-decomposition-execution-plan.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-render-s0-inventory.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-render-s0-file-disposition.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-render-s0-identity-consumer-lifecycle.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-industry-comparison.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-public-api-ergonomics-review.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-proof-workload-strategy.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-g2-capabilities-resources-investigation.md",
        "docs-site/src/content/docs/reports/closeouts/pt-runengpu-g1a-closeout.md",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
        "docs-site/src/content/docs/workspace/planning/active-work.md",
    ],

    goal: "Create the future-transferable RunenGPU-owned capability, logical resource, typed handle, prepared-data, descriptor-validation, and human-readable error contracts inside Runenwerk; migrate the current G2 declaration authority to those contracts; split render and Runenwerk semantics from generic GPU semantics; and delete the replaced authority without implementing devices, pipelines, hazards, execution, readback, surfaces, or the external package.",

    accepted_dependency_direction: [
        "Runenwerk adapters and host policy -> RunenRender semantic image planning -> RunenGPU generic GPU execution -> WGPU backend",
        "Non-render consumers may lower directly into RunenGPU work.",
        "RunenGPU public contracts do not depend on Runenwerk, RunenRender, ECS, UI, SDF, Winit, applications, products, or domain-specific types.",
    ],

    phase_boundary: [
        "G2 owns normalized capability and requirement semantics, backend-neutral logical resource descriptors, typed logical resource handles, prepared-data purpose distinctions, descriptor construction validation, current declaration migration, and deletion of replaced declaration authority.",
        "G3 owns resource access ranges and subresources, initialization and lifetime flow validation, hazard inference, immutable generic work fragments, dependency inference, and the internal work graph.",
        "G4 owns context/device admission execution, WGPU feature/limit/format mapping, shader and pipeline admission, validated binding keys, backend data layout, derive/macro realization, resource realization, and removal of the temporary RenderFlowId bridge.",
        "G5 owns submit/prepare execution, uploads, full and partial updates, staging, completion, asynchronous readback, cancellation, public-handle retirement, and headless compute proofs.",
        "G6 owns offscreen graphics and shared compute/render proof.",
        "G7 owns low-level surfaces, generations, presentation, thread affinity, and device/surface outcomes.",
        "G8 owns final diagnostics, shutdown, internal conformance, and residual anti-cheating audit.",
        "GX creates dornglut/runen-gpu only after G2-G8 are accepted and no duplicate internal authority remains.",
    ],

    target_module_layout: [
        "engine/src/plugins/gpu/mod.rs",
        "engine/src/plugins/gpu/api/mod.rs",
        "engine/src/plugins/gpu/api/work_resource_id.rs",
        "engine/src/plugins/gpu/api/capability.rs",
        "engine/src/plugins/gpu/api/resource.rs",
        "engine/src/plugins/gpu/api/handles.rs",
        "engine/src/plugins/gpu/api/data.rs",
        "engine/src/plugins/gpu/api/errors.rs",
        "engine/src/plugins/render/adapters/gpu_capabilities.rs for the temporary current-runtime capability fixture only",
        "engine/src/plugins/render/adapters/gpu_data.rs for current GpuParams-to-prepared-data translation only",
        "engine/src/plugins/render/adapters/gpu_resources.rs for render-target/history/surface intent lowering only",
    ],

    module_layout_rules: [
        "Do not create a GpuPlugin, context module, backend module, WGPU module, macro package, compatibility module, facade package, or external crate in G2.",
        "The three render adapter files are temporary Runenwerk integration seams, not future RunenGPU source. They may be named differently only when the owning implementation issue proves an already-existing coherent adapter module; their semantic placement is fixed.",
        "New RunenGPU files must be future-transferable and pass source/import guards independently of render modules.",
        "One public package remains the target; no speculative core/wgpu/macros/testing package split is authorized.",
    ],

    public_capability_types: [
        "pub enum GpuCapabilityFeature { Compute, RenderPipeline, Copy, IndirectDraw, StorageTexture, DepthAttachment, TimestampQuery, Presentation }",
        "pub enum GpuPreferredFallback { ContinueWithoutFeature, DisableInstrumentation, SelectAlternativeWork }",
        "pub enum GpuCapabilityRequirement { Required(GpuCapabilityFeature), Preferred { feature: GpuCapabilityFeature, fallback: GpuPreferredFallback }, Disabled(GpuCapabilityFeature) }",
        "pub struct GpuCapabilityRequirements: deterministic normalized map with fallible insertion, merge, lookup, and iteration; duplicate equal entries coalesce and conflicting entries fail.",
        "pub enum GpuCapabilityProfile { ComputeBaseline, OffscreenGraphicsBaseline, DesktopPresentationBaseline }; requirements() returns ordinary GpuCapabilityRequirements and profiles have no independent admission authority.",
        "pub struct GpuCapabilities with private normalized feature, limit, and format facts and read-only typed queries.",
        "pub struct GpuLimits { max_uniform_buffer_binding_size: u64, max_storage_buffer_binding_size: u64, max_color_attachments: u32, max_vertex_buffers: u32, max_bindings_per_group: u32 } with checked construction.",
        "pub enum GpuTextureFormat { Rgba8Unorm, Rgba8UnormSrgb, Bgra8Unorm, Bgra8UnormSrgb, R32Uint, Depth32Float } for formats proven by current resource/capture consumers; no catch-all raw WGPU variant.",
        "pub struct GpuTextureFormatCapabilities with sampled, filterable, storage_read, storage_write, color_attachment, depth_stencil, copy_source, and copy_destination facts.",
        "pub struct GpuCapabilityAdmission containing granted required facts, preferred availability/degradation facts, disabled verification, and deterministic diagnostics; G4 constructs backend admissions.",
    ],

    capability_semantics: [
        "An unmentioned feature is irrelevant; Optional is not a fourth requirement state.",
        "Required means context/work admission fails when unavailable.",
        "Preferred means admission may continue only with the explicitly declared fallback classification and a structured degradation fact.",
        "Disabled means admission fails when the feature or path would be enabled; it is a user/consumer constraint, not a backend unsupported fact.",
        "Requirement merging is commutative and deterministic for compatible entries.",
        "Required conflicts with Disabled.",
        "Preferred conflicts with Disabled unless the preferred entry is removed by the owning consumer before merge.",
        "Two Preferred entries for the same feature must name the same fallback or fail as ambiguous.",
        "Profiles are recipes and cannot override explicit requirements silently.",
        "Capability labels and backend names are diagnostics only.",
        "Subgroups, external-resource interop, ray queries, ray pipelines, sparse resources, mesh shaders, video, multiple hardware queues, and universal shader IR are absent from the initial stable vocabulary.",
    ],

    public_resource_types: [
        "pub enum GpuResourceLifetime { Transient, Retained }",
        "pub enum GpuResourceOwnership { Owned, Imported, SurfaceAcquired }",
        "pub enum GpuReconstruction { SourceBacked, ExternallyReconstructed, NonReconstructable }",
        "pub enum GpuMemoryIntent { Device, Upload, Readback }",
        "pub enum GpuBufferUsage { Uniform, Storage, Vertex, Index, Indirect, CopySource, CopyDestination }",
        "pub struct GpuBufferUsages: non-empty deterministic set with typed membership and no raw backend bits.",
        "pub enum GpuTextureUsage { Sampled, StorageRead, StorageWrite, ColorAttachment, DepthStencilAttachment, CopySource, CopyDestination }",
        "pub struct GpuTextureUsages: non-empty deterministic set with typed membership and no raw backend bits.",
        "pub enum GpuTextureDimension { D1, D2, D3 }",
        "pub struct GpuTextureExtent with nonzero width, height, and depth_or_layers validated against dimension.",
        "pub struct GpuTextureSubresourceRange with checked mip and array-layer ranges and an explicit aspect.",
        "pub enum GpuTextureAspect { All, Color, DepthOnly, StencilOnly } with invalid format/aspect combinations rejected.",
        "pub enum GpuAddressMode { ClampToEdge, Repeat, MirrorRepeat }",
        "pub enum GpuFilterMode { Nearest, Linear }",
        "pub enum GpuCompareFunction matching normalized comparison meaning without raw WGPU values.",
        "pub enum GpuQueryKind { Timestamp } because timestamp query is the only current query consumer.",
        "pub struct GpuResourceCommon { label, lifetime, ownership, memory_intent, reconstruction, provenance } with private fields and validated constructors.",
        "pub struct GpuBufferDescriptor { common, size_bytes, usages, initialization }",
        "pub struct GpuTextureDescriptor { common, dimension, extent, mip_level_count, sample_count, format, usages, initialization }",
        "pub struct GpuTextureViewDescriptor { common, texture: GpuTextureHandle, format override when valid, dimension, subresources }",
        "pub struct GpuSamplerDescriptor { common, address modes, mag/min/mipmap filters, lod range, optional compare }",
        "pub struct GpuQuerySetDescriptor { common, kind, count }",
        "pub enum GpuResourceDescriptor { Buffer, Texture, TextureView, Sampler, QuerySet }",
        "pub enum GpuInitialization { Uninitialized, Zeroed, PreparedTransfer(PreparedGpuData<TransferData>) }",
        "pub struct GpuExportRelationship identifying a typed resource handle, consumer-owned export key, required final access intent, and provenance; it is not a lifetime or resource kind.",
    ],

    resource_dimension_semantics: [
        "Kind, lifetime, ownership, transfer/observation, reconstruction, and memory intent are independent dimensions.",
        "Imported, exported, readback, and surface-acquired are never lifetime variants.",
        "Readback is a G5 request and result over a buffer or texture relationship, not a G2 resource kind.",
        "Export is a relationship and final-state contract, not a resource kind or lifetime.",
        "SurfaceAcquired construction remains crate-private until G7 and is valid only for texture/view contracts with transient lifetime.",
        "Imported construction requires explicit external reconstruction ownership and provenance; it cannot contain owned initial bytes.",
        "Owned retained NonReconstructable resources require an explicit constructor and produce a device-loss risk diagnostic; no silent reconstruction claim is allowed.",
        "Memory intent is a portable access hint and must not expose heap, residency, memory type, or backend allocation flags.",
        "A descriptor is immutable after successful construction.",
        "Strings are diagnostic labels, never identity, resource lookup, binding, or dependency authority.",
    ],

    public_handle_types: [
        "pub struct GpuBufferHandle",
        "pub struct GpuTextureHandle",
        "pub struct GpuTextureViewHandle",
        "pub struct GpuSamplerHandle",
        "pub struct GpuQuerySetHandle",
        "Each handle is a distinct non-Copy Clone type containing private logical ownership state and a GpuWorkResourceId.",
        "Safe public code cannot construct a handle from a raw ID, change its kind, or reinterpret one handle kind as another.",
        "Read-only diagnostic identity access may expose GpuWorkResourceId because G1A already defines it as an ephemeral logical identity; it does not expose stable serialization.",
        "G2 establishes clone/drop ownership shape and prohibits public destroy-by-ID. G5 connects last-handle drop to delayed backend retirement after relevant submissions complete.",
        "Typed buffer binding/layout views are G4 authority; G2 does not parameterize one buffer handle with a universal Rust data type.",
    ],

    public_prepared_data_types: [
        "sealed marker UniformData",
        "sealed marker StorageData",
        "sealed marker VertexData",
        "sealed marker IndirectData",
        "sealed marker TransferData",
        "pub struct GpuDataLayout { byte_len: u64, alignment: u64, stride: u64, element_count: u64 } with checked construction and no zero alignment/stride for non-empty data.",
        "pub struct PreparedGpuData<Purpose> with private immutable bytes, checked GpuDataLayout, source provenance, optional process-local diagnostic type name, and a sealed purpose marker.",
        "pub trait GpuDataEncoder<Purpose, Source> { fn prepare(&self, source: &Source) -> Result<PreparedGpuData<Purpose>, GpuDataPreparationError>; }",
        "pub struct GpuReadbackBytes with immutable normalized bytes and layout/format provenance; G5 constructs it.",
        "pub trait GpuReadbackDecoder<Output> { fn decode(&self, bytes: &GpuReadbackBytes) -> Result<Output, GpuReadbackDecodeError>; }",
        "No public safe constructor accepts arbitrary bytes as validated uniform, storage, vertex, or indirect data without an explicit encoder/evidence object.",
        "A narrowly named from_pod_transfer constructor may exist only for TransferData when Pod safety, byte length, alignment, and element count are explicit and tested; it does not imply uniform/storage/vertex/indirect validity.",
    ],

    typed_data_semantics: [
        "GpuParams, GpuUniform, GpuStorage, ToGpuValue, and GpuUniformField are current transitional render-adapter mechanisms, not new RunenGPU public traits.",
        "One Rust source type may have different encoders for uniform, storage, vertex, indirect, and transfer purposes.",
        "TypeId and type_name may be retained only as process-local diagnostics or adapter lookup evidence; they are not layout, binding, persistence, replay, wire, cache, shader-interface, or cross-process authority.",
        "Alignment, padding, stride, byte length, and element count are checked metadata, not inferred from arbitrary Rust layout.",
        "Nested values are accepted only through an encoder that proves their flattened layout.",
        "Full and partial updates consume prepared data in G5; G2 does not implement queue writes or staging.",
        "Readback decoding is explicit and separate from upload representation.",
        "G4 decides concrete WGSL/WGPU layout, validated binding keys, derive behavior, macro packaging, and compile-time field support.",
        "No universal derive or marker may assert that every Rust structure has one valid GPU representation.",
    ],

    descriptor_construction_contract: [
        "All public constructors are fallible when caller input can be invalid.",
        "Labels are trimmed and non-empty; labels are carried into every error and diagnostic.",
        "Buffer size is checked for zero, overflow, initial-data mismatch, usage/memory contradictions, and declared limit requirements.",
        "Texture extent, mip count, sample count, format/usages, aspect, and initialization are checked for internal consistency without consulting a backend.",
        "Texture view construction requires a GpuTextureHandle and validates the requested subresource range against the source texture descriptor authority.",
        "Sampler LOD min must not exceed max; compare sampling and filter claims remain explicit.",
        "Query count is nonzero and timestamp is the only initial query kind.",
        "Imported and SurfaceAcquired constructors reject owned initial data.",
        "Readback memory intent requires copy-destination use and rejects attachment/storage-write-only claims that cannot be observed through the declared relationship.",
        "Upload memory intent requires copy-source use when the resource itself is host-visible staging; ordinary device resources with initial data use Device memory intent plus copy-destination use.",
        "Arithmetic uses checked operations; no saturating size multiplication can silently normalize overflow.",
        "Descriptor equality and deterministic ordering exclude unstable backend handles and process addresses.",
    ],

    error_types: [
        "pub enum GpuCapabilityRequirementError",
        "pub enum GpuCapabilityAdmissionError",
        "pub enum GpuResourceDescriptorError",
        "pub enum GpuHandleError",
        "pub enum GpuDataPreparationError",
        "pub enum GpuReadbackDecodeError",
        "Every variant has typed fields sufficient for programmatic matching and a Display message with operation, human label, cause, and correction.",
        "Errors preserve nested sources where applicable and do not require matching strings.",
        "No anyhow, boxed dynamic error, panic, unwrap, expect, silent fallback, saturating arithmetic, or generic backend enum dump in the new public boundary.",
    ],

    error_examples: [
        "Cannot describe buffer 'boids.instances': 384 elements at stride 24 overflow the declared byte length. Correction: use checked element_count * stride and declare the resulting size.",
        "Cannot merge capability requirements for 'timestamp_query': one contributor disables the feature while another requires it. Correction: resolve the consumer policy before context admission.",
        "Cannot prepare uniform data 'camera': the encoder produced 60 bytes but declared a 64-byte aligned layout. Correction: include required padding or correct the layout evidence.",
        "Cannot create texture view 'history.current': mip range 2..4 exceeds texture 'history' with 3 mip levels. Correction: select a range within 0..3.",
    ],

    common_api_example: [
        "let simulation = simulation.gpu_work(&gpu, &state)?;",
        "let rendering = renderer.gpu_work(&gpu, &scene, request)?;",
        "let submission = gpu.submit(\"frame 42\", [simulation, rendering])?;",
        "Ordinary submit validates automatically and never requires an explicit validate call.",
    ],

    inspectable_api_example: [
        "let prepared = gpu.prepare(\"frame 42\", [simulation, rendering])?;",
        "inspect(prepared.diagnostics());",
        "let submission = gpu.submit_prepared(prepared)?;",
        "prepare and submit use the same authority as ordinary submit; no duplicate graph or validation path is permitted.",
    ],

    generic_authoring_pressure: [
        "Generic G3 work authoring uses lexical or closure scope and ordinary Result propagation.",
        "No repeated nested finish ladder is accepted as the target API.",
        "Resource references and future pipeline binding keys are typed.",
        "Data dependencies are inferred from declared accesses in G3.",
        "Explicit ordering is accepted only for real non-data dependencies.",
        "Graph, epoch, admission, realization, and retirement terminology remains internal or advanced; common code is not required to use it.",
    ],

    renderflow_disposition: [
        "RenderFlow remains transitional and is not copied, renamed, wrapped wholesale, or retained as compatibility authority.",
        "GpuWorkResourceId and generic buffer/texture descriptor authority move to engine::plugins::gpu.",
        "Render views, target aliases, color/depth target meaning, history meaning, fullscreen/graphics/procedural image-formation semantics, and presentation intent remain RunenRender candidates.",
        "with_state, uniform_from_state, uniform_from_state_with_surface, dispatch_from_state, project_uniforms, fixed_step_region, window/surface mapping, built-in UI, capture/export, and recovery remain Runenwerk adapter/product authority.",
        "shader_asset paths remain Runenwerk source discovery/revision; G4 receives admitted source/interface keys.",
        "String resource/pass maps are removed as authority when typed references replace them; labels remain diagnostics.",
        "Current broad depends_on calls are removed when G3 can infer data order; only non-data order remains explicit.",
        "Current validate common-path ceremony is replaced by automatic validation in submit; prepare remains inspectable.",
        "The temporary resource-owner bridge from RenderFlowId is removed through G3/G4, not preserved in the external package.",
    ],

