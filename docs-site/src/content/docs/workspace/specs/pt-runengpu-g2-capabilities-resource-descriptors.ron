    later_proof_bindings: [
        "G5 conditional texture proof uses deterministic integer compute output, Rgba8Unorm or R32Uint handling, texture-to-buffer copy, 256-byte row-padding normalization, total byte length, selected texels, and Runenwerk-owned PNG encoding.",
        "G6 known-pattern graphics conformance starts from the planning-only fullscreen example but creates a dedicated offscreen shader/test with clear, draw, readback, selected pixels, and documented tolerances.",
        "G6 GPU-driven composition reuses counter/scan/compaction/draw-args authority and infers compute-before-graphics through shared resource access.",
        "G6 boids uses engine/examples/boids_render_flow/rendering/graph.rs and boids shaders; acceptance is structural, finite, bounded, overflow-safe, and artifact-producing rather than exact cross-backend state/pixels.",
        "G7 reuses known-pattern and boids for presentation, resize, reconfiguration, generations, multi-surface where supported, thread affinity, and structured outcomes.",
        "First RunenRender proof is procedural_sky_sdf_terrain; later temporal/history proof is sdf_render_flow.",
    ],

    offline_output_boundary: [
        "Game of Life PNG sequence follows G5.",
        "Offscreen boids PNG sequence follows G6.",
        "Procedural sky/SDF/scene sequences follow matching RunenRender phases.",
        "Runenwerk owns output clock, seeds, job configuration, bounded in-flight readbacks, ordered filenames, manifests, retry/failure policy, PNG/EXR encoding, and external FFmpeg/codec integration.",
        "RunenGPU owns completion/readback facts; RunenRender owns image formation; neither owns MP4/WebM codecs.",
    ],

    alternative_classification: [
        "vector addition: tutorial only, too weak, no current reuse",
        "reduction: optional exact G5 extension",
        "histogram: optional exact integer/atomic G5 extension",
        "convolution and Sobel: optional texture integration",
        "Mandelbrot/Julia and reaction-diffusion: later showcase, not conformance",
        "N-body: deferred because boids has stronger current reuse",
        "fluids/smoke and FFT ocean: deferred stress or RunenRender work",
        "marching cubes and GPU procedural mesh generation: later domain-to-GPU/render integration",
        "SDF rendering: RunenRender semantic proof, not RunenGPU conformance",
        "path tracing: deferred advanced RunenRender work",
    ],

    allowed_paths: [
        "engine/src/plugins/gpu/** for G2 contracts, focused tests, and guards",
        "engine/src/plugins/render/adapters/** for the three bounded temporary adapters",
        "the inventoried render capability/resource/API/graph/procedural/renderer/runtime files for mechanical G2 migration only",
        "apps/runenwerk_draw/** and apps/runenwerk_editor/** only where compiler-backed facade migration requires it",
        "the inventoried examples, benchmark, and tests for compiler-backed migration and focused assertions",
        "docs-site proof/closeout, durable roadmap/decision-register, owning GitHub issue/portfolio, and spec lifecycle updates after evidence exists",
    ],

    forbidden_scope: [
        "Rust implementation during planning issue #168",
        "creation or population of dornglut/runen-gpu",
        "new workspace member, package, backend, facade, macro, capture, or testing package",
