// Decision-complete implementation specification for the first internal RunenGPU boundary.
// S0 investigation and ADR 0015 remain architectural authority.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G1A",
    title: "Owner-Scoped Logical GPU Work-Resource Identity",
    lifecycle_state: "completed",
    implementation_authorization_status: "implemented-and-merged",
    owner: "RunenGPU contract owner",

    source_baseline: "88e9de3c94145c39391550efaf82a341630f081a",

    authority_docs: [
        "ARCHITECTURE.md",
        "DEPENDENCY_RULES.md",
        "DOMAIN_MAP.md",
        "docs-site/src/content/docs/adr/accepted/0015-separate-gpu-execution-from-rendering.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runenrender-decomposition-design.md",
        "docs-site/src/content/docs/design/active/runenrender-internal-decomposition-execution-plan.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-render-s0-inventory.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-render-s0-file-disposition.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-render-s0-identity-consumer-lifecycle.md",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
    ],

    goal: "Replace renderer-owned RenderResourceId and RenderResourceIdSequence with a future-transferable RunenGPU-owned, owner-scoped GpuWorkResourceId and owner-controlled fallible allocator, while preserving current graph and runtime behavior and making foreign-flow resource handles rejectable.",

    problem_correction: [
        "The earlier scalar-only G1A specification was insufficient because each RenderFlow starts local resource allocation at the same value.",
        "UniformHandle and StorageArrayHandle are public values that can be passed into another RenderFlow's pass builder.",
        "With scalar allocator-local IDs, two flows can issue the same value and a foreign handle can collide with an unrelated local resource instead of being rejected.",
        "G1A must close this identity-collision seam before implementation; a type rename that preserves it is not extraction-grade.",
        "The first guarded implementation attempt proved that the original 38-file identity-consumer inventory was complete for type migration but incomplete for allocation-error propagation.",
        "RenderFlow currently exposes infallible resource-authoring methods, while GpuWorkResourceIdAllocator::allocate() is deliberately fallible; bridging them with expect, panic, unwrap, or fallback violates the accepted error contract.",
        "A corrected current-main census identifies 27 core and direct fallible-authoring files: 17 additional to the identity inventory and 10 already present in both inventories; all must migrate atomically to structured fallible authoring.",
        "Product app assembly must propagate RenderFlowAuthoringError through fallible app construction; this changes six integration-test callers of the public headless builders, which are inventoried separately as transitive callers.",
    ],

    semantic_decisions: [
        "GpuWorkResourceId identifies one logical resource declared inside one bounded GPU work-graph owner scope.",
        "The identity contains a private owner-scope component and a private nonzero local component.",
        "The owner scope is part of equality, ordering, hashing, diagnostics, and map lookup; equal local components from different scopes are distinct identities.",
        "G1A does not expose a separately public GpuWorkGraphId. The scope component is internal ownership evidence seeded by the current RenderFlow owner.",
        "The current bridge seeds the GPU allocator from the already-created nonzero RenderFlowId without importing renderer types into engine::plugins::gpu.",
        "It is not a concrete WGPU buffer, texture, view, sampler, bind group, pipeline, or backend allocation handle.",
        "It is not a render material, provider, view, target, feature, producer, source asset, persisted object, replay identity, network identity, wire value, or cross-process cache key.",
        "The first implementation lives under engine::plugins::gpu as an internal future-transferable RunenGPU boundary.",
        "G1A does not create a GpuPlugin, external package, facade, macro package, compatibility module, or backend abstraction.",
        "The implementation does not use id_macros::id because that macro generates safe arbitrary raw construction and TryFrom<u64>.",
        "The old RenderResourceId and RenderResourceIdSequence names are deleted in the same migration; no alias or forwarding re-export remains.",
    ],

    target_module_shape: [
        "engine/src/plugins/gpu/mod.rs",
        "engine/src/plugins/gpu/api/mod.rs",
        "engine/src/plugins/gpu/api/work_resource_id.rs",
        "engine/src/plugins/gpu/api/errors.rs only if the identity and allocator error cannot remain coherently colocated",
        "engine/src/plugins/render/api/errors.rs or the existing coherent render API error module for RenderFlowAuthoringError",
        "engine/src/plugins/mod.rs only to expose the internal gpu module and reviewed public identity re-export",
    ],

    public_contract: [
        "pub struct GpuWorkResourceId with private owner-scope and nonzero local representations.",
        "GpuWorkResourceId is Clone, Copy, Eq, Ord, Hash, Debug, and Display.",
        "Safe production API exposes no public try_from_raw, from_raw, new_unchecked, TryFrom<u64>, From<u64>, tuple constructor, or equivalent arbitrary-construction path.",
        "A read-only diagnostic_parts() or equivalent accessor may return the scope and local u64 values only for diagnostics, ordering, hashing, and trace correlation and must document that no stable-format guarantee exists.",
        "The identity representation is not repr(transparent) over one scalar and has no stable ABI or serialized representation.",
        "GpuWorkResourceIdAllocator is owner-controlled and not freely constructible by downstream callers.",
        "The current crate-private owner bridge constructs one allocator from one validated nonzero flow-owner scope.",
        "allocate() returns Result<GpuWorkResourceId, GpuWorkResourceIdAllocationError>.",
        "Exhaustion of the local component is explicit and never wraps, saturates into reuse, or panics through the fallible path.",
        "Allocation is deterministic for the same explicit owner scope, allocator state, and operation order.",
        "Every public or crate-private RenderFlow and pass-builder method that can allocate a GPU work-resource identity returns Result and propagates RenderFlowAuthoringError without panic or fallback.",
        "Non-allocating fluent authoring methods remain infallible and retain their current return shape.",
        "Handle-producing methods return Result<(RenderFlow, Handle), RenderFlowAuthoringError>; allocating fluent methods return Result<Self, RenderFlowAuthoringError>.",
    ],

    error_contract: [
        "GpuWorkResourceIdAllocationError::Exhausted or an equivalently precise owned variant.",
        "RenderFlowAuthoringError owns a transparent ResourceIdAllocation variant and composes existing procedural or GPU-primitive authoring failures where one operation can produce either category.",
