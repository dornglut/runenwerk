// Decision-complete implementation specification for RunenGPU G5C.
// G5C starts only after accepted G5B and an explicitly activated child issue.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G5C",
    title: "Renderer, UI, Timing, Capture, and Final Execution Cutover",
    lifecycle_state: "planned-blocked",
    implementation_authorization_status: "blocked-until-accepted-g5b-and-explicit-g5c-issue",
    owner: "RunenGPU final execution cutover owner",
    source_baseline: "accepted-g5b-merge-to-be-recorded-by-g5c-issue",
    planning_issue: "dornglut/runenwerk#284",
    implementation_issue: "pending-after-accepted-g5b",
    parent_issue: "dornglut/runenwerk#167",
    blocking_predecessor: "PT-RUNENGPU-G5B",
    successor: "PT-RUNENGPU-G6-planning",
    target_repository_after_internal_conformance: "dornglut/runen-gpu",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "docs-site/src/content/docs/architecture/repository-family-architecture.md",
        "docs-site/src/content/docs/adr/accepted/0015-separate-gpu-execution-from-rendering.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runengpu-g4c2-presentation-surface-binding-boundary.md",
        "docs-site/src/content/docs/design/active/runengpu-g5-execution-lifecycle-design.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-g5-execution-lifecycle-investigation.md",
        "docs-site/src/content/docs/reports/investigations/2026-08-14-runengpu-g5-critical-review.md",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g5a-executable-work-contracts.ron",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g5b-execution-lifecycle.ron",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
    ],

    goal: "Migrate every current renderer/UI/timing/capture G5 execution consumer to the accepted G5B prepare/submit/progress/readback lifecycle, encapsulate the existing pre-G7 current-host acquired-surface attachment path inside its owner without exposing raw surface objects or adding a reusable G7 API, preserve RunenRender semantic ownership while removing backend orchestration from it, delete CurrentRenderDeviceQueue and CurrentRenderExecutionBridge plus every current-render execution accessor/terminal, and prove one private RunenGPU execution authority with no renderer raw Device/Queue/CommandEncoder/submit/map/poll reach-through.",

    dependency_direction: [
        "RunenRender planning -> accepted G5A complete GpuWorkOperation/GpuPreparedWorkGraph.",
        "Accepted G5B GpuContext prepare/submit/progress/readback -> private WGPU execution for ordinary resources.",
        "Existing current-host surface owner -> owner-local lexical acquired-surface attachment binding -> the same G5 submit transaction for current renderer surface work.",
        "Renderer/UI consume normalized submission/readback outcomes only; they do not borrow backend objects.",
        "G7 reusable surface ownership remains separately classified and is not absorbed by this cutover.",
    ],

    current_source_census_before_change: [
        "Re-resolve exact accepted G5B main and enumerate every CurrentRenderDeviceQueue/current_render_device_queue reference.",
        "Enumerate every CurrentRenderExecutionBridge/current_render_execution_bridge reference and every purpose-typed terminal implementation/call site.",
        "Enumerate renderer/UI Device, Queue, CommandEncoder, queue.submit, map_async, Device::poll, mapped range, WGPU pipeline/bind-group/resource, timestamp/query, upload and copy use.",
        "Enumerate current-host surface acquisition, SurfaceTexture/view construction, attachment use, queue ordering, and physical present call sites separately from generic G5 execution.",
        "Enumerate timing/capture staging buffers, readback helpers, synchronous channels/poll loops, and renderer-owned completion assumptions.",
        "Enumerate every renderer/UI work-lowering path and prove it emits accepted complete G5A operations before deleting backend orchestration.",
        "Enumerate tests/examples/benches/primitive fixtures that still borrow the current-render seams and classify migrate/delete/retain-under-other-owner.",
    ],

    renderer_execution_cutover: [
        "Replace renderer phase-two current_render_device_queue acquisition with accepted G5B preparation/submission calls or the narrowly composed current-host surface submission terminal for surface-backed frames.",
        "Renderer no longer creates WGPU CommandEncoder or submits WGPU Queue work.",
        "Renderer does not reproduce G5B pressure, progress, completion, shutdown, realization retention, upload staging, or readback state.",
        "Renderer retains image-formation planning, semantic pass construction, frame timing policy, capture policy, product diagnostics presentation, and decoding/interpretation of normalized readback results.",
        "RenderFlow node/order truth remains the accepted GpuPreparedWorkGraph; no renderer execution sidecar is recreated.",
        "Surface acquisition/present policy stays on the separately accepted pre-G7 current-host owner; G5C binds only the exact SurfaceAcquired logical attachment requirement needed to encode the current frame.",
    ],

    current_host_surface_execution: [
        "Do not create a new public or reusable RunenGPU surface API, Surface handle family, broad import API, third object-reference bridge, or G7 surface-generation/recovery model in G5C.",
        "Retain the existing current-host surface owner as explicit G7 migration evidence. Raw Surface, SurfaceTexture, and acquired TextureView remain inside that owner/private WGPU integration boundary and never become renderer or public RunenGPU values.",
        "Accepted G5B prepared work may contain typed unresolved SurfaceAcquired attachment/present requirements. Ordinary reusable submit_prepared continues to reject/preserve such work with SurfaceBindingRequired.",
        "For the current renderer only, add one owner-local lexical terminal that first reserves G5 submit capacity without allocating GpuSubmissionId, then acquires the current host SurfaceTexture/view, validates exact context affinity plus logical format/extent/attachment identity against the prepared SurfaceAcquired requirement, and finally commits the same G5 submission transaction.",
        "The pre-commit reservation is synchronous/lexical, cannot escape or queue, owns no submission ID, and releases all reserved capacity while returning/preserving prepared work if surface acquisition or binding validation fails.",
        "Only after current-host binding succeeds does commit allocate GpuSubmissionId and begin private encoding/submission. Any subsequent encoding/queue/device failure terminalizes that accepted ID exactly once and cannot roll admission back.",
        "The raw acquired TextureView is lent only to the private G5 WGPU encoder for lexical render-attachment encoding; it cannot be stored in G5 logical work, cached as a G4 realization, used as shader binding authority, returned to renderer code, or used by a generic callback.",
        "After queue submission, the same current-host surface owner performs physical SurfaceTexture::present according to its existing policy. GpuSubmission completion means GPU execution completion, not display/compositor presentation completion.",
        "If pre-commit surface acquisition fails, no submission exists. If a post-commit terminal execution failure occurs, the current-host owner releases/drops its surface lease according to existing backend rules and does not fabricate successful presentation.",
        "This owner-local terminal is explicit G7 deletion inventory. G7 later replaces it with the reusable typed surface capability/generation/acquisition contract; G5 must not generalize it first.",
    ],

    ui_cutover: [
        "Lower one current UI render pass to one GpuRenderOperation containing ordered GpuRenderDraw values for rect/stroke/glyph/viewport-embed/product-surface batches.",
        "Preserve current pipeline switches, group-zero/group-one bindings, per-batch instance buffers, draw counts, and scissor semantics through generic G5A contracts.",
        "Do not split one UI render pass merely to simplify backend encoding.",
        "Delete UI-specific CurrentRenderExecutionBridge pipeline/bind-group/vertex-buffer terminals after the generic path is proven.",
        "No UI type enters RunenGPU public contracts.",
    ],

    timing_cutover: [
        "Express timing through generic render timestamp writes, GpuQueryResolveOperation, and GpuReadbackOperation.",
        "Delete renderer-owned WGPU query resolve encoding, map_async, Device::poll wait loop, mapped-range ownership, and private timing readback staging lifecycle replaced by G5B.",
        "Renderer timing policy may decode GpuReadbackBytes into durations using admitted timestamp facts; RunenGPU does not own renderer profiling policy or UI presentation.",
        "Environment-dependent timestamp availability remains an admitted capability fact and absence is not a generic execution failure.",
    ],

    capture_cutover: [
        "Express generic GPU capture transfer through accepted Copy/Readback operations over exact logical resources/regions.",
        "Delete renderer-owned WGPU map/poll/mapped-range and staging completion lifecycle replaced by G5B.",
        "RunenRender/Runenwerk retain capture request policy, naming, artifact encoding, persistence and presentation; G5 returns normalized bytes/provenance only.",
        "Texture row-padding/alignment is private G5B implementation and never leaks into capture policy.",
    ],

    upload_cutover: [
        "Migrate staged renderer buffer/texture queue-write operations to exact GpuUploadOperation values at their logical graph positions.",
        "Delete RendererPendingOperations upload execution authority after every current upload is represented by G5A work.",
        "No renderer raw queue-write terminal, staging allocator, or duplicated upload pressure owner remains.",
    ],

    primitive_and_test_cutover: [
        "Migrate the current environment-dependent primitive runtime fixture from raw CurrentRenderDeviceQueue/CurrentRenderExecutionBridge use to accepted G5B execution/readback APIs or delete it if fully superseded by stronger G5B/G5C representative proofs.",
        "Preserve deterministic primitive semantics and adapter-unavailable classification; do not keep a raw backend fixture only for historical evidence.",
        "Migrate examples/benches/tests that exercise ordinary GPU execution through public/typed RunenGPU APIs; retain raw WGPU only inside private backend conformance tests where the backend itself is the subject under test.",
    ],

    bridge_deletion: [
        "Delete CurrentRenderDeviceQueue type after its final G5 execution user migrates.",
        "Delete GpuContext::current_render_device_queue and every source reference.",
        "Delete CurrentRenderExecutionBridge and all purpose-terminal traits/implementations after generic G5B encoder ownership is complete.",
        "Delete GpuContext::current_render_execution_bridge and every source reference.",
        "Do not rename either bridge into a compatibility alias, forwarding module, generic backend callback, execution facade, or native-handle escape hatch.",
        "Preserve only separately accepted non-G5 temporary backend boundaries, notably the existing current-host/G7 surface owner and its one owner-local surface execution terminal; source-guard their distinct ownership and G7 deletion obligation.",
    ],

    final_execution_census: [
        "CurrentRenderDeviceQueue definitions = 0.",
        "current_render_device_queue accessor/calls = 0.",
        "CurrentRenderExecutionBridge definitions = 0.",
        "current_render_execution_bridge accessor/calls = 0.",
        "Renderer direct WGPU Device/Queue use for G5 execution = 0.",
        "Renderer WGPU CommandEncoder creation for G5 execution = 0.",
        "Renderer queue.submit calls = 0.",
        "Renderer map_async/Device::poll/mapped-range ownership for G5 readback = 0.",
        "Renderer raw SurfaceTexture/TextureView execution handoff = 0; raw acquired surface objects remain only inside the separately classified current-host/G7 owner and private WGPU encoder lexical call.",
        "RenderGpuWorkSidecar execution truth = 0.",
        "Renderer duplicated executable binding/access truth = 0.",
        "Public RunenGPU raw WGPU execution/fence/map/poll/surface escape hatches = 0.",
        "Private RunenGPU G5B execution lifecycle authorities = 1 coherent owner family.",
    ],

    retained_boundaries: [
        "RunenRender retains scene/view/material/lighting/visibility/image-formation/planning semantics and lowering policy.",
        "Runenwerk retains app scheduling, event-loop/yield/blocking policy, shader discovery/hot reload, product recovery, capture artifact encoding/persistence and diagnostics presentation.",
        "The existing current-host surface owner retains pre-G7 raw acquisition/configuration/present mechanics only; G7 later owns reusable surfaces, surface affinity/generations, capability negotiation, device replacement/reconstruction and product-visible recovery facts.",
        "G6 remains future proof/performance work and is not pulled into G5C acceptance.",
    ],

    migration_order: [
        "First revalidate complete consumer/raw-reach-through and current-host surface census against accepted G5B main.",
        "Introduce/prove the owner-local current-host surface submit composition without changing public RunenGPU or implementing reusable G7 semantics.",
        "Migrate renderer generic compute/render/copy/clear/resolve execution through G5B without changing image semantics.",
        "Migrate uploads, timing readback, capture readback and UI multi-draw execution.",
        "Migrate/supersede primitive fixtures, examples and benches.",
        "Delete renderer pending-operation/raw encoding helpers once no call site remains.",
        "Delete CurrentRenderExecutionBridge and CurrentRenderDeviceQueue/accessors in the same final cutover change; do not leave a zero-user compatibility shell.",
        "Run final complete source/reach-through/current-host-surface census and exact representative proofs before acceptance.",
    ],

    deterministic_tests: [
        "Renderer prepared work contains the same logical compute/render/copy/resolve/upload/readback/surface-acquired attachment semantics before and after backend orchestration migration.",
        "UI one-pass multi-draw ordering, pipeline/binding switches, instance counts and scissor values are preserved exactly.",
        "Timing query resolve/readback decoding produces the same deterministic normalized query bytes/values for synthetic data.",
        "Capture readback normalization strips backend padding and renderer artifact policy receives only logical bytes/format/provenance.",
        "Upload graph position preserves exact initialization/hazard dependencies formerly represented by pending renderer operations.",
        "Current-host submit reservation allocates no submission ID before surface binding, releases capacity and preserves prepared work on acquisition/binding failure, and allocates exactly one ID only at commit.",
        "Current-host surface binding rejects wrong context affinity, format, extent, logical attachment identity, missing/duplicate requirement, or attempted shader-resource use before command encoding.",
        "Post-commit execution failure terminalizes the accepted submission exactly once and does not fabricate successful presentation.",
        "Pressure and terminal submission/readback failures propagate through renderer integration without silent frame/capture/timing discard.",
        "Source guards enforce every final-execution-census zero/one invariant and reject aliases/forwarders/new surface bridges.",
        "No RunenRender/UI/application/product vocabulary enters RunenGPU public contracts during migration.",
    ],

    environment_dependent_tests: [
        "Representative current-host renderer frame acquires/binds/presents through the existing surface owner and executes GPU commands through G5B with no current-render execution bridge/loan or renderer raw acquired-view handoff.",
        "Representative UI frame exercises multiple GpuRenderDraw pipelines/bindings/scissors in one pass.",
        "Representative timing or generic query readback executes when TimestampQuery is admitted.",
        "Representative texture/buffer capture readback executes asynchronously through G5B.",
        "One independent non-render G5B consumer remains green after renderer integration.",
        "Adapter/surface/capability absence is reported separately from successful hardware execution.",
    ],

    source_guards: [
        "Exact zero counts for both deleted current-render execution seams/accessors.",
        "Exact zero renderer Device/Queue/CommandEncoder/queue.submit/map_async/Device::poll execution ownership outside separately classified private backend/current-host surface code.",
        "No renderer raw Surface/SurfaceTexture/acquired TextureView crosses into generic execution; such objects remain only inside the existing current-host/G7 owner and private WGPU encoder lexical terminal.",
        "No new public/reusable surface abstraction, third object-reference bridge, broad current-host callback, or G4C1 SurfaceAcquired realization surrogate appears.",
        "No permanent render execution sidecar or duplicated access/binding authority.",
        "No public raw WGPU/Naga/backend synchronization/mapped-range/surface escape.",
        "No new compatibility module/alias forwarding deleted bridge or raw execution authority.",
        "Current-host surface integration remains distinct and cannot be used as a generic G5 Device/Queue/resource/shader-binding escape.",
    ],

    stop_conditions: [
        "No G6 performance/offscreen expansion beyond proofs required to establish the accepted G5 boundary.",
        "No G7 reusable surface identity/generation/capability negotiation, loss/reconstruction, device replacement, or product recovery policy; only encapsulation of the already-existing current-host acquisition/attachment/present mechanics is allowed.",
        "No RunenRender image-formation redesign, broad renderer rearchitecture unrelated to execution ownership, new executor/runtime, second backend, multi-queue scheduler, graph optimizer, stable persisted execution format, broad import API, or native interop.",
        "Stop for a new owner decision if the current surface-backed renderer cannot be migrated using the one owner-local current-host terminal without widening it into reusable G7 ownership or a generic raw-resource escape.",
        "Stop for a new owner decision if any remaining raw renderer backend use cannot be classified as G5 execution, current-host/G7 surface migration, or private backend conformance.",
    ],

    validation: [
        "Focused renderer/UI/timing/capture/current-host-surface integration tests and final source guards.",
        "Complete raw-WGPU/current-render execution reach-through, current-host surface, and deletion census.",
        "Representative current-host render plus independent non-render environment-dependent proof when adapters/surfaces/capabilities are available.",
        "cargo validate",
        "git diff --check",
        "CI=true pnpm --dir docs-site build",
        "Exact-head CI and Documentation Build must succeed before acceptance.",
    ],

    acceptance: [
        "All ordinary renderer/UI/timing/capture G5 execution uses accepted RunenGPU prepare/submit/progress/readback authority, with the current-host surface attachment supplied only through the separately classified owner-local pre-G7 integration.",
        "Both residual G4/G5 current-render execution seams and their accessors are deleted with zero compatibility aliases.",
        "Renderer has no raw Device/Queue/CommandEncoder/submit/map/poll/acquired-surface-view authority for G5 execution.",
        "One generic execution lifecycle serves representative render and independent non-render consumers.",
        "Current-host raw surface mechanics remain isolated as explicit G7 deletion inventory and no reusable G7 semantics are implemented prematurely.",
        "Accepted-main validation must pass before G5 is marked complete and G6 planning may become active.",
    ],
)