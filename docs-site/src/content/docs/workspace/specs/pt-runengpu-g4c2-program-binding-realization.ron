// Decision-complete implementation specification for RunenGPU G4C2.
// G4C2 starts only after accepted G4C1 and an explicitly activated child issue.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G4C2",
    title: "Program, Layout, and Binding Realization",
    lifecycle_state: "planned-blocked",
    implementation_authorization_status: "blocked-until-accepted-g4c1-and-explicit-g4c2-issue",
    owner: "RunenGPU program and binding realization owner",
    source_baseline: "accepted-g4c1-merge-to-be-recorded-by-g4c2-issue",
    planning_issue: "dornglut/runenwerk#209",
    implementation_issue: "pending-after-accepted-g4c1",
    umbrella_issue: "dornglut/runenwerk#188",
    parent_issue: "dornglut/runenwerk#167",
    blocking_predecessor: "PT-RUNENGPU-G4C1",
    successor: "PT-RUNENGPU-G4C3",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "engine/Cargo.toml",
        "Cargo.lock",
        "docs-site/src/content/docs/design/active/runengpu-shader-authoring-artifact-boundary.md",
        "docs-site/src/content/docs/design/active/runengpu-g4b-contracts-g4c-delivery-design.md",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4b-program-interface-layout.ron",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4c-wgpu-realization-cutover.ron",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4c1-resource-realization.ron",
    ],

    goal: "Create one private context/device-generation-bound WGPU authority for canonical WGSL modules, mandatory version-matched Naga evidence, WGPU module acceptance, normalized observed shader-stage IO, bind-group layouts, pipeline layouts, typed bind groups, and correctness-complete caches; supersede and delete the G4C1 resource bridge with one narrowly scoped pipeline-successor bridge that carries only proven residual resource terminals plus G4C2 program/layout/bind-group terminals; and avoid realizing compute/render pipelines or performing final renderer cutover.",

    dependency_direction: [
        "Accepted G4B admitted source records, entry points, resource interfaces, stage-IO comparison vocabulary, and layouts -> G4C2 private WGSL and binding realization.",
        "Accepted G4C1 opaque resources -> G4C2 runtime binding compatibility and typed bind groups.",
        "The existing engine-private direct Naga dependency parses and validates canonical WGSL for normalized evidence; the original canonical WGSL text remains the only WGPU shader source submitted for backend realization.",
        "G4C2 deletes CurrentRenderResourceBridge and replaces it with CurrentRenderPipelineBridge, which carries only the proven residual G4C1 resource terminals that G4C2 does not itself migrate.",
        "Accepted G4C2 program records, observed stage-IO signatures, layouts, and bind groups -> G4C3 through opaque handles and CurrentRenderPipelineBridge, which also carries only the program/layout/bind-group terminals still required by current pipeline creation and unchanged G5 encoding.",
    ],

    pinned_parser_baseline: [
        "Accepted planning base engine/Cargo.toml directly pins wgpu 27.0.1 and naga 27.0.3 with the wgsl-in feature.",
        "The G4C2 implementation issue must re-resolve exact accepted main and record cargo tree evidence for the direct Naga parser/validator version and every WGPU-internal Naga version.",
        "Proceed only when the direct evidence path is version-compatible with the pinned WGPU implementation; if Cargo resolves different incompatible Naga major/minor authorities or WGPU changes its WGSL validation baseline, stop for the smallest explicit dependency-baseline decision.",
        "Reuse the existing direct dependency when alignment is proven; do not add a second parser, reflection crate, compiler frontend, or parallel shader-source path.",
        "No public RunenGPU type exposes naga::Module, naga::valid::ModuleInfo, handles, arenas, bindings, validation flags, capabilities, errors, or source spans.",
        "Naga types remain confined to one private G4C2 WGSL-evidence module and are normalized immediately into RunenGPU-owned facts and bounded diagnostics.",
    ],

    wgsl_evidence_pipeline: [
        "Parse the exact canonical WGSL bytes with the pinned direct naga::front::wgsl path; do not parse a rewritten, formatted, preprocessed, or backend-generated source variant.",
        "Validate the parsed module with one explicit version-pinned naga::valid::Validator configuration.",
        "ValidationFlags and Capabilities are derived from the accepted RunenGPU portable source profile and admitted device requirements; Capabilities::all or an equivalent permissive configuration is forbidden as acceptance evidence.",
        "Normalize entry points, resource bindings, access, type/shape/cardinality, applicable layout, vertex-input, fragment-output, builtin, override, and requirement facts from the validated module and module-info structures.",
        "Run G4B's resource-interface agreement before private WGPU module publication and retain observed stage-IO signatures for G4C3.",
        "Separately submit the original canonical WGSL text through WGPU's WGSL shader-source path under bounded backend error capture; do not submit naga::Module through a Naga shader-source variant and do not create a second runtime source kind.",
        "Publish one G4C2 program realization only when direct Naga parse/validation/evidence normalization succeeds, explicit resource-interface agreement succeeds, and WGPU accepts the same canonical WGSL text.",
        "A Naga/WGPU disagreement is structured ShaderValidationPathMismatch with both bounded evidence classes; it is never silently resolved in favor of one path or treated as a cache miss.",
        "The direct Naga parse is evidence and diagnostics machinery, not public source identity, runtime module authority, a persisted IR, or a replacement for WGPU backend creation.",
    ],

    realized_handle_contracts: [
        "Opaque Clone non-Copy handles cover realized programs/modules, bind-group layouts, pipeline layouts, and bind groups.",
        "Every handle retains GpuContextAffinity and complete admitted descriptor identity for typed inspection.",
        "Program handles retain normalized observed resource-interface facts and observed vertex-input/fragment-output signatures from the pinned direct Naga evidence path.",
        "Observed facts are validation evidence only and cannot create resource declarations, vertex-buffer state, or color-target policy.",
        "Handles expose no public raw WGPU object, Naga IR, backend module output, pointer, persistence identity, or wire identity.",
        "Bind-group handles retain exact layout identity and ordered realized binding values.",
    ],

    wgsl_realization_contract: [
        "Consume only canonical WGSL admitted through the accepted G4B source registry.",
        "Reject unknown, evicted-without-live-reference, foreign-owner, or source-revision-conflicting records before parser or backend creation.",
        "Run the complete WGSL evidence pipeline before publishing the private WGPU shader module realization.",
        "Normalize and retain observed vertex entry-point input locations/classes and fragment entry-point output locations/classes for later G4C3 pipeline compatibility.",
        "Naga IR, module-info, and backend-native outputs remain private ephemeral implementation facts and never become public identity, cache, persistence, replay, or wire formats.",
        "Any parser, validator, agreement, or backend module creation failure publishes no authoritative realization or cache entry.",
    ],

    mandatory_reflection_agreement: [
        "Normalize observed entry-point names and stages, group/binding identities, stage visibility, resource classes, access, dimensions, sample/storage format facts, array cardinality, applicable host-layout facts, vertex-input locations/classes, and fragment-output locations/classes into G4B-owned vocabulary.",
        "Use the single G4B resource-interface comparison algorithm to prove observed resource facts agree with the explicit authoritative declarations; observed statically-used stages must be a subset of declared visibility, while declared visibility may be a strict accessibility superset.",
        "Reject missing, additional, renumbered, stage-mismatched, type-mismatched, visibility-mismatched, shape-mismatched, or layout-incompatible resource facts as ProgramInterfaceMismatch.",
        "Retain normalized stage-IO signatures with the program record; do not compare them to vertex buffers or color targets until G4C3 receives a complete render pipeline descriptor.",
        "Evidence may improve source-span diagnostics but may not mutate, infer, renumber, add, or remove authoritative declarations or pipeline state.",
        "ProgramInterfaceMismatch is terminal for that realization request and cannot fall back to inferred WGPU layouts.",
    ],

    observed_stage_io_contract: [
        "Observed vertex input signatures are keyed by exact vertex entry point and contain unique shader locations plus normalized scalar/vector classes.",
        "Observed fragment output signatures are keyed by exact fragment entry point and contain unique color locations plus normalized scalar/vector classes.",
        "Builtins are represented separately from user locations and cannot be mistaken for vertex attributes or color targets.",
        "Duplicate or unsupported observed locations/classes reject program realization with a structured WGSL validation error.",
        "Observed signatures participate in program realization and cache identity because they affect later pipeline compatibility.",
        "Observed signatures are not public source identity, renderer semantics, persistence authority, or a replacement for explicit render pipeline state.",
    ],

    layout_realization_contract: [
        "Realize bind-group layouts only from accepted complete GpuBindGroupLayoutDescriptor values.",
        "Realize pipeline layouts only from accepted ordered unique group-layout descriptors.",
        "Do not use WGPU automatic layout inference or shader evidence as layout authority.",
        "Validate relevant admitted features, limits, dynamic-offset constraints, array cardinality, storage texture formats, and sampler/texture compatibility before backend creation.",
        "When a group contains any binding array, enforce pinned WGPU group restrictions: no buffer in that group may use a dynamic offset and no buffer in that group may be uniform.",
        "Equal complete descriptors may reuse one cache-backed layout realization within one context/generation.",
    ],

    typed_bind_group_contract: [
        "A bind-group request names one accepted realized layout and supplies ordered typed binding values.",
        "Each value references accepted G4C1 resource handles or complete inline sampler semantics where the accepted API permits it.",
        "Validate exact resource kind, usage, range, minimum size, dynamic-offset policy and alignment, texture view/format/sample/multisample facts, storage access, sampler class, array cardinality, and context/device-generation affinity before backend creation.",
        "Reject unknown, duplicate, missing, extra, foreign, stale, or incompatible values with structured binding diagnostics.",
        "Backend bind-group creation is transactional and publishes no partial authoritative entry.",
        "Every current bind-group consumer that G4C2 owns uses typed G4C1 handles directly, so CurrentRenderResourceBridge is deleted before G4C2 acceptance while only separately proven residual resource terminals move into CurrentRenderPipelineBridge.",
    ],

    validation_order: [
        "Validate admitted source record and exact context affinity.",
        "Reject stale device generation.",
        "Run direct Naga parse, validation, and normalized evidence extraction on the exact canonical WGSL.",
        "Validate expected program resource interface and declared entry points against normalized evidence.",
        "Submit the same canonical WGSL text to WGPU and require successful private module creation.",
        "Validate complete layout descriptors against admitted device facts.",
        "Validate typed runtime binding values against the accepted interface and G4C1 realizations.",
        "Look up complete typed cache keys and compare full equality.",
        "Publish private program/layout/bind-group registry entries transactionally only after every deterministic and backend check succeeds.",
    ],

    registry_invariants: [
        "Separate private registries own program/module, bind-group-layout, pipeline-layout, bind-group, and cache-diagnostic records.",
        "Each registry instance is scoped to exactly one GpuContextId and GpuDeviceGeneration.",
        "Each program entry retains the admitted source record, direct-evidence compatibility revision, complete explicit resource interface, normalized observed resource facts, observed stage-IO signatures, WGPU acceptance fact, and bounded diagnostics/provenance.",
        "Each layout and bind-group entry retains its complete typed descriptor and exact dependency identities.",
        "Equal duplicate requests return the same realization record; changed descriptors do not replace accepted identities.",
        "Hash collisions cannot authorize reuse because full equality follows hashing.",
        "No consumer callback executes under registry locks and no failure publishes partial state.",
    ],

    cache_key_contracts: [
        "Program keys include context identity, device generation, source owner/key/revision, full canonical WGSL identity and digest, direct Naga evidence version/configuration revision, WGPU/backend compatibility revision, entry-point declarations, complete expected resource interface, normalized observed resource facts, observed stage-IO signatures, admitted requirements, and WGPU acceptance facts required for correctness.",
        "Bind-group-layout keys include context affinity, complete group descriptor, relevant admitted features/limits, and internal descriptor compatibility revision.",
        "Pipeline-layout keys include context affinity, ordered complete group-layout identities, relevant admitted features/limits, and internal descriptor compatibility revision.",
        "Bind-group keys include context affinity, complete layout identity, ordered typed values, complete G4C1 realization identities/ranges/generations, and relevant admitted facts.",
        "Labels, filesystem paths, authoring compiler handles, source maps, raw Naga handles, renderer IDs, WGPU object addresses, and naked hashes are excluded.",
    ],

    cache_behavior: [
        "Initial caches are in-memory, derived, discardable, reconstructable, and scoped to one context/device generation.",
        "Full match returns an existing realization and emits Hit.",
        "Absent entry creates ordinarily and emits Miss.",
        "Incompatible derived entry emits Rejected and follows ordinary realization after discard or quarantine.",
        "Resource-interface or Naga/WGPU validation-path disagreement is a semantic rejection, not a cache miss or fallback.",
        "Backend creation failure emits RealizationFailed and publishes no authoritative entry.",
        "No persisted module, layout, bind-group, Naga IR, module-info, observed signature, backend output, or cross-process handle format is authorized.",
    ],

    successor_migration_bridge: [
        "Delete CurrentRenderResourceBridge before publishing G4C2 acceptance; it has zero remaining source references and its still-required access is represented only by the successor's proven residual terminals.",
        "Permit exactly one crate-private module named CurrentRenderPipelineBridge after G4C2 acceptance.",
        "The bridge exists only because audited current pipeline-creation and unchanged G5 encoding operations still require the proven residual G4C1 resources and G4C2 program/layout/bind-group objects until G4C3 supersedes it.",
        "The bridge accepts validated opaque G4C1 resource and G4C2 program, bind-group-layout, pipeline-layout, and bind-group handles and exposes only narrowly typed owner-local terminals for exact audited current pipeline-creation and encoding consumers; it exposes no public accessor, Deref, AsRef, reusable raw handle, generic raw-WGPU callback, or arbitrary consumer closure.",
        "The bridge may lend borrowed resource, shader-module, layout, and bind-group references only for lexical use through those purpose-typed terminals; borrowed values cannot escape, be stored, cloned into ownership, cached, returned, persisted, or treated as resource/program/layout/pipeline identity.",
        "A terminal may support its unchanged later-phase operation, but the bridge never performs or owns pipeline realization, command encoding, uploads, submission, or any other operation.",
        "The bridge owns validated access only; it does not validate stage IO and owns no resource, source, interface, layout, pipeline descriptor, cache, execution, or lifecycle truth.",
        "Bridge lookup repeats exact context/device-generation and handle-kind validation and invokes no external callback under registry locks.",
        "Source guards permit exactly this named bridge and its audited current terminals and reject a second pipeline bridge, the deleted resource bridge, or broad raw-WGPU reach-through.",
        "G4C3 must delete CurrentRenderPipelineBridge before publishing G4C3 acceptance, migrating terminals it owns and carrying only proven residual resource/bind-group terminals plus newly realized G4C3 pipeline terminals into its single execution successor bridge.",
    ],

    current_consumer_migration: [
        "Repeat the exact-current-main census for shader-module, binding-layout, pipeline-layout, bind-group, runtime-binding, parameter-byte, sidecar, renderer setup, material, UI, example, bench, and test consumers.",
        "Repeat the dependency census for every direct Naga and WGPU use and record the exact module that owns private WGSL evidence.",
        "Migrate explicit program/interface/layout/bind-group realization through the G4C2 owner while retaining filesystem/watch/reload/LKG policy in Runenwerk and semantic shader meaning in RunenRender or other consumers.",
        "Migrate CurrentRenderResourceBridge terminals that G4C2 owns to typed G4C2 bind-group realization, delete that predecessor bridge, and record the only residual resource terminals that the successor may retain.",
        "Convert unavoidable current renderer pipeline creation and unchanged G5 encoding access to CurrentRenderPipelineBridge terminals rather than leaving renderer-owned resource/module/layout/bind-group registries or a parallel G4C2 realization path.",
        "Classify render-pipeline stage-IO comparison, compute/render pipeline realization, and final renderer cutover explicitly for G4C3 rather than changing them here.",
        "Preserve existing G5 command encoding and G7 surface behavior as migration evidence and ownership; an unchanged G5 operation may lexically consume a successor-terminal borrow without moving execution into G4C2.",
    ],

    delete_after_migration: [
        "CurrentRenderResourceBridge and every source reference to it; each still-required access must instead be an exact CurrentRenderPipelineBridge terminal or a G4C2-owned realization path.",
        "Renderer-owned WGPU shader-module, bind-group-layout, pipeline-layout, and bind-group registries or caches fully replaced by G4C2.",
        "Automatic or inferred WGPU layout authority.",
        "Program/interface/layout/bind-group keys based only on strings, paths, TypeId, renderer IDs, labels, or naked hashes.",
        "Parallel WGSL module, Naga evidence, or runtime binding realization paths outside the RunenGPU owner.",
        "Broad raw resource/module/layout/bind-group access outside the one accepted CurrentRenderPipelineBridge at the G4C2 boundary.",
        "G4C2-owned program, resource-interface, observed-stage-IO, layout, binding, evidence, and cache truth in the temporary G3 execution sidecar.",
    ],

    structured_failures: [
        "ForeignContext",
        "StaleDeviceGeneration",
        "UnknownAdmittedSource",
        "SourceRevisionConflict",
        "NagaDependencyBaselineMismatch",
        "WgslParseOrValidationFailed",
        "ShaderValidationPathMismatch",
        "ProgramInterfaceMismatch",
        "ObservedStageIoInvalid",
        "UnknownLayout",
        "LayoutDescriptorInvalid",
        "RuntimeBindingIncompatible",
        "BindingValueMismatch",
        "RegistryCapacityExceeded",
        "CacheRejected",
        "BackendProgramOrBindingRealizationFailure",
        "CurrentRenderPipelineBridgeViolation",
    ],

    deterministic_tests: [
        "Foreign-context and stale-generation rejection precede parser/backend access and cache-hit success.",
        "Version and configuration facts for the direct Naga evidence path are explicit and participate in compatibility identity.",
        "Permissive Capabilities::all-style validation cannot be used as accepted evidence.",
        "Synthetic normalized WGSL facts exercise every mandatory agreement and exact mismatch category.",
        "Observed vertex/fragment signatures normalize independently of arena/parser enumeration order and reject duplicate or unsupported user locations/classes.",
        "Evidence cannot add, remove, renumber, or mutate authoritative declarations or pipeline state.",
        "Complete module/layout/bind-group keys are insertion-order-independent and include every correctness field, including evidence compatibility revision and observed stage IO.",
        "Equal duplicate realization reuses one record; changed descriptor rejects transactionally.",
        "Typed binding values reject wrong kind, range, size, alignment, format, sample class, access, array cardinality, foreign context, and stale generation.",
        "CurrentRenderResourceBridge has zero remaining source references at G4C2 acceptance.",
        "CurrentRenderPipelineBridge rejects foreign, stale, wrong-kind, escape, storage, caching, return, identity, and bridge-owned pipeline/encoding/upload/submission attempts and has only audited purpose-typed current terminals.",
        "Labels, provenance, source maps, authoring paths, and raw Naga handles do not split equal realizations.",
        "Source and dependency guards reject public Naga/WGPU authority, a second evidence path, renderer/ECS/application/product ownership, broad access, and a second bridge.",
    ],

    environment_tests: [
        "Parse and validate representative canonical WGSL compute and render programs through the exact direct Naga dependency resolved for the implementation head.",
        "Submit the byte-identical canonical WGSL strings to WGPU and require successful private module creation.",
        "Prove explicit resource declarations agree with normalized direct-Naga evidence.",
        "Retain real normalized vertex-input and fragment-output signatures for the representative render program.",
        "Reject one direct-Naga parse/validation failure, one resource-interface mismatch, and one bounded Naga/WGPU path disagreement fixture where the pinned APIs permit deterministic construction.",
        "Realize representative bind-group and pipeline layouts and one typed bind group using accepted G4C1 resources.",
        "Exercise one current representative compute or render pipeline-creation terminal and one unchanged G5 encoding terminal through CurrentRenderPipelineBridge without implementing G4C3 pipeline authority or moving G5 ownership.",
        "Prove cache reuse within one context/generation and isolation across another context/generation.",
    ],

    source_and_dependency_guards: [
        "The direct naga dependency remains private to the G4C2 WGSL-evidence owner; no naga type crosses engine/src/plugins/gpu public modules.",
        "Canonical WGSL text remains the only WGPU shader-source path; ShaderSource::Naga or equivalent IR submission is forbidden.",
        "No second WGSL parser, reflection library, shader compiler, or alternate source frontend is introduced.",
        "Cargo tree evidence proves the accepted direct evidence version and WGPU validation baseline are compatible at the exact implementation head.",
        "No automatic/inferred WGPU layouts, public raw WGPU, or broad private callback path is introduced.",
    ],

    exclusions: [
        "No compute or render pipeline realization under RunenGPU authority and no comparison of stage IO against a G4B render pipeline descriptor.",
        "No final renderer-wide realization/cache cutover beyond module/layout/bind-group authority fully replaced here.",
        "No raw-WGPU bridge other than CurrentRenderPipelineBridge after CurrentRenderResourceBridge deletion; its accepted residual resource/program/layout/bind-group terminals do not create a generic callback escape hatch.",
        "No new Naga/WGPU dependency or feature change when exact-current-main already proves the accepted direct baseline; any required dependency-baseline change stops for separate authorization.",
        "No authoring compiler, WESL, Slang, HLSL, GLSL, SPIR-V, source discovery, watch, reload scheduling, or last-known-good implementation.",
        "No G5 execution, submission, progress, readback, cancellation, retirement, delayed destruction, or shutdown redesign; an unchanged G5 operation may only use a lexical successor-terminal borrow.",
        "No G7 surface, presentation, device replacement, loss, or reconstruction implementation.",
        "No RunenRender semantics, package extraction, stable format, compatibility facade, generated workflow state, inferred layout authority, or public raw-WGPU escape hatch.",
    ],

    validation: [
        "Focused deterministic and environment-dependent program/layout/binding/evidence proof.",
        "Complete current-consumer, direct-dependency, validation-path, predecessor-bridge deletion, successor-bridge call-site, and authority-deletion census.",
        "cargo tree -p engine --locked evidence for wgpu and every naga version",
        "cargo validate",
        "git diff --check",
        "CI=true pnpm --dir docs-site build",
        "Repository-owned exact-head CI and Documentation Build.",
        "Independent complete-diff review with no unresolved blocking finding.",
        "All tracked files remain below 131072 raw bytes.",
    ],

    acceptance: [
        "One private context/generation-bound WGSL module, layout, and bind-group realization owner exists.",
        "The exact current dependency graph proves one compatible direct Naga evidence path for the pinned WGPU baseline or records a separately accepted dependency correction.",
        "Every published program has direct Naga parse/validation evidence, explicit G4B resource agreement, retained stage-IO signatures, and WGPU acceptance of the same canonical WGSL text.",
        "Typed layouts and bind groups use accepted G4C1 resource handles and complete compatibility validation.",
        "Program/layout/bind-group cache keys and outcomes are correctness-complete and structured.",
        "CurrentRenderResourceBridge and every replaced renderer-owned module/layout/bind-group authority are deleted without aliases or a parallel path; each still-required resource terminal is either G4C2-owned or an exact CurrentRenderPipelineBridge terminal.",
        "Exactly one CurrentRenderPipelineBridge remains for G4C3 replacement and deletion, carrying only proven residual resource terminals plus current program/layout/bind-group terminals; no broader raw reach-through remains.",
        "Compute/render pipelines and final stage-IO compatibility remain blocked for G4C3.",
        "Exact-head validation and independent review pass, then G4C3 may be activated from accepted main.",
    ],
)
