// Decision-complete implementation specification for RunenGPU G4C.
// G4C starts only after the separately bounded G4B implementation is accepted.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G4C",
    title: "WGPU Realization, Cache Compatibility, and Renderer Cutover",
    lifecycle_state: "planned-blocked",
    implementation_authorization_status: "blocked-until-accepted-g4b-and-separate-active-g4c-issue",
    owner: "RunenGPU contract owner",
    source_baseline: "accepted-g4b-merge-to-be-recorded-by-g4c-issue",
    planning_issue: "dornglut/runenwerk#182",
    implementation_issue: "pending-after-planning-acceptance",
    parent_issue: "dornglut/runenwerk#167",
    blocking_predecessor: "PT-RUNENGPU-G4B",
    target_repository_after_internal_conformance: "dornglut/runen-gpu",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "docs-site/src/content/docs/architecture/repository-family-architecture.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runengpu-g4-context-program-realization-design.md",
        "docs-site/src/content/docs/design/active/runenrender-internal-decomposition-execution-plan.md",
        "docs-site/src/content/docs/reports/investigations/runengpu-g4-context-program-realization-investigation.md",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4a-context-admission.ron",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4b-program-interface-layout.ron",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
        "docs-site/src/content/docs/workspace/planning/active-work.md",
    ],

    goal: "Create one private WGPU realization authority bound to GpuContextId and GpuDeviceGeneration for logical resources, programs, layouts, bind groups, and compute/render pipelines; implement correctness-complete in-memory cache compatibility, migrate every current consumer, and delete renderer-owned GPU realization, synthetic logical handles, the temporary owner bridge, and G4-owned sidecar truth without implementing G5 execution or G7 surfaces.",

    dependency_direction: [
        "G2 logical resources and G4B program/pipeline descriptors -> G4C context-owned private WGPU realization.",
        "RunenRender and non-render consumers receive opaque generation-bound handles and never own reusable WGPU backend objects.",
        "G5 consumes G4C realizations to encode and submit accepted G3 work.",
    ],

    phase_ownership: [
        "G4A owns context identity, device generation, adapter/device admission, and normalized admitted facts.",
        "G4B owns program/source/interface/binding/layout/specialization/pipeline descriptors.",
        "G4C owns WGPU resource/program/layout/bind-group/pipeline objects, realization registries, context/generation affinity, cache compatibility, migration, and deletion of replaced renderer authority.",
        "G5 owns execution, uploads, query-resolution encoding, submission, progress, completion, readback, cancellation, runtime retirement, and delayed destruction.",
        "G7 owns surface creation/configuration/acquisition/presentation, device replacement, loss, and reconstruction facts.",
        "RunenRender owns semantic image formation and Runenwerk owns source/watch/window/product policy.",
    ],

    realized_handle_contracts: [
        "Opaque Clone non-Copy handle families cover realized buffers, textures, texture views, samplers, query sets, programs, bind-group layouts, pipeline layouts, bind groups, compute pipelines, and render pipelines.",
        "Every realized handle exposes typed logical identity and GpuContextAffinity for inspection but no raw WGPU object or pointer.",
        "Exact public type/module names may follow coherent responsibility; no numbered split or facade package is required.",
        "Runtime IDs and affinities are process-local and are not stable persistence or wire authority.",
    ],

    realization_timing: [
        "Persistent or imported buffers/textures are explicitly realized before graph execution.",
        "Transient graph resources are explicitly realized in one bounded graph-realization pass after G3 preparation and before G5 encoding.",
        "Samplers are explicit or cache-backed lazy from a complete descriptor.",
        "Texture views are lazy only within an already realized parent texture and are cached by complete normalized view descriptor.",
        "Query sets are explicitly realized.",
        "Program modules are explicitly admitted or lazily realized by the first explicit pipeline realization request.",
        "Bind-group layouts and pipeline layouts are cache-backed lazy derived state.",
        "Bind groups are explicitly realized from one typed layout and realized binding values.",
        "Compute/render pipelines are explicit or cache-backed lazy before execution.",
        "G5 encoding cannot silently create undeclared logical resources or bypass realization compatibility.",
    ],

    validation_order: [
        "Validate logical descriptor.",
        "Reject foreign context for every already realized input.",
        "Reject stale device generation.",
        "Validate resource/program/interface/pipeline compatibility.",
        "Validate admitted feature, limit, format, and alignment facts.",
        "Look up a full typed cache key and compare full equality.",
        "Create the private WGPU object only after all deterministic checks pass.",
        "Publish a registry entry transactionally only after backend creation succeeds.",
    ],

    structured_failures: [
        "ForeignContext",
        "StaleDeviceGeneration",
        "UnknownLogicalResource",
        "DescriptorChangedForIdentity",
        "ResourceKindMismatch",
        "ProgramInterfaceMismatch",
        "BindingValueMismatch",
        "RequirementNotAdmitted",
        "FormatOrAlignmentNotAdmitted",
        "CacheRejected",
        "CacheRejectedCorrupt",
        "BackendRealizationFailure",
    ],

    registry_invariants: [
        "Separate private registries own resource, program/module, bind-group-layout, pipeline-layout, bind-group, compute-pipeline, render-pipeline, and cache-diagnostic records.",
        "Each registry instance is scoped to exactly one context identity and device generation.",
        "Full typed keys and full equality checks are mandatory; hash collisions cannot authorize reuse.",
        "No renderer, ECS, Winit, domain, application, product, TypeId, string-only lookup, or raw WGPU public field enters registry authority.",
        "Every authoritative entry retains its complete normalized source descriptor and provenance reference.",
        "Failures publish no partial registry entry.",
        "Equal duplicate requests return the same logical realization record.",
        "One logical identity with a different descriptor is rejected rather than replaced.",
        "Diagnostic labels do not split equal realizations.",
        "No consumer callback is invoked under registry locks.",
    ],

    resource_keys: [
        "Resource keys include context identity, device generation, logical resource identity, complete normalized descriptor, and import/source generation where applicable.",
        "Texture-view keys additionally include parent realization identity and complete normalized subresource/view descriptor.",
        "Sampler keys include complete sampler semantics.",
        "Query-set keys include exact kind and count.",
        "Labels and WGPU object addresses are excluded.",
    ],

    program_and_pipeline_keys: [
        "Program/module keys include context identity, device generation, source kind, source key, source revision, source content digest, entry-point declarations, complete interface, admitted requirements, and WGPU/backend compatibility revision.",
        "Layout keys include context identity, generation, complete layout descriptor, and relevant admitted limits/features.",
        "Bind-group keys include context identity, generation, complete layout identity, ordered typed binding values, complete resource realizations/ranges, and import/resource generations.",
        "Pipeline keys include context identity, generation, complete program/module and entry-point identities, interface, pipeline layout, complete compute/render descriptor, specialization values, relevant admitted features/limits/formats/alignments, and WGPU/backend compatibility revision.",
        "Renderer semantic identities may affect the lowered complete descriptor but cannot appear merely as opaque RenderFlowId, RenderPassId, RenderFeatureId, string, path, label, or naked hash authority.",
    ],

    cache_scope: [
        "Initial caches are in-memory, derived, discardable, reconstructable, and scoped to one GpuContextId and GpuDeviceGeneration.",
        "No stable persisted pipeline cache, source schema, capture format, wire format, or cross-process runtime handle format is authorized.",
        "Backend cache blobs remain disabled unless the implementation issue proves the pinned WGPU API can use them within this accepted internal envelope without defining a stable format.",
    ],

    cache_compatibility_inputs: [
        "RunenGPU internal cache schema revision.",
        "RunenGPU descriptor schema revision.",
        "Pinned WGPU version and backend compatibility revision.",
        "Normalized backend family and adapter class.",
        "Available adapter and relevant driver identity/version facts.",
        "Context identity and device generation for in-memory entries.",
        "Source kind, key, revision, and content digest.",
        "Program interface and specialization identity.",
        "Complete resource/layout/pipeline descriptor.",
        "Exact enabled features and effective limits.",
        "Relevant format and alignment facts.",
    ],

    cache_behavior: [
        "Full match returns the existing realization and emits Hit.",
        "Absent entry creates ordinarily and emits Miss.",
        "Incompatible entry emits typed Rejected, discards or quarantines the entry, then follows ordinary realization.",
        "Corrupt or unreadable backend data emits RejectedCorrupt and follows ordinary realization.",
        "Backend creation failure emits RealizationFailed and publishes no cache entry.",
        "Cache stats distinguish hits, misses, rejections, corruption rejections, and creation failures.",
        "A cache hit changes cost only and never changes semantics.",
    ],

    private_wgpu_ownership: [
        "Only private RunenGPU backend modules own reusable WGPU buffers, textures, views, samplers, query sets, shader modules, bind-group layouts, pipeline layouts, bind groups, compute pipelines, render pipelines, instance, adapter, device, and queue after cutover.",
        "Current render files may retain command/pass encoders, surface textures, presentation, and residual execution objects only as explicitly G5/G7-owned migration evidence.",
        "No public raw backend accessor, broad callback, Deref, AsRef, re-export, or compatibility facade is accepted.",
    ],

    migration_order: [
        "Add context/generation-bound private RunenGPU realization registries.",
        "Realize accepted G2 logical resources through GpuContext.",
        "Realize accepted G4B programs, bind-group layouts, and pipeline layouts through GpuContext.",
        "Realize typed bind groups and compute/render pipelines through GpuContext.",
        "Migrate renderer setup, dynamic targets, material GPU resources, UI passes, flow runtime caches, apps, examples, benches, and tests.",
        "Replace raw Device/Queue reach-through with bounded crate-private RunenGPU operations required by the retained G5 seam.",
        "Remove renderer keys that substitute paths, pass/feature IDs, strings, TypeId, labels, or naked hashes for complete G4 descriptors.",
        "Remove renderer-owned WGPU resource/program/layout/bind-group/pipeline registries and caches.",
        "Remove synthetic G2 handle construction and the RenderFlowId-derived work-resource owner bridge.",
        "Remove all G4-owned program/interface/layout/pipeline/cache/realization truth from the G3 sidecar.",
        "Add source, dependency, reach-through, sidecar, migration, and deletion guards.",
        "Prove all current consumers migrated and all replaced authority deleted in the same slice.",
    ],

    delete_after_migration: [
        "Renderer-owned reusable WGPU resource allocator and registries.",
        "Renderer-owned shader-module, bind-group-layout, pipeline-layout, bind-group, sampler, compute-pipeline, and render-pipeline caches.",
        "String-only PipelineKey as GPU correctness authority.",
        "FlowPassPipelineKey and FlowPassBindGroupKey as GPU correctness authority.",
        "Backend aliases that only forward renderer cache authority.",
        "Synthetic GpuBufferHandle, GpuTextureHandle, GpuTextureViewHandle, GpuSamplerHandle, and GpuQuerySetHandle construction outside the RunenGPU owner.",
        "RenderFlowId-derived GpuWorkResourceId owner bridge.",
        "Program/interface/layout/pipeline/cache/realization fields in the temporary execution sidecar.",
        "Public WgpuCtx Device/Queue reach-through and any replacement raw accessors.",
    ],

    retain_for_g5: [
        "Prepared G3 graph and generic operation truth.",
        "Residual operation-specific execution payload only.",
        "Command and pass encoding.",
        "Uploads, updates, staging, and query-resolution execution.",
        "Queue submission, polling, progress, completion, cancellation, mapping/readback, and runtime retirement.",
        "Delayed backend destruction and shutdown semantics.",
    ],

    retain_for_g7: [
        "Runenwerk window-to-surface registry and Winit host integration.",
        "Temporary compatible-surface admission shim.",
        "Surface creation/configuration/acquisition/presentation.",
        "Surface generations, leases, device replacement, loss classification, and reconstruction reporting.",
    ],

    sidecar_split: [
        "After G4B, no program, source, entry-point, interface, binding, layout, specialization, or pipeline descriptor truth remains in the sidecar.",
        "After G4C, no backend resource, shader module, layout, bind-group, pipeline, cache, generation, or realization truth remains in the sidecar.",
        "The remaining sidecar may contain only G5-owned execution payload keyed by prepared node identity.",
        "G5 owns deletion of that residual payload during encoding/submission cutover.",
    ],

    runenrender_boundary: [
        "Do not implement materials, views, targets, lighting, visibility, transport, reconstruction, history, overlays, color, image quality, presentation meaning, or renderer package extraction.",
        "Treat the current render tree as migration evidence, not a wholesale move/rename/extraction target.",
        "Change current render files only where GPU realization/cache authority is removed or the new substrate is consumed.",
        "Separate RunenRender R-phase planning remains independently owned; RX is later mechanical transfer/cutover.",
    ],

    deterministic_tests: [
        "Foreign-context and stale-generation rejection occurs before backend calls and cache lookup success.",
        "Full resource/program/layout/bind-group/pipeline keys are order-independent and include every correctness field.",
        "Hash collisions cannot authorize reuse because full equality is checked.",
        "Equal duplicate realization requests reuse one record; changed descriptor for one logical identity rejects transactionally.",
        "Texture views cannot outlive or cross parent affinity in registry logic.",
        "Cache hit, miss, incompatible rejection, corrupt rejection, fallback, and creation failure are distinct.",
        "Labels/provenance do not split equal realizations.",
        "Source/dependency/reach-through guards reject deleted renderer authority and synthetic handles.",
        "Complete current-consumer and deletion inventory is enforced.",
    ],

    environment_tests: [
        "Realize representative buffer, texture, texture view, sampler, and query set on an admitted WGPU device.",
        "Create one WGSL compute module/pipeline and one WGSL render module/pipeline.",
        "Realize typed bind-group and pipeline layouts and a bind group with compatible resources.",
        "Reject actual adapter limit/format/alignment incompatibility with structured facts.",
        "Prove cache reuse within one context/generation and rejection across another context or generation.",
        "Report unavailable adapters/backends explicitly; environment-dependent proof does not replace deterministic proof.",
    ],

    guards: [
        "No renderer-owned reusable WGPU resource/program/layout/bind-group/pipeline/cache owner.",
        "No public Device, Queue, raw WGPU resource, shader, layout, bind-group, or pipeline access.",
        "No RenderFlowId-derived GPU owner or synthetic G2 handle constructor outside RunenGPU.",
        "No program/interface/pipeline/cache/realization truth in the sidecar.",
        "No string, path, TypeId, pass ID, feature ID, label, or naked hash as binding/cache authority.",
        "No compatibility alias, forwarding module, duplicate cache, second realization path, new dependency/package, stable persistence format, generated prompt, task database, truth certificate, execution lock, or temporary workflow.",
    ],

    exclusions: [
        "No command encoding, queue submission, progress, pressure, completion, mapping, readback, cancellation, runtime retirement, delayed destruction, or shutdown implementation.",
        "No surface public API, acquisition, presentation, device replacement, loss, or reconstruction implementation.",
        "No RunenRender semantic work or package extraction.",
        "No stable backend cache, source, capture, persistence, ABI, or wire format.",
        "No dependency, manifest, lockfile, workflow, or ADR change unless a genuine accepted stop condition requires owner action.",
    ],

    validation: [
        "Focused deterministic realization, affinity, key, cache, migration, deletion, and guard tests.",
        "Focused environment-dependent WGPU resource/program/pipeline realization tests.",
        "Complete direct and transitive raw Device/Queue/resource/program/layout/pipeline consumer census.",
        "cargo validate",
        "git diff --check",
        "CI=true pnpm --dir docs-site build",
        "Repository-owned exact-head GitHub Actions and Documentation Build.",
        "All tracked files remain below 131072 raw bytes.",
    ],

    acceptance: [
        "One context/generation-bound private WGPU realization authority owns reusable backend objects.",
        "Every resource/program/layout/bind-group/pipeline realization is explicit, typed, compatible, transactional, and stale/foreign-safe.",
        "Derived caches are correctness-complete, generation-scoped, reject incompatibility safely, and fall back to ordinary realization.",
        "All current consumers are migrated through the new authority.",
        "Renderer-owned GPU realization/cache authority, synthetic handles, owner bridge, raw reach-through, and G4-owned sidecar truth are deleted without aliases or duplicate paths.",
        "Only explicitly G5/G7-owned migration evidence remains.",
        "No G5, G7, RunenRender or extraction implementation entered scope.",
        "Exact-head validation and independent review pass with no unresolved blocking finding.",
    ],
)