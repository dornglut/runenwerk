// Umbrella specification for the ordered RunenGPU G4C realization program.
// This umbrella is not directly implementable and must never own one broad branch or PR.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G4C",
    title: "WGPU Realization, Cache Compatibility, and Renderer Cutover Program",
    lifecycle_state: "planned-blocked-umbrella",
    implementation_authorization_status: "not-directly-implementable",
    owner: "RunenGPU contract owner",
    source_baseline: "accepted-PT-RUNENGPU-G4B-merge-to-be-recorded-after-runenwerk-187",
    planning_issue: "dornglut/runenwerk#209",
    umbrella_issue: "dornglut/runenwerk#188",
    parent_issue: "dornglut/runenwerk#167",
    blocking_predecessor: "accepted PT-RUNENGPU-G4B",
    target_repository_after_internal_conformance: "dornglut/runen-gpu",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "docs-site/src/content/docs/architecture/repository-family-architecture.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runengpu-g4-context-program-realization-design.md",
        "docs-site/src/content/docs/design/active/runengpu-g4b-contracts-g4c-delivery-design.md",
        "docs-site/src/content/docs/reports/investigations/2026-08-03-runengpu-g4b-g4c-finalization.md",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4a-context-admission.ron",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4b-program-interface-layout.ron",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4c1-resource-realization.ron",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4c2-program-binding-realization.ron",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4c3-pipeline-cutover.ron",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
        "docs-site/src/content/docs/workspace/planning/active-work.md",
    ],

    goal: "Complete private context/device-generation-bound WGPU realization and remove renderer-owned realization authority through three independently reviewable ordered deliveries with a serialized, narrowly scoped successor-bridge ladder, without collapsing resource realization, program/binding realization, pipeline realization, consumer migration, and deletion into one unsafe cutover.",

    dependency_direction: [
        "G2 logical resources -> G4C1 private resource realization.",
        "Accepted G4B canonical WGSL and resource-interface contracts plus accepted G4C1 resources -> G4C2 private program, layout, and bind-group realization.",
        "Accepted G4B pipeline descriptors plus accepted G4C2 programs/layouts/bind groups -> G4C3 private pipeline realization and final consumer cutover.",
        "Accepted G4C3 opaque realizations -> G5 execution through one bounded temporary execution bridge.",
    ],

    child_sequence: [
        (
            phase_id: "PT-RUNENGPU-G4C1",
            title: "Resource Realization",
            specification: "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4c1-resource-realization.ron",
            state: "blocked-until-accepted-g4b-and-explicit-child-issue",
            predecessor: "PT-RUNENGPU-G4B",
            outcome: "Private buffers, textures, views, samplers, and query sets with affinity, transactional registries, resource cache compatibility, and one resource successor bridge deleted by G4C2.",
        ),
        (
            phase_id: "PT-RUNENGPU-G4C2",
            title: "Program and Binding Realization",
            specification: "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4c2-program-binding-realization.ron",
            state: "blocked-until-accepted-g4c1-and-explicit-child-issue",
            predecessor: "PT-RUNENGPU-G4C1",
            outcome: "Canonical WGSL modules, reflection agreement, observed stage IO, bind-group layouts, pipeline layouts, typed bind groups, deletion of the resource bridge, and one pipeline successor bridge deleted by G4C3.",
        ),
        (
            phase_id: "PT-RUNENGPU-G4C3",
            title: "Pipeline Realization and Final Cutover",
            specification: "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4c3-pipeline-cutover.ron",
            state: "blocked-until-accepted-g4c2-and-explicit-child-issue",
            predecessor: "PT-RUNENGPU-G4C2",
            outcome: "Compute/render pipelines, stage-IO agreement, complete cache keys, current-consumer migration, deletion of renderer-owned realization/cache authority and the pipeline bridge, and one execution bridge deleted by G5.",
        ),
    ],

    serialized_bridge_sequence: [
        "After G4C1, exactly one crate-private CurrentRenderResourceBridge may lend purpose-typed affinity-validated resource references to every audited current consumer whose semantic operation remains in G4C2, G4C3, or G5; it performs none of those operations and G4C2 supersedes and deletes it.",
        "After G4C2, exactly one crate-private CurrentRenderPipelineBridge supersedes the deleted resource bridge and carries only proven still-required G4C1 resource terminals plus G4C2 program/layout/bind-group terminals for current pipeline creation and unchanged encoding; it does not own G5 and G4C3 supersedes and deletes it.",
        "After G4C3, exactly one crate-private CurrentRenderExecutionBridge carries only accepted resource/bind-group/pipeline terminals needed by the unchanged G5 encoder; it lends validated references but does not encode or submit, and G5 deletes it.",
        "A successor replaces and deletes its predecessor before successor acceptance; two G4C migration bridges never remain active at one accepted boundary.",
        "Every bridge is narrowly typed, owner-local, non-public, non-authoritative, process-local, context/generation checked, source-guarded, and forbidden from storing, cloning, caching, returning, persisting, or treating borrowed backend objects as lookup or descriptor authority.",
        "No bridge exposes Deref, AsRef, a reusable raw handle, a generic raw-WGPU callback, an arbitrary consumer closure, or broad Device/Queue access; borrowed references do not escape their lexical use.",
        "The set of carried-forward predecessor terminals monotonically shrinks. A successor may add only newly realized terminal classes owned by that phase that exact-current-main uncut consumers still require. Migrated predecessor terminals disappear, and no successor may reintroduce a predecessor terminal already eliminated by its owning phase. Each bridge has one immediate deletion owner and a complete terminal/call-site census.",
    ],

    current_render_device_queue_cutover: [
        "CurrentRenderDeviceQueue is a separate crate-private backend-operation loan to current uncut code, not an object-reference migration bridge, not part of CurrentRenderResourceBridge, and not a second bridge for uniqueness accounting.",
        "The loan is non-public, non-authoritative, source-guarded, purpose-bound, inaccessible through Deref or AsRef, and forbidden from becoming a generic callback, raw-WGPU escape hatch, or future native-interop API.",
        "After G4C1, generic buffer/texture/view/sampler/query-set creation through CurrentRenderDeviceQueue has zero remaining call sites.",
        "After G4C2, ShaderModule, BindGroupLayout, PipelineLayout, and BindGroup creation through the loan additionally have zero remaining call sites.",
        "After G4C3, compute/render pipeline creation through the loan additionally has zero remaining call sites.",
        "G5 migrates the remaining encoding/upload/submission/copy/map/readback operation users and deletes CurrentRenderDeviceQueue. Source guards enumerate the exact allowed operation classes and call sites at every accepted boundary and prove a monotonic shrink.",
    ],

    program_invariants: [
        "Issue #188 remains an umbrella tracker and is never implemented by one branch or pull request.",
        "Each child has one issue, one branch, one pull request, one exact-head validation set, one complete-diff review, and one accepted merge before its successor activates.",
        "No child consumes an unmerged predecessor branch as authority.",
        "Every private WGPU realization is bound to exact GpuContextId and GpuDeviceGeneration.",
        "Foreign-context and stale-generation rejection occur before backend access or successful cache lookup.",
        "Full typed key equality follows hashing; hash collision cannot authorize reuse.",
        "Registry publication is transactional and backend failure publishes no partial authoritative entry.",
        "Caches are in-memory, derived, discardable, reconstructable, and scoped to one context/device generation.",
        "An authoritative registry maps one typed logical identity to its realization record; derived caches are optional cost optimizations only. Equal descriptors never make distinct logical identities alias, and full typed equality follows any hash candidate.",
        "RunenGPU owns opaque GpuWorkResourceId owner-scope allocation. The RenderFlowId-derived owner-scope bridge is deleted by G4C1; renderer invocation/history mappings retain distinct typed G2 handles before realization and never place renderer identity in G4C correctness keys.",
        "Owned resources may be created by G4C1. Imported resources require an explicit accepted concrete import-source contract or yield ImportSourceUnavailable/unresolved-import; renderer provenance is not that source and SurfaceAcquired remains G7-only.",
        "Deterministic descriptor/capability/affinity incompatibility rejects before backend creation. Backend validation/device/OOM failure after admission is a backend/context or implementation-defect category, never ordinary cache control flow, and backend strings are diagnostic only.",
        "G4C1 owns logical-record liveness, bounded registry reclamation, and unretained derived-state removal; G5 owns in-flight retention, completion, cancellation, delayed backend retirement/destruction, and shutdown.",
        "G4C1 creates backend resource objects only. G5 owns upload/update/copy/staging/query-resolution/map/readback execution; checked initialization intent cannot authorize create_buffer_init, queue.write_buffer, queue.write_texture, or another public transfer path in G4C1.",
        "Sampler compatibility uses every semantic field of the accepted normalized GpuSamplerDescriptor, not nonexistent anisotropy state. Registry scope supplies one admitted context/device generation; validation, not duplicated context fact sets, establishes admission before lookup.",
        "No stable persisted backend cache, source, ABI, capture, replay, wire, or cross-process handle format is authorized.",
        "Only private RunenGPU backend modules own reusable WGPU objects after G4C3.",
        "G5 retains execution, uploads, submission, progress, completion, readback, cancellation, retirement, and shutdown ownership.",
        "G7 retains surfaces, presentation, device replacement, loss, and reconstruction ownership.",
        "RunenRender retains image-formation semantics and Runenwerk retains source, window, product, and recovery policy.",
    ],

    cross_child_migration_rules: [
        "G4C1 migrates resource creation/ownership and uses CurrentRenderResourceBridge only to lend purpose-typed references to exact audited G4C2/G4C3/G5 consumers; it does not realize WGSL modules, layouts, bind groups, pipelines, or their operations.",
        "G4C2 consumes opaque G4C1 handles to realize programs/layouts/bind groups, deletes CurrentRenderResourceBridge, and replaces it with CurrentRenderPipelineBridge carrying only residual resource terminals plus the G4C2 program/layout/bind-group terminals still proven necessary; it does not own pipeline realization or G5 execution.",
        "G4C3 realizes pipelines, deletes CurrentRenderPipelineBridge, completes every current-consumer and deletion census, and leaves only CurrentRenderExecutionBridge with accepted resource/bind-group/pipeline terminals for unchanged G5 encoding.",
        "Each child deletes authority and predecessor bridges it fully replaces in the same accepted slice and leaves no forwarding alias or parallel old/new path.",
        "No bridge owns operation, descriptor, resource, program, layout, pipeline, access, hazard, source, interface, stage-IO, cache, encoding, upload, submission, execution, progress, completion, or lifecycle truth.",
    ],

    validation: [
        "Each child runs focused deterministic and environment-dependent proof.",
        "Each child proves its predecessor bridge has zero remaining source references and its one successor bridge has only explicitly audited, current-main-proven residual terminals and call sites.",
        "Each child runs cargo validate.",
        "Each child runs git diff --check.",
        "Each child runs CI=true pnpm --dir docs-site build.",
        "Each child obtains repository-owned exact-head CI and Documentation Build evidence.",
        "Each child performs an independent complete-diff review with no unresolved blocking finding.",
        "All tracked files remain below 131072 raw bytes.",
    ],

    acceptance: [
        "PT-RUNENGPU-G4C1, G4C2, and G4C3 boundaries, dependencies, bridge transitions, and deletion owners remain explicit and non-overlapping.",
        "Issue #188 links the three accepted child issues and records their exact accepted merges.",
        "G4C3 proves complete migration and deletion; G4C1 or G4C2 cannot close the umbrella early.",
        "No one-shot G4C implementation branch, PR, compatibility facade, duplicate registry, overlapping bridge set, broad raw escape hatch, or premature G5/G7/RunenRender/extraction work exists.",
        "The umbrella closes only after accepted G4C3 and accepted-main validation.",
    ],
)
