// Decision-complete implementation specification for RunenGPU G4B.
// G4B remains blocked until issue #209 is accepted and issue #187 is activated.

PhaseImplementationSpec(
    phase_id: "PT-RUNENGPU-G4B",
    title: "Program, Resource Interface, Binding, Layout, and Pipeline Contracts",
    lifecycle_state: "planned-blocked",
    implementation_authorization_status: "blocked-until-accepted-runenwerk-209-and-explicitly-activated-runenwerk-187",
    owner: "RunenGPU contract owner",
    source_baseline: "23bc982703f93d15ac39dd71d61bae9e23854141",
    planning_issue: "dornglut/runenwerk#209",
    implementation_issue: "dornglut/runenwerk#187",
    parent_issue: "dornglut/runenwerk#167",
    blocking_predecessor: "accepted PT-RUNENGPU-G4A at 501b9fd58e56d33708573e47faf0e5026b5a1ff2",
    target_repository_after_internal_conformance: "dornglut/runen-gpu",

    authority_docs: [
        "AGENTS.md",
        "TESTING.md",
        "ARCHITECTURE.md",
        "docs-site/src/content/docs/architecture/repository-family-architecture.md",
        "docs-site/src/content/docs/design/active/runengpu-architecture-design.md",
        "docs-site/src/content/docs/design/active/runengpu-g4-context-program-realization-design.md",
        "docs-site/src/content/docs/design/active/runengpu-shader-authoring-artifact-boundary.md",
        "docs-site/src/content/docs/design/active/runengpu-g4b-contracts-g4c-delivery-design.md",
        "docs-site/src/content/docs/reports/investigations/2026-08-03-runengpu-g4b-g4c-finalization.md",
        "docs-site/src/content/docs/workspace/specs/pt-runengpu-g4a-context-admission.ron",
        "docs-site/src/content/docs/workspace/planning/roadmap.md",
        "docs-site/src/content/docs/workspace/planning/active-work.md",
    ],

    goal: "Create one explicit WGSL-first RunenGPU authority for source admission, program and entry-point descriptors, shader-visible resource interfaces, typed binding declarations, bind-group and pipeline layouts, specialization, and deterministic compute/render pipeline descriptors; prove understandable public construction and rejection without realizing WGPU objects or granting renderer helpers ABI authority.",

    dependency_direction: [
        "Runenwerk source policy or a domain/renderer consumer supplies canonical WGSL artifacts and owner-local source identity to RunenGPU.",
        "RunenGPU validates generic program, resource-interface, layout, specialization, and pipeline contracts independently of filesystem, renderer, ECS, application, and product semantics.",
        "PT-RUNENGPU-G4C2 consumes accepted program/interface contracts for private WGSL module and binding realization.",
        "PT-RUNENGPU-G4C3 consumes accepted pipeline descriptors for private WGPU pipeline realization and cutover.",
    ],

    phase_ownership: [
        "G4A remains authoritative for context identity, device generation, adapter/device admission, normalized backend facts, and admitted requirements.",
        "G4B owns canonical program-source admission, entry-point contracts, shader-visible resource interfaces, typed binding identity, deterministic layout/specialization descriptors, and generic compute/render pipeline descriptors.",
        "G4C1 owns resource realization; G4C2 owns WGSL module, reflection agreement, layouts, and bind groups; G4C3 owns pipeline realization and final consumer cutover.",
        "G5 owns execution and submission; G7 owns surfaces; RunenRender owns image-formation semantics; Runenwerk owns source discovery, authoring compilers, watching, reload scheduling, last-known-good artifacts, and product fallback.",
    ],

    source_owner_contracts: [
        "GpuProgramSourceOwnerId is opaque, nonzero, process-local, and separates independent source authorities without filesystem semantics.",
        "GpuProgramSourceKey is an opaque validated semantic key scoped by one source owner.",
        "GpuProgramSourceRevision is nonzero and meaningful only for one owner/key pair; it is not globally ordered, persisted, or a timestamp.",
        "GpuProgramSource initially supports canonical WGSL source text only.",
        "GpuProgramDescriptor stores source owner, key, revision, full canonical WGSL, deterministic digest, declared entry points, one explicit resource interface, merged requirements, and bounded provenance.",
        "The digest accelerates lookup and diagnostics but full canonical WGSL equality remains authoritative.",
        "Filesystem paths, module names, authoring-language handles, compiler state, watcher state, and last-known-good policy do not enter RunenGPU source identity.",
        "Do not add WESL, Slang, SPIR-V, GLSL, HLSL, MSL, DXIL, native modules, filesystem references, or stable source schemas.",
    ],

    source_admission_registry: [
        "GpuProgramSourceRegistry is the single stateful owner of admitted source consistency in G4B.",
        "The registry is process-local and bounded by explicit maximum records and maximum retained canonical-source bytes supplied by Runenwerk policy at construction.",
        "Admission binds the complete tuple (source_owner, source_key, source_revision, full_canonical_wgsl, deterministic_digest, bounded_provenance).",
        "Re-admitting the same owner/key/revision with byte-identical canonical WGSL is idempotent and returns the same admitted source record.",
        "Reusing one owner/key/revision with different canonical WGSL returns structured SourceRevisionConflict before descriptor publication.",
        "A different revision creates a distinct admitted record and does not silently invalidate descriptors or realizations bound to an older revision.",
        "Eviction or explicit removal may drop registry lookup state only when no accepted descriptor or realized record retains that source record; ordinary admission cannot silently invalidate live authority.",
        "Registry operations are transactional, invoke no consumer callback under internal locks, and publish no partial source record on failure.",
        "Registry capacity pressure is structured and does not silently evict live records.",
    ],

    entry_point_contracts: [
        "Typed stages are Compute, Vertex, and Fragment.",
        "Each entry-point descriptor contains a validated source-level name, exact stage, and reference to one explicit shader-resource interface.",
        "Compute pipelines name exactly one compute entry point.",
        "Render pipelines name exactly one vertex and zero or one fragment entry point from one admitted program source.",
        "Reject missing entries, duplicate same-stage names, stage mismatch, and pipeline references not declared by the admitted program.",
        "Entry-point names participate in semantic equality and are not diagnostic labels.",
    ],

    binding_key_contract: [
        "GpuBindingKey contains checked u32 group and binding components.",
        "Ordering is lexicographic by group then binding; hashing includes typed discriminants and both values.",
        "Constructors reject duplicate declarations and structural invalidity; context admission and later realization check device limits.",
        "Strings, paths, TypeId, Rust type names, GpuWorkResourceId, RenderFlowId, RenderPassId, RenderFeatureId, vector positions, labels, and naked hashes cannot be binding authority.",
    ],

    binding_declarations: [
        "GpuBindingDeclaration contains typed key, stage visibility, one typed binding kind, optional nonzero array count, label, and bounded provenance.",
        "Initial kinds are UniformBuffer, StorageBuffer, SampledTexture, StorageTexture, and Sampler.",
        "UniformBuffer stores dynamic-offset policy and optional nonzero minimum size.",
        "StorageBuffer stores ReadOnly or ReadWrite access, dynamic-offset policy, and optional nonzero minimum size.",
        "SampledTexture stores normalized sample class, view dimension, and multisample state.",
        "StorageTexture stores normalized access, exact normalized format, and view dimension.",
        "Sampler class is Filtering, NonFiltering, or Comparison.",
        "Unsupported acceleration structures, external textures, video, ray tracing, unbounded or bindless arrays, and backend-native bindings remain absent.",
    ],

    resource_interface_contract: [
        "GpuProgramInterfaceDescriptor owns only ordered shader-visible resource binding declarations and their complete compatibility requirements.",
        "The interface validates exact binding key, resource kind/usage, stage visibility, minimum buffer size/range, dynamic-offset policy/alignment, texture sample/view/multisample/format facts, storage access, sampler class, and array cardinality.",
        "Vertex-buffer layouts, vertex attributes, buffer slots, byte offsets, strides, and step modes are render-pipeline input state, not program-interface state.",
        "Fragment/color target formats, blend state, write masks, and attachment ordering are render-pipeline output state, not program-interface state.",
        "Depth/stencil, primitive, multisample, and dynamic graphics state remain render-pipeline state.",
        "The explicit interface is authoritative and cannot contain renderer flow, pass, material, view, target alias, lighting, or product identity.",
    ],

    mandatory_wgsl_agreement: [
        "Explicit RunenGPU declarations remain authority; parser or reflection output is validation evidence only.",
        "Before PT-RUNENGPU-G4C2 publishes a WGSL module realization, the pinned WGSL parser/reflection path must prove declared entry-point names and stages, binding group/binding identities, stage visibility, resource classes, access, dimensions, sample/storage format facts, array cardinality, and applicable host-layout requirements agree with the explicit descriptors.",
        "G4B owns the backend-neutral expected-interface contract and deterministic comparison vocabulary.",
        "G4C2 owns invocation of the pinned WGPU/Naga parser/reflection path and translation of observed facts into that comparison vocabulary.",
        "There is one comparison algorithm; G4B tests it with synthetic observed facts and G4C2 supplies real observed facts.",
        "Reflection may reject disagreement and improve source-span diagnostics; it may not infer, renumber, add, remove, or mutate authoritative declarations or layouts.",
        "Mismatch returns structured ProgramInterfaceMismatch before module, layout, bind-group, or pipeline publication.",
    ],

    layout_contracts: [
        "GpuBindGroupLayoutDescriptor owns exactly one group and declarations sorted by binding key.",
        "Reject duplicate bindings and declarations naming a different group.",
        "GpuPipelineLayoutDescriptor owns ordered unique group-layout descriptors.",
        "Initial G4B has no push constants because no accepted consumer proves them.",
        "Labels, provenance, and source spans are excluded from semantic equality only when they cannot affect backend correctness.",
    ],

    specialization_contracts: [
        "GpuSpecializationKey is a validated source-level identifier, not a label.",
        "Initial types are Bool, U32, I32, and finite F32.",
        "F32 normalizes negative zero, rejects NaN and infinity, and hashes canonical IEEE bits.",
        "A schema has unique keys, exact types, optional defaults, and requirement implications.",
        "A value set rejects unknown or duplicate keys, missing required values, and type mismatches, then normalizes to schema order.",
        "Specialization participates in realization keys only where the selected WGSL/backend path consumes it; unsupported override behavior is rejected explicitly.",
    ],

    compute_pipeline_descriptor: [
        "Contains exact admitted program source identity, compute entry point, resource-interface identity, pipeline layout, normalized specialization values, and capability requirements.",
        "Contains no renderer flow, pass, feature, material, view, surface, or product identity.",
    ],

    render_pipeline_descriptor: [
        "Contains exact admitted program source identity, vertex and optional fragment entry points, resource-interface identity, pipeline layout, specialization values, vertex-buffer layouts and attributes, primitive state, depth/stencil state, multisample state, ordered color-target states, and capability requirements.",
        "Uses normalized GPU formats and state vocabularies rather than raw WGPU enums.",
        "Contains no material meaning, lighting, visibility, view ID, RenderFlowId, RenderPassId, RenderFeatureId, target alias, shader path, surface handle, or product quality policy.",
        "Add only graphics options required by accepted current consumers; do not invent a universal graphics abstraction.",
    ],

    runtime_binding_compatibility: [
        "Runtime binding values are checked against one admitted resource interface and exact layout before G4C2 bind-group realization.",
        "Validation covers resource kind, usage, range, minimum size, dynamic-offset policy and alignment, texture view/format/sample/multisample facts, storage access, sampler class, array cardinality, and later context/device-generation affinity.",
        "Byte-preparation helpers cannot bypass interface validation.",
        "Compatibility returns a structured normalized result consumed by G4C2; it creates no backend object in G4B.",
    ],

    deterministic_identity: [
        "All semantic descriptors have private fields and fallible constructors or builders.",
        "Normalize unordered collections into typed key order.",
        "Implement semantic equality, ordering, and hashing where all fields permit.",
        "Hash complete typed fields and discriminants, never Debug text or insertion order.",
        "Do not expose a naked hash as authoritative identity; caches compare full typed keys after hashing.",
        "Labels and diagnostic-only provenance cannot split otherwise identical backend descriptors.",
        "Floating-point values are canonicalized before storage.",
    ],

    diagnostics: [
        "InvalidSourceOwner",
        "InvalidSourceKey",
        "InvalidSourceRevision",
        "SourceAdmissionCapacityExceeded",
        "SourceRevisionConflict",
        "UnsupportedSourceKind",
        "WgslParseOrValidationFailed",
        "EntryPointMissing",
        "EntryPointStageMismatch",
        "DuplicateBindingKey",
        "BindingDeclarationInvalid",
        "ProgramInterfaceMismatch",
        "RuntimeBindingIncompatible",
        "SpecializationUnknownMissingOrTypeMismatch",
        "PipelineDescriptorInvalid",
    ],

    current_helper_disposition: [
        "Keep GpuParams, GpuUniform, GpuStorage, ToGpuValue, GpuUniformField, and current derives as transitional Runenwerk/render byte-preparation helpers during G4.",
        "They do not prove WGSL struct identity, binding key or visibility, minimum size, storage ABI, nested/array/runtime-array layout, matrix orientation, package independence, or complete interface compatibility.",
        "Do not move these helpers into the RunenGPU public boundary in G4B.",
        "Do not add a derive, create runengpu_macros, or extract engine_render_macros.",
        "Binding compatibility is validated independently of whichever helper produced bytes.",
    ],

    current_source_migration: [
        "Translate explicit loaded canonical WGSL, source owner, semantic source key, revision, and bounded provenance from engine/src/plugins/render/shader without moving filesystem discovery or watch policy.",
        "Replace string-only PipelineKey, phase or label specialization, untyped binding layout hashes, and renderer pass/feature IDs as GPU correctness authority.",
        "Move program, resource-interface, layout, specialization, and pipeline truth out of engine/src/plugins/render/adapters/gpu_work.rs sidecar into typed generic descriptors or references.",
        "Migrate renderer setup, prepare, render-flow paths, applications, examples, benches, and tests to construct explicit G4B descriptors.",
        "Retain renderer semantic decisions and Runenwerk source policy outside RunenGPU.",
    ],

    public_api_proof: [
        "Compute example: admit one canonical WGSL source, declare storage input at (0,0) and storage output at (0,1), build one resource interface, declare one compute entry point, and build one compute pipeline descriptor through fallible constructors.",
        "Render example: admit one canonical WGSL source, declare one uniform binding resource interface, declare vertex and fragment entry points, then build separate vertex-buffer input state and separate ordered color-target output state in the render pipeline descriptor.",
        "Runtime compatibility example: validate prepared uniform or storage bytes and logical resources against the explicit interface before bind-group realization.",
        "Source consistency example: equal owner/key/revision/full-source admission is idempotent; different full source for the same tuple returns SourceRevisionConflict.",
        "Determinism example: descriptors and specialization values created from different insertion orders normalize to complete equality and equal hashes.",
        "Examples expose no raw WGPU type, filesystem path identity, string binding authority, naked hash authority, or nested finish ladder.",
        "The preferred authoring path uses one bounded builder per semantic object with a single fallible build or admission terminal.",
    ],

    compile_fail_or_rejection_proof: [
        "Raw WGPU type in a public descriptor.",
        "String, TypeId, resource ID, pass ID, feature ID, or naked hash used as binding key.",
        "Duplicate group/binding key.",
        "Stage visibility mismatch.",
        "Wrong buffer, texture, sampler, format, access, dimension, multisample state, or array count.",
        "Vertex-buffer or color-target state placed inside GpuProgramInterfaceDescriptor.",
        "Missing, unknown, duplicate, or type-mismatched specialization.",
        "Compute pipeline using a render entry point or render pipeline using a compute entry point.",
        "Source owner/key/revision reused with different canonical WGSL.",
        "Field construction bypassing validation.",
        "GpuUniform or GpuStorage derive treated as sufficient interface proof.",
        "Reflection disagreement accepted or used to mutate explicit declarations.",
    ],

    source_and_dependency_guards: [
        "No public raw WGPU or Winit type.",
        "No renderer, ECS, application, product, shader filesystem, path watcher, authoring compiler, or last-known-good policy in engine/src/plugins/gpu G4B source.",
        "No TypeId or std::any::Any in G4B interface authority.",
        "No RenderFlowId, RenderPassId, RenderFeatureId, RenderTarget, material, view, lighting, or transport vocabulary.",
        "No vertex-input or fragment/color-target output state inside GpuProgramInterfaceDescriptor.",
        "No second source-consistency registry or parallel source admission path.",
        "No new macro package, dependency, persistence format, generated prompt, task database, truth certificate, execution lock, or temporary workflow.",
    ],

    exclusions: [
        "No WGPU resource, shader module, layout, bind-group, or pipeline realization.",
        "No invocation of WGPU/Naga reflection; G4B owns expected facts and comparison, while G4C2 supplies real observed facts.",
        "No cache implementation beyond deterministic full-key and compatibility contract tests.",
        "No command encoding, submission, progress, readback, retirement, surface, presentation, device-loss, or reconstruction behavior.",
        "No RunenRender semantics or external package extraction.",
        "No stable source, ABI, cache, capture, persistence, or wire format.",
    ],

    validation: [
        "Focused source-registry, descriptor, equality/hash, interface, specialization, runtime-compatibility, and negative tests.",
        "Compile-pass and compile-fail public-contract proof for the bounded examples.",
        "Source, dependency, sidecar, and ownership guards plus complete current-consumer migration census.",
        "cargo validate",
        "git diff --check",
        "CI=true pnpm --dir docs-site build",
        "Repository-owned exact-head GitHub Actions and Documentation Build.",
        "All tracked files remain below 131072 raw bytes.",
    ],

    acceptance: [
        "One bounded stateful source-admission authority enforces owner/key/revision/full-source consistency.",
        "One typed WGSL-first program and entry-point authority exists.",
        "One typed shader-resource interface authority replaces strings, TypeId, and naked hashes without absorbing vertex or color-target pipeline state.",
        "Mandatory WGSL parser/reflection agreement is bound without making reflection authoritative or duplicating comparison logic.",
        "Compute and render pipeline descriptors are generic, complete, deterministic, renderer-semantic-free, and understandable through concrete public examples.",
        "Current derives remain explicitly transitional and cannot claim ABI or interface truth.",
        "Program, resource-interface, layout, specialization, and pipeline truth no longer resides in the G3 execution sidecar.",
        "Every current declaration consumer is migrated or explicitly classified for G4C1, G4C2, or G4C3.",
        "No G4C, G5, G7, RunenRender, compiler-frontend, dependency, or extraction implementation entered scope.",
        "Exact-head validation and independent review pass with no unresolved blocking finding.",
    ],
)