@startuml
title Runenwerk Networking Ownership Split

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

rectangle "RunenECS" as ecs
rectangle "engine" as engine
rectangle "RunenNet" as runennet
rectangle "runen-net-quic" as quic
rectangle "domain/simulation\n(engine_sim)" as sim
rectangle "domain/replay\n(engine_replay)" as replay
rectangle "gameplay / world" as game

note bottom of engine
App/runtime/plugins,
Net integration,
wire + driver contracts
end note

note bottom of runennet
Connection/session,
delivery/recovery,
replication/input/prediction
end note

note bottom of sim
Simulation identity,
ticks/profile/RNG
end note

note bottom of replay
Replay/archive/history
substrate
end note

engine --> ecs
engine --> runennet
engine --> sim
engine --> replay
quic --> runennet

game --> ecs
game --> engine
game --> sim

@enduml