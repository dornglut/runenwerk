@startuml
title Runenwerk Realtime Networking Architecture

skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

package "RunenECS" as ECS {
  [World / Query / Schedule]
}

package "engine" as ENG {
  [App / Runtime]
  [NetPlugin]
  [RunenNet Session Projection]
  [Wire / Driver Integration]
  [World / Streaming Integration]
}

package "standalone RunenNet" as RNET {
  [Connection / Session]
  [Delivery / Recovery]
  [Authority Replication]
  [Client Replication]
  [Input / Prediction]
}

package "runen-net-quic" as QUIC {
  [QUIC Transport Realization]
}

package "engine_sim" as SIM {
  [Simulation Identity / Tick / Profile]
}

package "engine_replay" as REPLAY {
  [Replay / Archive / Validation]
}

package "gameplay / world" as GAME {
  [Gameplay State]
  [Snapshot / Input Adaptation]
  [Relevancy / Product Policy]
}

ENG --> ECS : runtime integration
ENG --> RNET : public semantic contracts
ENG --> SIM : simulation vocabulary
ENG --> REPLAY : replay integration
QUIC --> RNET : transport realization

GAME --> ECS
GAME --> ENG
GAME --> SIM

note right of RNET
Sole reusable realtime networking
semantic authority.
end note

note right of ENG
Owns Runenwerk integration only:
scheduling, policy, wire DTOs,
driver adaptation, diagnostics.
end note

note right of GAME
Owns concrete gameplay/world
state and replication policy.
end note

@enduml